<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GateKPT.MusicOS.ViewModels"
        xmlns:svc="using:GateKPT.MusicOS.Services"
        x:Class="GateKPT.MusicOS.Views.RecorderWindow"
        x:DataType="vm:RecorderWindowViewModel"
        Icon="/Assets/gatekpt.ico"
        Title="GateKPT MusicOS"
        Width="980"
        Height="720"
        MinWidth="420"
        MinHeight="520"
        Background="#06111C">

    <Design.DataContext>
        <vm:RecorderWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#22E8E1D2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-1px)"/>
            <Setter Property="BorderBrush" Value="#6692BFB3"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>
    </Window.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18" Spacing="16">
            <Border CornerRadius="24" Padding="18" BorderBrush="#2BE8E1D2" BorderThickness="1" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#0B1B2A" Offset="0"/>
                        <GradientStop Color="#06111C" Offset="0.58"/>
                        <GradientStop Color="#101810" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid RowDefinitions="Auto,Auto" RowSpacing="13">
                    <Path Grid.RowSpan="2"
                          Data="M 0 54 C 120 18, 220 88, 350 44 S 590 25, 720 72 S 880 36, 1080 58"
                          Stroke="#33C6A96D"
                          StrokeThickness="1.4"
                          Stretch="Fill"
                          IsHitTestVisible="False"/>
                    <Path Grid.RowSpan="2"
                          Data="M 0 86 C 150 64, 250 120, 390 76 S 660 66, 840 105 S 980 72, 1160 92"
                          Stroke="#2692BFB3"
                          StrokeThickness="1"
                          Stretch="Fill"
                          IsHitTestVisible="False"/>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="13">
                        <StackPanel>
                            <TextBlock Text="GATEKPT"
                                       FontSize="20"
                                       FontWeight="Black"
                                       Foreground="#E8E1D2"
                                       LetterSpacing="1.8"/>
                            <TextBlock Text="{Binding MeterInputLabel}"
                                       Margin="0,5,0,0"
                                       FontSize="11"
                                       FontWeight="Black"
                                       TextWrapping="Wrap"
                                       Foreground="#92BFB3"/>
                        </StackPanel>
                        <Border Grid.Column="1"
                                CornerRadius="18"
                                Background="#E8E1D2"
                                Padding="14,10"
                                MinWidth="105">
                            <StackPanel>
                                <TextBlock Text="{Binding PeakLabel}"
                                           FontSize="24"
                                           FontWeight="Black"
                                           HorizontalAlignment="Center"
                                           Foreground="#07100D"/>
                                <TextBlock Text="{Binding SimpleSignalLabel}"
                                           FontSize="9"
                                           FontWeight="Black"
                                           LetterSpacing="1.2"
                                           HorizontalAlignment="Center"
                                           Foreground="#806A3F"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" CornerRadius="999" Background="#0A2230" BorderBrush="#2F92BFB3" BorderThickness="1" Height="18" ClipToBounds="True">
                        <Grid ColumnDefinitions="*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*">
                            <Border Grid.Column="0" Background="#92BFB3" Opacity="0.18"/>
                            <Border Grid.Column="1" Background="#92BFB3" Opacity="0.22"/>
                            <Border Grid.Column="2" Background="#92BFB3" Opacity="0.28"/>
                            <Border Grid.Column="3" Background="#92BFB3" Opacity="0.34"/>
                            <Border Grid.Column="4" Background="#92BFB3" Opacity="0.40"/>
                            <Border Grid.Column="5" Background="#92BFB3" Opacity="0.46"/>
                            <Border Grid.Column="6" Background="#92BFB3" Opacity="0.52"/>
                            <Border Grid.Column="7" Background="#92BFB3" Opacity="0.58"/>
                            <Border Grid.Column="8" Background="#92BFB3" Opacity="0.64"/>
                            <Border Grid.Column="9" Background="#92BFB3" Opacity="0.70"/>
                            <Border Grid.Column="10" Background="#C6A96D" Opacity="0.76"/>
                            <Border Grid.Column="11" Background="#C6A96D" Opacity="0.82"/>
                            <Border Grid.Column="12" Background="#C6A96D" Opacity="0.88"/>
                            <Border Grid.Column="13" Background="#C6A96D" Opacity="0.94"/>
                            <Border Grid.Column="14" Background="#D08A56" Opacity="0.90"/>
                            <Border Grid.Column="15" Background="#D08A56" Opacity="0.76"/>
                            <Border Grid.Column="16" Background="#D08A56" Opacity="0.62"/>
                            <Border Grid.Column="17" Background="#D08A56" Opacity="0.48"/>
                            <Border Grid.Column="18" Background="#D08A56" Opacity="0.34"/>
                            <Border Grid.Column="19" Background="#D08A56" Opacity="0.22"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border CornerRadius="34" BorderBrush="#4092BFB3" BorderThickness="2" Padding="20" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#101810" Offset="0"/>
                        <GradientStop Color="#071420" Offset="0.45"/>
                        <GradientStop Color="#10251F" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                        <StackPanel>
                            <TextBlock Text="RECORDER"
                                       FontSize="11"
                                       FontWeight="Black"
                                       Foreground="#92BFB3"
                                       LetterSpacing="2.4"/>
                            <TextBlock Text="{Binding RecordingGuardLabel}"
                                       Margin="0,6,0,0"
                                       FontSize="34"
                                       FontWeight="Black"
                                       TextWrapping="Wrap"
                                       Foreground="#E8E1D2"/>
                            <TextBlock Text="{Binding CaptureInstruction}"
                                       Margin="0,6,0,0"
                                       FontSize="13"
                                       FontWeight="Black"
                                       TextWrapping="Wrap"
                                       Foreground="#C6A96D"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding PeakDecibelLabel}"
                                   FontSize="18"
                                   FontWeight="Black"
                                   VerticalAlignment="Center"
                                   Foreground="#D08A56"/>
                    </Grid>

                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                        <Button Content="{Binding RecordingButtonLabel}"
                                Command="{Binding StartRecordingCommand}"
                                Padding="28,18"
                                MinWidth="260"
                                MinHeight="89"
                                Margin="0,0,13,13"
                                FontSize="22"
                                Background="#92BFB3"
                                Foreground="#07100D"/>
                        <Button Content="{Binding StopButtonLabel}"
                                Command="{Binding StopRecordingCommand}"
                                Padding="28,18"
                                MinWidth="260"
                                MinHeight="89"
                                Margin="0,0,13,13"
                                FontSize="22"
                                Background="#C6A96D"
                                Foreground="#07100D"/>
                    </WrapPanel>

                    <ComboBox ItemsSource="{Binding InputDevices}"
                              SelectedItem="{Binding SelectedInputDevice}"
                              HorizontalAlignment="Stretch"
                              MinHeight="44"
                              Background="#E8E1D2"
                              Foreground="#07100D"/>

                    <WrapPanel Orientation="Horizontal">
                        <Button Content="Open take"
                                Command="{Binding PlaySelectedCommand}"
                                Padding="18,12"
                                MinWidth="150"
                                Margin="0,0,10,10"
                                Background="#E8E1D2"
                                Foreground="#07100D"/>
                        <Button Content="Folder"
                                Command="{Binding OpenFolderCommand}"
                                Padding="18,12"
                                MinWidth="150"
                                Margin="0,0,10,10"
                                Background="#92BFB3"
                                Foreground="#07100D"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border CornerRadius="24" Background="#D9081722" BorderBrush="#24D08A56" BorderThickness="1" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="EDIT COMMAND"
                               FontSize="10"
                               FontWeight="Black"
                               LetterSpacing="2"
                               Foreground="#D08A56"/>
                    <TextBlock Text="Type what you want: delete selected, make warmer, louder, reverb, export mix."
                               FontSize="11"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               Foreground="#C9C0AD"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBox Text="{Binding ChatText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="make drums warmer, delete, export mix..."
                                 TextWrapping="Wrap"
                                 MinHeight="46"
                                 Background="#E8E1D2"
                                 Foreground="#07100D"/>
                        <Button Grid.Column="1"
                                Content="Run"
                                Command="{Binding RunChatCommandCommand}"
                                Padding="20,12"
                                MinWidth="88"
                                Background="#D08A56"
                                Foreground="#07100D"/>
                    </Grid>
                    <TextBlock Text="{Binding CommandResult}"
                               FontSize="12"
                               FontWeight="Black"
                               TextWrapping="Wrap"
                               Foreground="#E8E1D2"/>
                    <TextBlock Text="{Binding LastEffectChain}"
                               FontSize="11"
                               FontWeight="Black"
                               TextWrapping="Wrap"
                               Foreground="#92BFB3"/>
                </StackPanel>
            </Border>

            <Border CornerRadius="22" Background="#14E8E1D2" BorderBrush="#22C6A96D" BorderThickness="1" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="AUDIO PATH"
                               FontSize="10"
                               FontWeight="Black"
                               LetterSpacing="2"
                               Foreground="#92BFB3"/>
                    <TextBlock Text="{Binding AudioHealthLabel}"
                               FontSize="14"
                               FontWeight="Black"
                               TextWrapping="Wrap"
                               Foreground="#E8E1D2"/>
                    <TextBlock Text="{Binding CurrentFilePreviewLabel}"
                               FontSize="11"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               Foreground="#C9C0AD"/>
                </StackPanel>
            </Border>

            <Border CornerRadius="24" Background="#10081722" BorderBrush="#18E8E1D2" BorderThickness="1" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="TAKES"
                               FontSize="11"
                               FontWeight="Black"
                               Foreground="#C6A96D"
                               LetterSpacing="2.4"/>
                    <ListBox ItemsSource="{Binding Versions}"
                             SelectedItem="{Binding SelectedVersion}"
                             Background="Transparent"
                             BorderThickness="0"
                             MaxHeight="260">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="svc:RecorderVersionFile">
                                <Border CornerRadius="18" Background="#14E8E1D2" Padding="14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Black" TextWrapping="Wrap" Foreground="#E8E1D2"/>
                                        <TextBlock Text="{Binding Size}" Margin="0,5,0,0" FontSize="11" FontWeight="Bold" Foreground="#92BFB3"/>
                                        <TextBlock Text="{Binding Modified}" FontSize="11" Foreground="#C9C0AD"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <Border CornerRadius="18" Background="#14E8E1D2" Padding="14">
                <TextBlock Text="{Binding Status}"
                           FontSize="13"
                           FontWeight="Black"
                           TextWrapping="Wrap"
                           Foreground="#E8E1D2"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
