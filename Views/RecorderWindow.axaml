<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GateKPT.MusicOS.ViewModels"
        xmlns:svc="using:GateKPT.MusicOS.Services"
        x:Class="GateKPT.MusicOS.Views.RecorderWindow"
        x:DataType="vm:RecorderWindowViewModel"
        Icon="/Assets/gatekpt.ico"
        Title="GateKPT MusicOS"
        Width="1020"
        Height="760"
        MinWidth="520"
        MinHeight="580"
        Background="#06070C">

    <Design.DataContext>
        <vm:RecorderWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial"/>
            <Setter Property="Foreground" Value="#E8E1D2"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#78DDA36B"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-1px)"/>
            <Setter Property="BorderBrush" Value="#DDF2C56B"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Background" Value="#FFF2E2C8"/>
            <Setter Property="Foreground" Value="#120918"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Arial"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Background" Value="#0A101B"/>
            <Setter Property="Foreground" Value="#FFF2E2C8"/>
            <Setter Property="BorderBrush" Value="#88DDA36B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Arial"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Black"/>
        </Style>
        <Style Selector="ComboBox:pointerover">
            <Setter Property="Background" Value="#211815"/>
            <Setter Property="BorderBrush" Value="#DDF2C56B"/>
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Height" Value="13"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Background" Value="#2A211A"/>
            <Setter Property="Foreground" Value="#DDA36B"/>
        </Style>
        <Style Selector="StackPanel.take-actions">
            <Setter Property="Opacity" Value="0.38"/>
        </Style>
        <Style Selector="Border.take-row:pointerover">
            <Setter Property="Background" Value="#77311C18"/>
            <Setter Property="BorderBrush" Value="#88DDA36B"/>
            <Setter Property="RenderTransform" Value="translateY(-1px)"/>
        </Style>
        <Style Selector="Border.take-row:pointerover StackPanel.take-actions">
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </Window.Styles>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#060A12" Offset="0"/>
                <GradientStop Color="#151119" Offset="0.36"/>
                <GradientStop Color="#2A1810" Offset="0.74"/>
                <GradientStop Color="#06070C" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Ellipse Width="520"
                 Height="520"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="0,-240,-180,0"
                 Fill="#24DDA36B"
                 IsHitTestVisible="False"/>
        <Ellipse Width="460"
                 Height="460"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Bottom"
                 Margin="-190,0,0,-170"
                 Fill="#147FCAD1"
                 IsHitTestVisible="False"/>
        <Ellipse Width="380"
                 Height="380"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,-130,-120"
                 Fill="#18F2C56B"
                 IsHitTestVisible="False"/>
        <Path Data="M -40 115 C 110 40, 220 155, 370 92 S 620 30, 820 124 S 1120 80, 1460 130"
              Stroke="#46DDA36B"
              StrokeThickness="2.4"
              Stretch="Fill"
              IsHitTestVisible="False"/>
        <Path Data="M -70 165 C 130 98, 270 208, 430 142 S 710 90, 940 180 S 1210 125, 1500 175"
              Stroke="#35DDA36B"
              StrokeThickness="1.5"
              Stretch="Fill"
              IsHitTestVisible="False"/>
        <Path Data="M -40 220 C 120 110, 250 290, 420 170 S 720 80, 1040 210 S 1320 120, 1480 190"
              Stroke="#287FCAD1"
              StrokeThickness="1.7"
              Stretch="Fill"
              IsHitTestVisible="False"/>
        <Path Data="M -20 320 C 150 260, 260 370, 430 310 S 760 260, 1020 350 S 1260 295, 1500 360"
              Stroke="#3BF2C56B"
              StrokeThickness="1.4"
              Stretch="Fill"
              IsHitTestVisible="False"/>
        <Path Data="M -80 470 C 170 390, 300 540, 520 455 S 860 405, 1120 500 S 1360 440, 1520 490"
              Stroke="#30E8E1D2"
              StrokeThickness="1"
              Stretch="Fill"
              IsHitTestVisible="False"/>

        <Grid Height="450"
              VerticalAlignment="Bottom"
              Margin="0,0,0,-28"
              Opacity="0.86"
              IsHitTestVisible="False">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#00130F16" Offset="0"/>
                    <GradientStop Color="#33130F16" Offset="0.34"/>
                    <GradientStop Color="#551F140D" Offset="0.68"/>
                    <GradientStop Color="#00130F16" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Path Data="M -80 310 C 120 150, 300 390, 520 250 S 850 105, 1120 330 S 1370 170, 1560 270"
                  Stroke="#78DDA36B"
                  StrokeThickness="3.4"
                  Stretch="Fill"/>
            <Path Data="M -70 360 C 140 235, 320 440, 540 325 S 880 215, 1150 390 S 1380 255, 1560 350"
                  Stroke="#66E8E1D2"
                  StrokeThickness="2.4"
                  Stretch="Fill"/>
            <Path Data="M -40 210 C 130 95, 270 265, 470 175 S 800 85, 1080 245 S 1340 130, 1560 205"
                  Stroke="#55F2C56B"
                  StrokeThickness="1.8"
                  Stretch="Fill"/>
            <Path Data="M 620 85 C 780 5, 1010 18, 1210 122 S 1460 355, 1230 460 S 780 510, 650 365 S 470 160, 620 85"
                  Stroke="#50C9B8FF"
                  StrokeThickness="2.8"
                  Stretch="Fill"/>
            <Path Data="M 690 135 C 830 68, 1030 78, 1175 170 S 1320 335, 1140 415 S 805 430, 710 330 S 565 202, 690 135"
                  Stroke="#7A7FCAD1"
                  StrokeThickness="2"
                  Stretch="Fill"/>
            <Path Data="M 760 190 C 875 132, 1040 145, 1135 220 S 1210 326, 1075 368 S 855 360, 790 292 S 650 240, 760 190"
                  Stroke="#8BF2EEE3"
                  StrokeThickness="1.45"
                  Stretch="Fill"/>
            <Path Data="M 805 225 C 900 180, 1022 190, 1088 245 S 1130 315, 1038 338 S 875 328, 835 287 S 725 263, 805 225"
                  Stroke="#65F08A3C"
                  StrokeThickness="1.2"
                  Stretch="Fill"/>
            <ItemsControl ItemsSource="{Binding SignalBars}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Bottom"
                          Margin="0,0,0,34">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="8"
                                Height="{Binding}"
                                CornerRadius="999"
                                Margin="4,0"
                                VerticalAlignment="Bottom"
                                Background="#BBDDA36B"
                                BorderBrush="#66E8E1D2"
                                BorderThickness="1"
                                RenderTransformOrigin="0.5,1">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleY="2.65"/>
                            </Border.RenderTransform>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18" Spacing="14" MaxWidth="980" HorizontalAlignment="Center">
                <Border CornerRadius="34"
                        Padding="14"
                        BorderBrush="#72DDA36B"
                        BorderThickness="1"
                        Background="#F2E8CEC8"
                        ClipToBounds="True">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                        <Path Grid.RowSpan="3"
                              Data="M 0 50 C 90 20, 160 78, 250 45 S 420 24, 560 64 S 780 35, 960 58"
                              Stroke="#2FDDA36B"
                              StrokeThickness="1.2"
                              Stretch="Fill"
                              IsHitTestVisible="False"/>
                        <Path Grid.RowSpan="3"
                              Data="M 0 112 C 110 85, 190 150, 310 102 S 510 95, 690 132 S 850 105, 980 126"
                              Stroke="#227FCAD1"
                              StrokeThickness="1"
                              Stretch="Fill"
                              IsHitTestVisible="False"/>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                            <StackPanel>
                                <TextBlock Text="{Binding RecordingGuardLabel}"
                                           FontSize="26"
                                           FontWeight="Black"
                                           TextWrapping="Wrap"
                                           Foreground="#120918"/>
                                <TextBlock Text="{Binding CaptureInstruction}"
                                           Margin="0,2,0,0"
                                           FontSize="11"
                                           FontWeight="Black"
                                           TextWrapping="Wrap"
                                           Foreground="#4A351E"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    CornerRadius="24"
                                    MinWidth="122"
                                    Padding="16,12"
                                    Background="#06070C"
                                    BorderBrush="#70DDA36B"
                                    BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PeakLabel}"
                                               FontSize="25"
                                               FontWeight="Black"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding PeakDecibelLabel}"
                                               Margin="0,3,0,0"
                                               FontSize="10"
                                               FontWeight="Black"
                                               LetterSpacing="1.5"
                                               HorizontalAlignment="Center"
                                               Foreground="#F2C56B"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="1"
                                CornerRadius="21"
                                Padding="8"
                                Background="#D90E1013"
                                BorderBrush="#4DDDA36B"
                                BorderThickness="1"
                                MinHeight="58"
                                MaxHeight="66">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="13">
                                <ItemsControl
                                              ItemsSource="{Binding SignalBars}"
                                              VerticalAlignment="Stretch"
                                              HorizontalAlignment="Stretch">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="8"
                                                    Height="{Binding}"
                                                    CornerRadius="999"
                                                    VerticalAlignment="Center"
                                                    Margin="2,0"
                                                    Background="#DDA36B"
                                                    BorderBrush="#447FCAD1"
                                                    BorderThickness="1"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SimpleSignalLabel}"
                                           FontSize="10"
                                           FontWeight="Black"
                                           LetterSpacing="1.5"
                                           VerticalAlignment="Center"
                                           Foreground="#7FCAD1"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1"
                              IsHitTestVisible="False">
                            <Border IsVisible="{Binding IsBusy}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    CornerRadius="999"
                                    Padding="13,8"
                                    Background="#E61C1309"
                                    BorderBrush="#70DDA36B"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ProgressBar IsIndeterminate="True"
                                                 Width="42"
                                                 Height="6"
                                                 Background="#2A211A"
                                                 Foreground="#DDA36B"/>
                                    <TextBlock Text="{Binding BusyLabel}"
                                               FontSize="11"
                                               FontWeight="Black"
                                               Foreground="#E8E1D2"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2"
                              ColumnDefinitions="Auto,Auto,*,*"
                              ColumnSpacing="10">
                            <Button Content="{Binding RecordingButtonLabel}"
                                    Command="{Binding StartRecordingCommand}"
                                    IsVisible="{Binding CanStartRecording}"
                                    Padding="24,11"
                                    MinWidth="230"
                                    Margin="0"
                                    FontSize="18"
                                    Background="#06070C"
                                    Foreground="#E8E1D2"/>
                            <Button Content="{Binding StopButtonLabel}"
                                    Command="{Binding StopRecordingCommand}"
                                    IsVisible="{Binding CanStopRecording}"
                                    Padding="24,11"
                                    MinWidth="230"
                                    Margin="0"
                                    FontSize="18"
                                    Background="#DDA36B"
                                    Foreground="#120918"/>
                            <Button Grid.Column="1"
                                    Content="Folder"
                                    Command="{Binding OpenFolderCommand}"
                                    Padding="20,11"
                                    MinWidth="150"
                                    Margin="0"
                                    Background="#F2EEE3"
                                    Foreground="#120918"/>
                            <ComboBox Grid.Column="2"
                                      ItemsSource="{Binding CaptureLanes}"
                                      SelectedItem="{Binding SelectedCaptureLane}"
                                      MinHeight="40"/>
                            <ComboBox Grid.Column="3"
                                      ItemsSource="{Binding InputDevices}"
                                      SelectedItem="{Binding SelectedInputDevice}"
                                      MinHeight="40"/>
                        </Grid>

                        <StackPanel Grid.Row="2" Spacing="5" IsVisible="False">
                            <TextBlock Text="{Binding Status}"
                                       FontSize="13"
                                       FontWeight="Black"
                                       TextWrapping="Wrap"
                                       Foreground="#120918"/>
                            <TextBlock Text="{Binding SignalProbeSummary}"
                                       FontSize="11"
                                       FontWeight="Black"
                                       TextWrapping="Wrap"
                                       Foreground="#527167"/>
                            <TextBlock Text="{Binding LastRecorderDiagnostic}"
                                       FontSize="11"
                                       FontWeight="Black"
                                       TextWrapping="Wrap"
                                       Foreground="#806A3F"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border CornerRadius="24"
                        Padding="14"
                        BorderBrush="#55DDA36B"
                        BorderThickness="1"
                        Background="#D90E1013">
                    <StackPanel Spacing="9">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding ChatText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Command..."
                                     MinHeight="42"/>
                            <Button Grid.Column="1"
                                     Content=">"
                                     Command="{Binding RunChatCommandCommand}"
                                     Padding="16,10"
                                     MinWidth="58"
                                     Background="#DDA36B"
                                     Foreground="#120918"/>
                        </Grid>
                        <TextBlock Text="{Binding CommandResult}"
                                   FontSize="11"
                                   FontWeight="Black"
                                   TextWrapping="Wrap"
                                   Foreground="#E8E1D2"/>
                        <Border CornerRadius="20"
                                Padding="12"
                                BorderBrush="#44DDA36B"
                                BorderThickness="1"
                                Background="#99130F16">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <WrapPanel Orientation="Horizontal">
                                    <Button Command="{Binding StageRawCleanCommand}" Width="108" Height="34" Padding="0" Margin="0,0,8,0" Background="Transparent" BorderThickness="0">
                                        <Border CornerRadius="12" BorderBrush="#70F2EEE3" BorderThickness="1.1">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                    <GradientStop Color="#1A1814" Offset="0"/>
                                                    <GradientStop Color="#F2EEE3" Offset="0.38"/>
                                                    <GradientStop Color="#5B5148" Offset="0.7"/>
                                                    <GradientStop Color="#0B0B0D" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Path Data="M 10 17 L 98 17" Stroke="#AA06070C" StrokeThickness="1.8"/>
                                        </Border>
                                    </Button>
                                    <Button Command="{Binding StageLateNightChromeCommand}" Width="108" Height="34" Padding="0" Margin="0,0,8,0" Background="Transparent" BorderThickness="0">
                                        <Border CornerRadius="12" BorderBrush="#80F2EEE3" BorderThickness="1.1">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                    <GradientStop Color="#080A12" Offset="0"/>
                                                    <GradientStop Color="#F7F3EA" Offset="0.28"/>
                                                    <GradientStop Color="#7B8493" Offset="0.48"/>
                                                    <GradientStop Color="#FFF8F0" Offset="0.62"/>
                                                    <GradientStop Color="#1C2230" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid>
                                                <Path Data="M 8 24 C 28 6, 63 30, 100 10" Stroke="#996EE7FF" StrokeThickness="1.6"/>
                                                <Path Data="M 12 9 L 40 9 M 62 25 L 96 25" Stroke="#99F2EEE3" StrokeThickness="1.1"/>
                                            </Grid>
                                        </Border>
                                    </Button>
                                    <Button Command="{Binding QuickWarmerCommand}" Width="108" Height="34" Padding="0" Margin="0,0,8,0" Background="Transparent" BorderThickness="0">
                                        <Border CornerRadius="12" BorderBrush="#94F08A3C" BorderThickness="1.1">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                    <GradientStop Color="#160908" Offset="0"/>
                                                    <GradientStop Color="#F08A3C" Offset="0.42"/>
                                                    <GradientStop Color="#C64925" Offset="0.72"/>
                                                    <GradientStop Color="#180907" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid>
                                                <Path Data="M 8 25 C 18 9, 25 24, 34 10 C 42 26, 55 19, 64 28 C 76 10, 88 19, 101 8" Stroke="#DDF2EEE3" StrokeThickness="1.25"/>
                                                <Path Data="M 10 27 L 98 27" Stroke="#55FFF0B8" StrokeThickness="1"/>
                                            </Grid>
                                        </Border>
                                    </Button>
                                    <Button Command="{Binding QuickReverbCommand}" Width="108" Height="34" Padding="0" Margin="0,0,8,0" Background="Transparent" BorderThickness="0">
                                        <Border CornerRadius="12" BorderBrush="#6C7FCAD1" BorderThickness="1.1">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                    <GradientStop Color="#081016" Offset="0"/>
                                                    <GradientStop Color="#16313A" Offset="0.44"/>
                                                    <GradientStop Color="#7FCAD1" Offset="0.63"/>
                                                    <GradientStop Color="#081016" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Path Data="M 12 18 C 30 4, 78 4, 96 18 M 24 24 C 40 14, 68 14, 84 24" Stroke="#DDF2EEE3" StrokeThickness="1.25"/>
                                        </Border>
                                    </Button>
                                    <Button Command="{Binding QuickLouderCommand}" Width="108" Height="34" Padding="0" Margin="0,0,8,0" Background="Transparent" BorderThickness="0">
                                        <Border CornerRadius="12" BorderBrush="#647FCAD1" BorderThickness="1.1">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                    <GradientStop Color="#081016" Offset="0"/>
                                                    <GradientStop Color="#0B3E4D" Offset="0.58"/>
                                                    <GradientStop Color="#DDA36B" Offset="0.82"/>
                                                    <GradientStop Color="#130F0B" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Path Data="M 10 25 L 18 12 L 27 24 L 37 8 L 47 26 L 58 14 L 70 23 L 83 10 L 99 24" Stroke="#DDF2EEE3" StrokeThickness="1.25"/>
                                        </Border>
                                    </Button>
                                    <Button Content="X" Command="{Binding QuickDeleteCommand}" Width="42" Height="34" Padding="0" Margin="0,0,8,0" Background="#4A231B" Foreground="#E8E1D2"/>
                                </WrapPanel>
                                <Button Grid.Column="1"
                                        Content=">"
                                        Command="{Binding RenderSelectedVocalPresetCommand}"
                                        Padding="15,10"
                                        MinWidth="60"
                                        VerticalAlignment="Center"
                                        Background="#7FCAD1"
                                        Foreground="#120918"/>
                            </Grid>
                        </Border>
                        <StackPanel IsVisible="{Binding IsCommandBusy}" Spacing="6">
                            <TextBlock Text="Working..."
                                       FontSize="11"
                                       FontWeight="Black"
                                       LetterSpacing="1.8"
                                       Foreground="#DDA36B"/>
                            <ProgressBar IsIndeterminate="True"
                                         Height="6"
                                         Background="#2A211A"
                                         Foreground="#F2C56B"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border CornerRadius="28"
                        Padding="0"
                        BorderBrush="#33DDA36B"
                        BorderThickness="1"
                        Background="#CC090D13"
                        ClipToBounds="True">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="0">
                        <Border Padding="14"
                                Background="#B90B1017">
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="13">
                                    <TextBlock Text="TAKE"
                                               FontSize="10"
                                               FontWeight="Black"
                                               LetterSpacing="2.2"
                                               Foreground="#DDA36B"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding LatestTakeDetail}"
                                               FontSize="12"
                                               FontWeight="Black"
                                               TextWrapping="Wrap"
                                               Foreground="#7FCAD1"/>
                                </Grid>
                                <ScrollViewer Grid.Row="1"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto"
                                              MaxHeight="108">
                                    <ItemsControl ItemsSource="{Binding Versions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="svc:RecorderVersionFile">
                                                <Border Classes="take-row"
                                                        CornerRadius="18"
                                                        Padding="12,10"
                                                        Margin="0,0,0,7"
                                                        Background="#66131A24"
                                                        BorderBrush="#2EDDA36B"
                                                        BorderThickness="1">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                        <Path Grid.ColumnSpan="2"
                                                              Data="M -8 29 C 46 12, 92 38, 146 22 S 248 10, 312 31 S 432 43, 540 18"
                                                              Stroke="#267FCAD1"
                                                              StrokeThickness="1.2"
                                                              Stretch="Fill"
                                                              IsHitTestVisible="False"/>
                                                        <Path Grid.ColumnSpan="2"
                                                              Data="M -10 43 C 62 24, 126 53, 202 35 S 338 19, 452 48"
                                                              Stroke="#24DDA36B"
                                                              StrokeThickness="1"
                                                              Stretch="Fill"
                                                              IsHitTestVisible="False"/>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontSize="12"
                                                                       FontWeight="Black"
                                                                       TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding DisplayMeta}"
                                                                       FontSize="10"
                                                                       FontWeight="Black"
                                                                       Foreground="#7FCAD1"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1"
                                                                    Classes="take-actions"
                                                                    Orientation="Horizontal"
                                                                    Spacing="7"
                                                                    VerticalAlignment="Center">
                                                            <Button Content="Play"
                                                                    Command="{Binding $parent[Window].DataContext.PlayVersionCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Padding="11,7"
                                                                    MinWidth="68"
                                                                    MinHeight="32"
                                                                    Background="#211815"
                                                                    Foreground="#E8E1D2"/>
                                                            <Button Content="Folder"
                                                                    Command="{Binding $parent[Window].DataContext.OpenVersionFolderCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Padding="11,7"
                                                                    MinWidth="78"
                                                                    MinHeight="32"
                                                                    Background="#F2EEE3"
                                                                    Foreground="#120918"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border CornerRadius="28"
                        Padding="18"
                        BorderBrush="#44DDA36B"
                        BorderThickness="1"
                        Background="#D90E1013">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="13">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="13">
                            <StackPanel Spacing="6">
                                <TextBlock Text="CONTENT PACK"
                                           FontSize="10"
                                           FontWeight="Black"
                                           LetterSpacing="2.2"
                                           Foreground="#DDA36B"/>
                                <TextBlock Text="One take -> one world -> one post."
                                           FontSize="20"
                                           FontWeight="Black"
                                           TextWrapping="Wrap"
                                           Foreground="#E8E1D2"/>
                                <TextBlock Text="{Binding ContentPackTakeLabel}"
                                           FontSize="12"
                                           FontWeight="Black"
                                           TextWrapping="Wrap"
                                           Foreground="#7FCAD1"/>
                            </StackPanel>
                            <WrapPanel Grid.Column="1"
                                       Orientation="Horizontal"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       MaxWidth="520">
                                <ComboBox ItemsSource="{Binding ContentPackWorlds}"
                                          SelectedItem="{Binding ContentPackWorld}"
                                          MinWidth="132"
                                          Margin="0,0,8,8"/>
                                <ComboBox ItemsSource="{Binding ContentPackClipTypes}"
                                          SelectedItem="{Binding ContentPackClipType}"
                                          MinWidth="132"
                                          Margin="0,0,8,8"/>
                                <Button Content="Generate"
                                        Command="{Binding GenerateContentPackCommand}"
                                        Padding="16,11"
                                        MinWidth="118"
                                        Margin="0,0,8,8"
                                        Background="#DDA36B"
                                        Foreground="#120918"/>
                                <Button Content="Packs"
                                        Command="{Binding OpenContentPackFolderCommand}"
                                        Padding="16,11"
                                        MinWidth="92"
                                        Margin="0,0,0,8"
                                        Background="#211815"
                                        Foreground="#E8E1D2"/>
                            </WrapPanel>
                        </Grid>
                        <StackPanel Grid.Row="1" Spacing="8">
                            <TextBlock Text="{Binding ContentPackSaveLabel}"
                                       FontSize="11"
                                       FontWeight="Black"
                                       TextWrapping="Wrap"
                                       Foreground="#7FCAD1"/>
                            <TextBox Text="{Binding ContentPackResult}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="116"
                                     Background="#FFF2E2C8"
                                     Foreground="#120918"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border CornerRadius="28"
                        Padding="18"
                        BorderBrush="#33DDA36B"
                        BorderThickness="1"
                        Background="#CC090D13">
                    <StackPanel Spacing="13">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="13">
                            <StackPanel Spacing="6">
                                <TextBlock Text="TASTE MEMORY"
                                           FontSize="10"
                                           FontWeight="Black"
                                           LetterSpacing="2.2"
                                           Foreground="#DDA36B"/>
                                <TextBlock Text="{Binding TasteMemorySummary}"
                                           FontSize="18"
                                           FontWeight="Black"
                                           TextWrapping="Wrap"
                                           Foreground="#E8E1D2"/>
                                <TextBlock Text="{Binding TasteNextMove}"
                                           FontSize="12"
                                           FontWeight="Black"
                                           TextWrapping="Wrap"
                                           Foreground="#7FCAD1"/>
                            </StackPanel>
                            <WrapPanel Grid.Column="1"
                                       Orientation="Horizontal"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       MaxWidth="420">
                                <ComboBox ItemsSource="{Binding TasteRatings}"
                                          SelectedItem="{Binding TasteRating}"
                                          MinWidth="82"
                                          Margin="0,0,8,8"/>
                                <ComboBox ItemsSource="{Binding ContentPackWorlds}"
                                          SelectedItem="{Binding TasteMood}"
                                          MinWidth="124"
                                          Margin="0,0,8,8"/>
                                <Button Content="Save taste"
                                        Command="{Binding SaveTasteMemoryCommand}"
                                        Padding="16,11"
                                        MinWidth="122"
                                        Margin="0,0,8,8"
                                        Background="#DDA36B"
                                        Foreground="#120918"/>
                                <Button Content="Memory"
                                        Command="{Binding OpenTasteMemoryFolderCommand}"
                                        Padding="16,11"
                                        MinWidth="100"
                                        Margin="0,0,0,8"
                                        Background="#211815"
                                        Foreground="#E8E1D2"/>
                            </WrapPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="13">
                            <TextBox Text="{Binding TasteWorked}"
                                     PlaceholderText="What worked?"
                                     MinHeight="82"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding TasteOff}"
                                     PlaceholderText="What was off?"
                                     MinHeight="82"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"/>
                        </Grid>
                        <TextBlock Text="{Binding TasteMemoryStatus}"
                                   FontSize="11"
                                   FontWeight="Black"
                                   TextWrapping="Wrap"
                                   Foreground="#F2C56B"/>
                    </StackPanel>
                </Border>

                <Border CornerRadius="28"
                        Padding="18"
                        BorderBrush="#446EE7FF"
                        BorderThickness="1"
                        Background="#CC07111F">
                    <StackPanel Spacing="13">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="13">
                            <StackPanel Spacing="6">
                                <TextBlock Text="LIVE ALBUM"
                                           FontSize="10"
                                           FontWeight="Black"
                                           LetterSpacing="2.2"
                                           Foreground="#7FCAD1"/>
                                <TextBlock Text="{Binding LiveAlbumEra}"
                                           FontSize="18"
                                           FontWeight="Black"
                                           TextWrapping="Wrap"
                                           Foreground="#E8E1D2"/>
                                <TextBlock Text="{Binding LiveAlbumPlan}"
                                           FontSize="12"
                                           FontWeight="Black"
                                           TextWrapping="Wrap"
                                           Foreground="#DDA36B"/>
                            </StackPanel>
                            <WrapPanel Grid.Column="1"
                                       Orientation="Horizontal"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       MaxWidth="420">
                                <ComboBox ItemsSource="{Binding LiveAlbumScenes}"
                                          SelectedItem="{Binding LiveAlbumScene}"
                                          MinWidth="164"
                                          Margin="0,0,8,8"/>
                                <Button Content="Save note"
                                        Command="{Binding SaveLiveAlbumNoteCommand}"
                                        Padding="16,11"
                                        MinWidth="118"
                                        Margin="0,0,8,8"
                                        Background="#7FCAD1"
                                        Foreground="#120918"/>
                                <Button Content="Folder"
                                        Command="{Binding OpenLiveAlbumFolderCommand}"
                                        Padding="16,11"
                                        MinWidth="92"
                                        Margin="0,0,0,8"
                                        Background="#211815"
                                        Foreground="#E8E1D2"/>
                            </WrapPanel>
                        </Grid>
                        <TextBox Text="{Binding LiveAlbumNote}"
                                 PlaceholderText="What is this session becoming?"
                                 MinHeight="82"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding LiveAlbumStatus}"
                                   FontSize="11"
                                   FontWeight="Black"
                                   TextWrapping="Wrap"
                                   Foreground="#F2C56B"/>
                    </StackPanel>
                </Border>

                <Border CornerRadius="28"
                        Padding="18"
                        BorderBrush="#44DDA36B"
                        BorderThickness="1"
                        Background="#D90E1013">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="21">
                        <StackPanel Spacing="8">
                            <TextBlock Text="POST CLIP"
                                       FontSize="10"
                                       FontWeight="Black"
                                       LetterSpacing="2.2"
                                       Foreground="#DDA36B"/>
                            <TextBlock Text="{Binding VideoLayerTitle}"
                                       FontSize="20"
                                       FontWeight="Black"
                                       TextWrapping="Wrap"
                                       Foreground="#E8E1D2"/>
                            <TextBlock Text="{Binding VideoLayerDetail}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="#7FCAD1"/>
                            <TextBlock Text="{Binding VideoWorkflowStatus}"
                                       FontSize="11"
                                       FontWeight="Black"
                                       TextWrapping="Wrap"
                                       Foreground="#F2C56B"/>
                            <WrapPanel Orientation="Horizontal">
                                <Button Content="Audio earlier"
                                        Command="{Binding AudioEarlierCommand}"
                                        Padding="13,9"
                                        MinWidth="118"
                                        Margin="0,0,8,8"
                                        Background="#211815"
                                        Foreground="#E8E1D2"/>
                                <Border CornerRadius="999"
                                        Padding="13,9"
                                        Margin="0,0,8,8"
                                        BorderBrush="#44DDA36B"
                                        BorderThickness="1"
                                        Background="#99130F16">
                                    <TextBlock Text="{Binding VideoSyncLabel}"
                                               FontSize="11"
                                               FontWeight="Black"
                                               Foreground="#7FCAD1"/>
                                </Border>
                                <Button Content="Audio later"
                                        Command="{Binding AudioLaterCommand}"
                                        Padding="13,9"
                                        MinWidth="108"
                                        Margin="0,0,8,8"
                                        Background="#211815"
                                        Foreground="#E8E1D2"/>
                                <Button Content="Reset"
                                        Command="{Binding ResetVideoSyncCommand}"
                                        Padding="13,9"
                                        MinWidth="76"
                                        Margin="0,0,8,8"
                                        Background="#99130F16"
                                        Foreground="#E8E1D2"/>
                                <Button Content="Auto sync"
                                        Command="{Binding AutoSyncPostClipCommand}"
                                        Padding="13,9"
                                        MinWidth="100"
                                        Margin="0,0,8,8"
                                        Background="#7FCAD1"
                                        Foreground="#120918"/>
                                <Button Content="{Binding VideoExportPresetLabel}"
                                        Command="{Binding ToggleVideoPresetCommand}"
                                        Padding="13,9"
                                        MinWidth="112"
                                        Margin="0,0,8,8"
                                        Background="#DDA36B"
                                        Foreground="#120918"/>
                            </WrapPanel>
                        </StackPanel>
                        <WrapPanel Grid.Column="1"
                                   Orientation="Horizontal"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   MaxWidth="360">
                            <Button Content="Find video"
                                    Command="{Binding FindLatestPhoneVideoCommand}"
                                    Padding="16,11"
                                    MinWidth="118"
                                    Margin="0,0,8,8"
                                    Background="#211815"
                                    Foreground="#E8E1D2"/>
                            <Button Content="Use take audio"
                                    Command="{Binding RenderPhoneVideoWithTakeCommand}"
                                    Padding="16,11"
                                    MinWidth="142"
                                    Margin="0,0,8,8"
                                    Background="#DDA36B"
                                    Foreground="#120918"/>
                            <Button Content="Make post clip"
                                    Command="{Binding MakePostClipCommand}"
                                    Padding="16,11"
                                    MinWidth="150"
                                    Margin="0,0,8,8"
                                    Background="#7FCAD1"
                                    Foreground="#120918"/>
                            <Button Content="Open clip"
                                    Command="{Binding OpenLatestPostClipCommand}"
                                    Padding="16,11"
                                    MinWidth="110"
                                    Margin="0,0,8,8"
                                    Background="#211815"
                                    Foreground="#E8E1D2"/>
                            <Button Content="Exports"
                                    Command="{Binding OpenVideoOutputFolderCommand}"
                                    Padding="16,11"
                                    MinWidth="96"
                                    Margin="0,0,8,8"
                                    Background="#F2EEE3"
                                    Foreground="#120918"/>
                        </WrapPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

