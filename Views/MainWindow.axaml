<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GateKPT.MusicOS.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1360"
        d:DesignHeight="860"
        x:Class="GateKPT.MusicOS.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="GateKPT Music OS"
        Width="1360"
        Height="860"
        MinWidth="1080"
        MinHeight="720"
        Background="#070706">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial"/>
        </Style>

        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="LetterSpacing" Value="2.8"/>
            <Setter Property="Foreground" Value="#D9B36F"/>
        </Style>

        <Style Selector="Border.card">
            <Setter Property="CornerRadius" Value="32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#26F8F0E5"/>
            <Setter Property="Background" Value="#B3120F0B"/>
            <Setter Property="Padding" Value="24"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Opacity" Value="0.84"/>
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="Opacity" Value="0.64"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="CaretBrush" Value="#E37B45"/>
            <Setter Property="SelectionBrush" Value="#66E37B45"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="#E37B45"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="BorderBrush" Value="#26F8F0E5"/>
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="#12F8F0E5"/>
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="#20E37B45"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#070706" Offset="0"/>
                <GradientStop Color="#15120D" Offset="0.45"/>
                <GradientStop Color="#24150E" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Ellipse Grid.RowSpan="2" Width="640" Height="640" Fill="#1CE37B45"
                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-280,-320,0,0"/>
        <Ellipse Grid.RowSpan="2" Width="720" Height="720" Fill="#146FB6A6"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-320,-340"/>

        <Border Padding="30,18" BorderBrush="#18F8F0E5" BorderThickness="0,0,0,1" Background="#B0070706">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="15">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#F2EADC" Offset="0"/>
                                <GradientStop Color="#E37B45" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="G" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="19" FontWeight="Black" Foreground="#15120D"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="GateKPT" FontSize="16" FontWeight="Black" Foreground="#F8F0E5"/>
                        <TextBlock Text="VIDEO AUDIO WORKSTATION" FontSize="10" FontWeight="Bold" Foreground="#766A5B" LetterSpacing="1.8"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" CornerRadius="999" Background="#0CFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1"
                        Padding="16,8" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding TodayState}" FontSize="12" FontWeight="Bold" Foreground="#A89B88"/>
                        <TextBlock Text="|" FontSize="12" Foreground="#4DFFFFFF"/>
                        <TextBlock Text="{Binding ToolchainStatus}" FontSize="12" FontWeight="Bold" Foreground="#D9B36F"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" CornerRadius="999" Background="#18F8F0E5" BorderBrush="#28F8F0E5" BorderThickness="1" Padding="14,8">
                    <TextBlock Text="{Binding OperatorName}" FontSize="12" FontWeight="Black" Foreground="#F8F0E5"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="350,*" Margin="30" ColumnSpacing="22">
            <Border Classes="card">
                <Grid RowDefinitions="Auto,Auto,*">
                    <StackPanel>
                        <TextBlock Classes="label" Text="ACTIVE ROOM"/>
                        <TextBlock Text="{Binding ActiveRoom}"
                                   Margin="0,12,0,0"
                                   FontSize="44"
                                   FontWeight="Black"
                                   LineHeight="41"
                                   Foreground="#F8F0E5"/>
                        <TextBlock Text="{Binding BusinessMode}"
                                   Margin="0,14,0,0"
                                   FontSize="14"
                                   LineHeight="22"
                                   TextWrapping="Wrap"
                                   Foreground="#958875"/>
                    </StackPanel>

                    <Button Grid.Row="1"
                            Margin="0,28,0,24"
                            Padding="20,13"
                            HorizontalAlignment="Stretch"
                            Background="#F2EADC"
                            Foreground="#15120D"
                            FontWeight="Black"
                            Command="{Binding StartSessionCommand}"
                            Content="Start today's session"/>

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Rooms}"
                             SelectedItem="{Binding SelectedRoom}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:OsRoom">
                                <Border CornerRadius="22" Background="#CC0F0C08" BorderBrush="#18F8F0E5" BorderThickness="1" Padding="14">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Width="40" Height="40" CornerRadius="15" Background="#12F8F0E5" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="12" FontWeight="Black" Foreground="{Binding Accent}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Black" Foreground="#F8F0E5"/>
                                            <TextBlock Text="{Binding Description}" Margin="0,4,0,0" FontSize="12"
                                                       TextWrapping="Wrap" Foreground="#7E7466"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="1.04*,0.96*,Auto" RowSpacing="18">
                <Border CornerRadius="38" BorderBrush="#33F8F0E5" BorderThickness="1" Padding="34">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#F2EADC" Offset="0"/>
                            <GradientStop Color="#DCCAB0" Offset="0.62"/>
                            <GradientStop Color="#9DBFB3" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid ColumnDefinitions="1.02*,0.98*" ColumnSpacing="30">
                        <StackPanel VerticalAlignment="Center">
                            <Border CornerRadius="999" Background="#2415120D" Padding="12,7" HorizontalAlignment="Left">
                                <TextBlock Text="VIDEO AUDIO ENGINE" FontSize="11" FontWeight="Black" Foreground="#8D5631" LetterSpacing="3"/>
                            </Border>
                            <TextBlock Text="{Binding ProjectName}"
                                       Margin="0,14,0,0"
                                       FontSize="60"
                                       FontWeight="Black"
                                       LineHeight="54"
                                       TextWrapping="Wrap"
                                       Foreground="#15120D"/>
                            <TextBlock Text="Sync mouth movement to final vocal, edit takes, mix the audio, export clips, and keep the production memory in one local system."
                                       Margin="0,20,0,0"
                                       FontSize="15"
                                       LineHeight="24"
                                       TextWrapping="Wrap"
                                       Foreground="#5D503F"/>
                            <Grid Margin="0,22,0,0" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                                <TextBox Text="{Binding ProjectName}" PlaceholderText="Project name" Background="#66FFFFFF" Foreground="#15120D"/>
                                <TextBox Grid.Column="1" Text="{Binding PlatformProfile}" PlaceholderText="Platform / aspect" Background="#66FFFFFF" Foreground="#15120D"/>
                                <TextBox Grid.Row="1" Text="{Binding BusinessMode}" PlaceholderText="Business mode" Background="#66FFFFFF" Foreground="#15120D"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LoudnessTarget}" PlaceholderText="Loudness target" Background="#66FFFFFF" Foreground="#15120D"/>
                            </Grid>
                        </StackPanel>

                        <Border Grid.Column="1" CornerRadius="32" Background="#E615120D" Padding="24"
                                BorderBrush="#18F8F0E5" BorderThickness="1">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                                <TextBlock Classes="label" Text="SYNC LAB"/>

                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                                    <TextBox Text="{Binding VideoPath}"
                                             PlaceholderText="Paste camera video path"
                                             Background="#CC0F0C08"
                                             Foreground="#F8F0E5"
                                             BorderBrush="#22F8F0E5"/>
                                    <Button Grid.Column="1"
                                            Content="Browse video"
                                            Click="BrowseVideo_Click"
                                            Padding="14,10"
                                            Background="#1F1A13"
                                            Foreground="#D9C5A5"/>
                                    <TextBox Grid.Row="1"
                                             Text="{Binding VocalPath}"
                                             PlaceholderText="Paste final vocal/audio path"
                                             Background="#CC0F0C08"
                                             Foreground="#F8F0E5"
                                             BorderBrush="#22F8F0E5"/>
                                    <Button Grid.Row="1"
                                            Grid.Column="1"
                                            Content="Browse audio"
                                            Click="BrowseVocal_Click"
                                            Padding="14,10"
                                            Background="#1F1A13"
                                            Foreground="#D9C5A5"/>
                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10">
                                        <Button Content="Inspect media"
                                                Command="{Binding InspectMediaCommand}"
                                                Padding="18,10"
                                                Background="#1F1A13"
                                                Foreground="#D9C5A5"
                                                FontWeight="Black"/>
                                        <Button Content="Analyze sync"
                                                Command="{Binding AnalyzeMediaCommand}"
                                                Padding="18,10"
                                                Background="#F2EADC"
                                                Foreground="#15120D"
                                                FontWeight="Black"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                    <Border CornerRadius="18" Background="#130F0B" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SyncOffsetMs, StringFormat={}{0:+#;-#;0} ms}" FontSize="30" FontWeight="Black" Foreground="#E37B45"/>
                                            <TextBlock Text="vocal offset" FontSize="11" Foreground="#8E8170"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" CornerRadius="18" Background="#130F0B" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SyncConfidence, StringFormat={}{0:P0}}" FontSize="30" FontWeight="Black" Foreground="#EABF7A"/>
                                            <TextBlock Text="sync confidence" FontSize="11" Foreground="#8E8170"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" CornerRadius="18" Background="#130F0B" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="{Binding LoudnessTarget}" FontSize="26" FontWeight="Black" Foreground="#6FB6A6"/>
                                            <TextBlock Text="export loudness" FontSize="11" Foreground="#8E8170"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="3" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <TextBlock Text="VIDEO" Width="54" FontSize="10" FontWeight="Black" Foreground="#8E8170"/>
                                        <TextBlock Grid.Column="1" Text="{Binding VideoFileName}" FontSize="11" Foreground="#D9C5A5"/>
                                        <TextBlock Grid.Column="2" Text="{Binding VideoDuration}" FontSize="11" Foreground="#6FB6A6"/>
                                    </Grid>
                                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <TextBlock Text="VOCAL" Width="54" FontSize="10" FontWeight="Black" Foreground="#8E8170"/>
                                        <TextBlock Grid.Column="1" Text="{Binding VocalFileName}" FontSize="11" Foreground="#D9C5A5"/>
                                        <TextBlock Grid.Column="2" Text="{Binding VocalDuration}" FontSize="11" Foreground="#6FB6A6"/>
                                    </Grid>
                                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Waveform}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="3"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:WaveformBar">
                                                <Border Width="5"
                                                        Height="{Binding Height}"
                                                        CornerRadius="3"
                                                        VerticalAlignment="Center"
                                                        Background="#E37B45"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>

                                <TextBlock Grid.Row="4"
                                           Text="{Binding SyncRecommendation}"
                                           FontSize="12"
                                           LineHeight="19"
                                           TextWrapping="Wrap"
                                           Foreground="#D9C5A5"/>

                                <Grid Grid.Row="5" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="8">
                                    <Button Content="-100"
                                            Command="{Binding NudgeOffsetCommand}"
                                            CommandParameter="-100"
                                            Padding="10,8"
                                            Background="#1F1A13"
                                            Foreground="#D9C5A5"/>
                                    <Button Grid.Column="1"
                                            Content="-10"
                                            Command="{Binding NudgeOffsetCommand}"
                                            CommandParameter="-10"
                                            Padding="10,8"
                                            Background="#1F1A13"
                                            Foreground="#D9C5A5"/>
                                    <Button Grid.Column="2"
                                            Content="0"
                                            Command="{Binding ResetOffsetCommand}"
                                            Padding="10,8"
                                            Background="#F2EADC"
                                            Foreground="#15120D"/>
                                    <Button Grid.Column="3"
                                            Content="+10"
                                            Command="{Binding NudgeOffsetCommand}"
                                            CommandParameter="10"
                                            Padding="10,8"
                                            Background="#1F1A13"
                                            Foreground="#D9C5A5"/>
                                    <Button Grid.Column="4"
                                            Content="+100"
                                            Command="{Binding NudgeOffsetCommand}"
                                            CommandParameter="100"
                                            Padding="10,8"
                                            Background="#1F1A13"
                                            Foreground="#D9C5A5"/>
                                </Grid>

                                <ItemsControl Grid.Row="6" ItemsSource="{Binding Ritual}" IsVisible="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,10">
                                                <Border Width="22" Height="22" CornerRadius="11" Background="#6FB6A6" Margin="0,1,12,0">
                                                    <TextBlock Text="+" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="#15120D" FontSize="14" FontWeight="Black"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12" LineHeight="19"
                                                           TextWrapping="Wrap" Foreground="#D9C5A5"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="22">
                    <Border Classes="card">
                        <StackPanel>
                            <TextBlock Classes="label" Text="SESSION LOG"/>
                            <ItemsControl ItemsSource="{Binding RecentCaptures}" Margin="0,18,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CaptureItem">
                                        <Border CornerRadius="22" Background="#B30F0C08" BorderBrush="#12F8F0E5"
                                                BorderThickness="1" Padding="16" Margin="0,0,0,12">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Black" Foreground="#F8F0E5"/>
                                                    <TextBlock Text="{Binding Detail}" Margin="0,5,0,0" FontSize="12"
                                                               TextWrapping="Wrap" Foreground="#8E8170"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" CornerRadius="999" Background="#22E37B45"
                                                        Padding="10,5" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Black" Foreground="#E37B45"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border CornerRadius="22" Background="#990F0C08" BorderBrush="#16F8F0E5" BorderThickness="1" Padding="14" Margin="0,10,0,0">
                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                    <TextBlock Text="TIMELINE MARKERS" FontSize="11" FontWeight="Black" Foreground="#D9B36F" LetterSpacing="2.8"/>
                                    <Grid Grid.Row="1" ColumnDefinitions="92,*,Auto" ColumnSpacing="8">
                                        <TextBox Text="{Binding MarkerTimecode}"
                                                 PlaceholderText="00:00.000"
                                                 Background="#CC0F0C08"
                                                 Foreground="#F8F0E5"
                                                 BorderBrush="#22F8F0E5"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding MarkerLabel}"
                                                 PlaceholderText="Marker"
                                                 Background="#CC0F0C08"
                                                 Foreground="#F8F0E5"
                                                 BorderBrush="#22F8F0E5"/>
                                        <Button Grid.Column="2"
                                                Content="Add"
                                                Command="{Binding AddTimelineMarkerCommand}"
                                                Padding="14,9"
                                                Background="#EABF7A"
                                                Foreground="#15120D"
                                                FontWeight="Black"/>
                                    </Grid>
                                    <ItemsControl Grid.Row="2" ItemsSource="{Binding TimelineMarkers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TimelineMarker">
                                                <Grid ColumnDefinitions="74,*" Margin="0,0,0,7">
                                                    <TextBlock Text="{Binding Timecode}" FontSize="11" FontWeight="Black" Foreground="#6FB6A6"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="11" Foreground="#D9C5A5"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Grid.Column="1">
                        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="12">
                            <TextBlock Classes="label" Text="TECHNICAL NOTE"/>
                            <TextBlock Text="{Binding ActiveRoom}"
                                       Margin="0,12,0,16"
                                       FontSize="30"
                                       FontWeight="Black"
                                       Foreground="#F8F0E5"/>

                            <Grid Grid.Row="2" ColumnDefinitions="*,150" ColumnSpacing="10">
                                <TextBox Text="{Binding CaptureTitle}"
                                         PlaceholderText="Capture title"
                                         Background="#CC0F0C08"
                                         Foreground="#F8F0E5"
                                         BorderBrush="#22F8F0E5"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Moods}"
                                          SelectedItem="{Binding Mood}"
                                          Background="#CC0F0C08"
                                          Foreground="#F8F0E5"/>
                            </Grid>

                            <TextBox Grid.Row="3"
                                     Text="{Binding CaptureNotes}"
                                     PlaceholderText="{Binding CaptureHint}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Background="#CC0F0C08"
                                     Foreground="#F8F0E5"
                                     BorderBrush="#22F8F0E5"
                                     MinHeight="112"/>

                            <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontSize="12" Foreground="#8E8170"/>
                                <Button Grid.Column="1"
                                        Content="Clear"
                                        Command="{Binding ClearCaptureCommand}"
                                        Padding="17,10"
                                        Background="#1F1A13"
                                        Foreground="#D9C5A5"/>
                                <Button Grid.Column="2"
                                        Content="Save"
                                        Command="{Binding SaveCaptureCommand}"
                                        Padding="20,10"
                                        Background="#F2EADC"
                                        Foreground="#15120D"
                                        FontWeight="Black"/>
                            </Grid>

                            <Border Grid.Row="5" CornerRadius="22" Background="#990F0C08" BorderBrush="#16F8F0E5" BorderThickness="1" Padding="14">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="9">
                                    <TextBlock Text="EXPORT RENDER" FontSize="11" FontWeight="Black" Foreground="#D9B36F" LetterSpacing="2.8"/>
                                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                        <ComboBox ItemsSource="{Binding ExportPresets}"
                                                  SelectedItem="{Binding SelectedExportPreset}"
                                                  Background="#CC0F0C08"
                                                  Foreground="#F8F0E5">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Grid.Column="1"
                                                Content="Render review"
                                                Command="{Binding RenderReviewClipCommand}"
                                                Padding="16,9"
                                                Background="#6FB6A6"
                                                Foreground="#15120D"
                                                FontWeight="Black"/>
                                        <Button Grid.Column="2"
                                                Content="Queue"
                                                Command="{Binding QueueCurrentExportCommand}"
                                                Padding="16,9"
                                                Background="#EABF7A"
                                                Foreground="#15120D"
                                                FontWeight="Black"/>
                                    </Grid>
                                    <ComboBox Grid.Row="2"
                                              ItemsSource="{Binding AudioPresets}"
                                              SelectedItem="{Binding SelectedAudioPreset}"
                                              Background="#CC0F0C08"
                                              Foreground="#F8F0E5">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Grid.Row="3"
                                               Text="{Binding SelectedAudioPresetDescription}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="#8E8170"/>
                                    <TextBox Grid.Row="4"
                                             Text="{Binding OutputDirectory}"
                                             PlaceholderText="Output directory"
                                             Background="#CC0F0C08"
                                             Foreground="#F8F0E5"
                                             BorderBrush="#22F8F0E5"/>
                                    <TextBlock Grid.Row="5"
                                               Text="{Binding LastExportPath}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="#8E8170"/>
                                    <TextBlock Grid.Row="6"
                                               Text="{Binding ToolchainDetail}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="#D9C5A5"/>
                                    <Grid Grid.Row="7" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBlock Text="{Binding ToolchainInstallHint}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="#8E8170"/>
                                        <Button Grid.Column="1"
                                                Content="Recheck"
                                                Command="{Binding RefreshToolchainCommand}"
                                                Padding="14,8"
                                                Background="#1F1A13"
                                                Foreground="#D9C5A5"/>
                                    </Grid>
                                    <Grid Grid.Row="8" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBlock Text="{Binding ExportQueueLabel}"
                                                   FontSize="12"
                                                   FontWeight="Black"
                                                   Foreground="#F8F0E5"/>
                                        <Button Grid.Column="1"
                                                Content="Render next"
                                                Command="{Binding RenderNextQueuedExportCommand}"
                                                Padding="14,8"
                                                Background="#F2EADC"
                                                Foreground="#15120D"
                                                FontWeight="Black"/>
                                    </Grid>
                                    <ItemsControl Grid.Row="9" ItemsSource="{Binding ExportHistory}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ExportHistoryItem">
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,7">
                                                    <TextBlock Text="{Binding AudioPresetName}" FontSize="11" FontWeight="Black" Foreground="#D9C5A5"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding OffsetLabel}" FontSize="11" Foreground="#6FB6A6"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2" CornerRadius="24" Background="#990F0C08" BorderBrush="#16F8F0E5"
                        BorderThickness="1" Padding="18,12">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="ENGINE MODULES" FontSize="11" FontWeight="Black" Foreground="#D9B36F"
                                   LetterSpacing="2.8" Margin="0,2,18,0"/>
                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="14">
                            <ItemsControl ItemsSource="{Binding NextBuild}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="14"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="#8E8170"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Grid.Column="1"
                                    Content="Save Library"
                                    Command="{Binding SaveLibraryCommand}"
                                    Padding="16,8"
                                    Background="#F2EADC"
                                    Foreground="#15120D"
                                    FontWeight="Black"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
