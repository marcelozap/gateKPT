<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GateKPT.MusicOS.ViewModels"
        xmlns:svc="using:GateKPT.MusicOS.Services"
        x:Class="GateKPT.MusicOS.Views.RecorderWindow"
        x:DataType="vm:RecorderWindowViewModel"
        Icon="/Assets/gatekpt.ico"
        Title="GateKPT MusicOS"
        Width="980"
        Height="720"
        MinWidth="640"
        MinHeight="520"
        Background="#08090A">

    <Design.DataContext>
        <vm:RecorderWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#22F4EBDA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-1px)"/>
            <Setter Property="BorderBrush" Value="#6657DAE2"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>
    </Window.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="21" RowSpacing="18" MinWidth="560">
            <Border CornerRadius="34" Padding="28" BorderBrush="#24F4EBDA" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#151719" Offset="0"/>
                        <GradientStop Color="#0B0D0E" Offset="0.55"/>
                        <GradientStop Color="#151127" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                    <StackPanel>
                        <TextBlock Text="GATEKPT MUSICOS"
                                   FontSize="11"
                                   FontWeight="Black"
                                   Foreground="#F0B868"
                                   LetterSpacing="3"/>
                        <TextBlock Text="{Binding PrimaryHeadline}"
                                   Margin="0,10,0,0"
                                   FontSize="48"
                                   FontWeight="Black"
                                   TextWrapping="Wrap"
                                   Foreground="#F4EBDA"/>
                        <TextBlock Text="{Binding PrimaryDetail}"
                                   Margin="0,10,0,0"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   LineHeight="24"
                                   TextWrapping="Wrap"
                               Foreground="#CFC4B3"/>
                        <TextBlock Text="{Binding InputName}"
                                   Margin="0,14,0,0"
                                   FontSize="12"
                                   FontWeight="Black"
                                   TextWrapping="Wrap"
                               Foreground="#57DAE2"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Width="170"
                            Height="170"
                            CornerRadius="999"
                        Background="#F4EBDA">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PeakLabel}"
                                       FontSize="44"
                                       FontWeight="Black"
                                       HorizontalAlignment="Center"
                                   Foreground="#111315"/>
                            <TextBlock Text="SIGNAL"
                                       FontSize="11"
                                       FontWeight="Black"
                                       LetterSpacing="2.5"
                                       HorizontalAlignment="Center"
                                   Foreground="#9A6A35"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1" CornerRadius="20" Background="#B8111315" BorderBrush="#18F4EBDA" BorderThickness="1" Padding="12">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="13">
                    <TextBlock Text="NEXT"
                               FontSize="10"
                               FontWeight="Black"
                               LetterSpacing="2.4"
                               VerticalAlignment="Center"
                               Foreground="#F0B868"/>

                    <Grid Grid.Column="1" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="8">
                        <Button Content="Record"
                                Command="{Binding StartRecordingCommand}"
                                Padding="12,8"
                                MinHeight="36"
                                Background="#F0B868"
                                Foreground="#111315"/>
                        <Button Grid.Column="1"
                                Content="Open take"
                                Command="{Binding PlaySelectedCommand}"
                                Padding="12,8"
                                MinHeight="36"
                                Background="#57DAE2"
                                Foreground="#07110D"/>
                        <Button Grid.Column="2"
                                Content="Shape"
                                Command="{Binding PrimeShapeSoundCommand}"
                                Padding="12,8"
                                MinHeight="36"
                                Background="#A484FF"
                                Foreground="#0B0912"/>
                        <Button Grid.Column="3"
                                Content="Visual"
                                Command="{Binding PrimeVisualCommand}"
                                Padding="12,8"
                                MinHeight="36"
                                Background="#F4EBDA"
                                Foreground="#111315"/>
                        <Button Grid.Column="4"
                                Content="Prep export"
                                Command="{Binding PrimeExportShareCommand}"
                                Padding="12,8"
                                MinHeight="36"
                                Background="#24111315"
                                Foreground="#CFC4B3"/>
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Border CornerRadius="999" Background="#1257DAE2" Padding="12,7" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentFileLabel}"
                                       MaxWidth="180"
                                       FontSize="11"
                                       FontWeight="Black"
                                       TextWrapping="Wrap"
                                       Foreground="#C6F7FA"/>
                        </Border>
                        <Expander Header="Details" Foreground="#CFC4B3">
                            <Border CornerRadius="18" Background="#0B0D0E" BorderBrush="#18F4EBDA" BorderThickness="1" Padding="13" Margin="0,8,0,0">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding SessionMemorySignal}" FontSize="11" FontWeight="Bold" TextWrapping="Wrap" Foreground="#CFC4B3"/>
                                    <TextBlock Text="{Binding SectionTimelineSignal}" FontSize="11" FontWeight="Bold" TextWrapping="Wrap" Foreground="#CFC4B3"/>
                                    <TextBlock Text="{Binding RoutingSignal}" FontSize="11" FontWeight="Bold" TextWrapping="Wrap" Foreground="#CFC4B3"/>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" ColumnDefinitions="1.05*,0.95*" ColumnSpacing="18">
                <StackPanel Spacing="18">
                <Border CornerRadius="28" Background="#EAF4EBDA" Padding="22">
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
                            <TextBlock Text="1. PROVE AUDIO"
                                       FontSize="11"
                                       FontWeight="Black"
                                   Foreground="#9A6A35"
                                       LetterSpacing="2.4"/>
                            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="13">
                                <Button Content="Find Scarlett"
                                        Command="{Binding FindScarlettCommand}"
                                        Padding="18,12"
                                    Background="#111315"
                                    Foreground="#F4EBDA"/>
                                <Button Grid.Column="1"
                                        Content="Check signal"
                                        Command="{Binding CheckSignalCommand}"
                                        Padding="18,12"
                                    Background="#F0B868"
                                    Foreground="#111315"/>
                            </Grid>
                            <TextBlock Grid.Row="2"
                                       Text="Play RC-505. Signal must move."
                                       FontSize="12"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                   Foreground="#5A5045"/>
                        </Grid>
                    </Border>

                <Border CornerRadius="34" Background="#D80D0F10" BorderBrush="#4457DAE2" BorderThickness="2" Padding="24">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="16">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                <StackPanel>
                                    <TextBlock Text="2. RECORD"
                                               FontSize="11"
                                               FontWeight="Black"
                                               Foreground="#57DAE2"
                                               LetterSpacing="2.4"/>
                                    <TextBlock Text="{Binding RecorderStateLabel}"
                                               Margin="0,8,0,0"
                                               FontSize="24"
                                               FontWeight="Black"
                                               TextWrapping="Wrap"
                                               Foreground="#F4EBDA"/>
                                </StackPanel>
                                <Border Grid.Column="1"
                                        CornerRadius="999"
                                        Padding="14,8"
                                        Background="#1D57DAE2">
                                    <TextBlock Text="{Binding NextActionLabel}"
                                               MaxWidth="210"
                                               FontSize="11"
                                               FontWeight="Black"
                                               TextWrapping="Wrap"
                                               Foreground="#C6F7FA"/>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="13">
                                <Button Content="RECORD"
                                        Command="{Binding StartRecordingCommand}"
                                        Padding="28,18"
                                        MinHeight="64"
                                        FontSize="18"
                                        Background="#57DAE2"
                                        Foreground="#07110D"/>
                                <Button Grid.Column="1"
                                        Content="STOP &amp; SAVE"
                                        Command="{Binding StopRecordingCommand}"
                                        Padding="28,18"
                                        MinHeight="64"
                                        FontSize="18"
                                        Background="#F0B868"
                                        Foreground="#111315"/>
                            </Grid>

                            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="13">
                                <Button Content="OPEN / PLAY FILE"
                                        Command="{Binding PlaySelectedCommand}"
                                        Padding="18,13"
                                        Background="#F4EBDA"
                                        Foreground="#111315"/>
                                <Button Grid.Column="1"
                                        Content="STOP INTERNAL"
                                        Command="{Binding StopPlaybackCommand}"
                                        Padding="18,13"
                                        Background="#24111315"
                                        Foreground="#CFC4B3"/>
                            </Grid>

                            <Border Grid.Row="3" CornerRadius="18" Background="#14F4EBDA" Padding="13">
                                <StackPanel>
                                    <TextBlock Text="CURRENT FILE"
                                               FontSize="10"
                                               FontWeight="Black"
                                               LetterSpacing="2"
                                               Foreground="#57DAE2"/>
                                    <TextBlock Text="{Binding CurrentFileLabel}"
                                               Margin="0,5,0,0"
                                               FontSize="13"
                                               FontWeight="Black"
                                               TextWrapping="Wrap"
                                               Foreground="#F4EBDA"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="4" CornerRadius="22" Background="#10111315" BorderBrush="#33F0B868" BorderThickness="1" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="RC-505 CAPTURE MODE"
                                               FontSize="11"
                                               FontWeight="Black"
                                               Foreground="#F0B868"
                                               LetterSpacing="2.4"/>
                                    <TextBlock Text="{Binding Rc505CaptureGuide}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"
                                               Foreground="#CFC4B3"/>
                                    <Button Content="Record full loop"
                                            Command="{Binding RecordFullLoopCommand}"
                                            Padding="14,12"
                                            HorizontalAlignment="Stretch"
                                            Background="#F0B868"
                                            Foreground="#111315"/>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <Button Content="Track 1 Drums"
                                                Command="{Binding RecordDrumsLayerCommand}"
                                                Padding="12,11"
                                                Background="#57DAE2"
                                                Foreground="#07110D"/>
                                        <Button Grid.Column="1"
                                                Content="Track 2 Guitar"
                                                Command="{Binding RecordGuitarLayerCommand}"
                                                Padding="12,11"
                                                Background="#57DAE2"
                                                Foreground="#07110D"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <Button Content="Track 3 Piano"
                                                Command="{Binding RecordPianoLayerCommand}"
                                                Padding="12,11"
                                                Background="#57DAE2"
                                                Foreground="#07110D"/>
                                        <Button Grid.Column="1"
                                                Content="Track 4 Vocal"
                                                Command="{Binding RecordVocalLayerCommand}"
                                                Padding="12,11"
                                                Background="#57DAE2"
                                                Foreground="#07110D"/>
                                    </Grid>
                                    <Button Content="Track 5 Extra / Texture"
                                            Command="{Binding RecordExtraLayerCommand}"
                                            Padding="12,11"
                                            HorizontalAlignment="Stretch"
                                            Background="#A484FF"
                                            Foreground="#0B0912"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border CornerRadius="28" Background="#D9111315" BorderBrush="#24F4EBDA" BorderThickness="1" Padding="22">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                            <StackPanel>
                                <TextBlock Text="3. PRIVATE ASSISTANT"
                                           FontSize="11"
                                           FontWeight="Black"
                                           Foreground="#A484FF"
                                           LetterSpacing="2.4"/>
                                <TextBlock Text="{Binding AssistantBrief}"
                                           Margin="0,7,0,0"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           Foreground="#CFC4B3"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1"
                                       Text="{Binding CommandHelp}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Foreground="#CFC4B3"/>
                                    <TextBox Grid.Row="2"
                                     Text="{Binding ChatText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="drums punch, vocal polish, add reverb..."
                                     TextWrapping="Wrap"
                                     MinHeight="48"
                                     Background="#F4EBDA"
                                     Foreground="#111315"/>
                            <Button Grid.Row="3"
                                    Content="Run command"
                                    Command="{Binding RunChatCommandCommand}"
                                    Padding="18,12"
                                    HorizontalAlignment="Stretch"
                                    Background="#A484FF"
                                    Foreground="#0B0912"/>
                            <Border Grid.Row="4" CornerRadius="16" Background="#18A484FF" Padding="13">
                                <StackPanel>
                                    <TextBlock Text="COMMAND RESULT"
                                               FontSize="10"
                                               FontWeight="Black"
                                               LetterSpacing="2"
                                               Foreground="#A484FF"/>
                                    <TextBlock Text="{Binding CommandResult}"
                                               Margin="0,5,0,0"
                                               FontSize="12"
                                               FontWeight="Black"
                                               TextWrapping="Wrap"
                                               Foreground="#F4EBDA"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="5" CornerRadius="16" Background="#1257DAE2" Padding="13">
                                <StackPanel>
                                    <TextBlock Text="RECENT INSTRUCTIONS"
                                               FontSize="10"
                                               FontWeight="Black"
                                               LetterSpacing="2"
                                               Foreground="#57DAE2"/>
                                    <TextBlock Text="{Binding CommandHistory}"
                                               Margin="0,5,0,0"
                                               MaxHeight="86"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"
                                               Foreground="#CFC4B3"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>

                <Border Grid.Column="1" CornerRadius="28" Background="#B80D0F10" BorderBrush="#22F4EBDA" BorderThickness="1" Padding="20">
                    <Grid RowDefinitions="Auto,Auto,1.2*,Auto,Auto,Auto,Auto,Auto" RowSpacing="14">
                        <TextBlock Text="VERSIONS"
                                   FontSize="11"
                                   FontWeight="Black"
                                   Foreground="#F0B868"
                                   LetterSpacing="2.4"/>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding VersionListHint}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   Foreground="#CFC4B3"/>
                        <ListBox Grid.Row="2"
                                 ItemsSource="{Binding Versions}"
                                 SelectedItem="{Binding SelectedVersion}"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="svc:RecorderVersionFile">
                                    <Border CornerRadius="18" Background="#14F4EBDA" Padding="14" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Black" TextWrapping="Wrap" Foreground="#F4EBDA"/>
                                            <TextBlock Text="{Binding Size}" Margin="0,5,0,0" FontSize="11" FontWeight="Bold" Foreground="#57DAE2"/>
                                            <TextBlock Text="{Binding Modified}" FontSize="11" Foreground="#CFC4B3"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Grid.Row="3"
                                Content="Open folder"
                                Command="{Binding OpenFolderCommand}"
                                Padding="18,12"
                                HorizontalAlignment="Stretch"
                                Background="#F4EBDA"
                                Foreground="#111315"/>
                        <Border Grid.Row="4" CornerRadius="20" Background="#111315" BorderBrush="#3057DAE2" BorderThickness="1" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="LAYER DECK"
                                           FontSize="11"
                                           FontWeight="Black"
                                           Foreground="#57DAE2"
                                           LetterSpacing="2.4"/>
                                <TextBlock Text="{Binding LayerDeckSummary}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           Foreground="#CFC4B3"/>
                                <ItemsControl ItemsSource="{Binding LayerSlots}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LayerSlotItem">
                                            <Border CornerRadius="14" Background="#12F4EBDA" Padding="10" Margin="0,0,0,8">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="{Binding Number}"
                                                               FontSize="12"
                                                               FontWeight="Black"
                                                               Foreground="#F0B868"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="12"
                                                                   FontWeight="Black"
                                                                   Foreground="#F4EBDA"/>
                                                        <TextBlock Text="{Binding FileName}"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="#CFC4B3"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Status}"
                                                               FontSize="10"
                                                               FontWeight="Black"
                                                               Foreground="#57DAE2"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Grid Grid.Row="5" ColumnDefinitions="*,*" ColumnSpacing="13">
                            <Button Content="Assign take"
                                    Command="{Binding AssignSelectedToNextLayerCommand}"
                                    Padding="14,12"
                                    Background="#57DAE2"
                                    Foreground="#07110D"/>
                            <Button Grid.Column="1"
                                    Content="Clear deck"
                                    Command="{Binding ClearLayerDeckCommand}"
                                    Padding="14,12"
                                    Background="#24111315"
                                    Foreground="#CFC4B3"/>
                        </Grid>
                        <Button Grid.Row="6"
                                    Content="Export mix"
                                    Command="{Binding ExportLayerMixCommand}"
                                    Padding="14,12"
                                    HorizontalAlignment="Stretch"
                                    Background="#F0B868"
                                    Foreground="#111315"/>
                        <Border Grid.Row="7" CornerRadius="20" Background="#111315" BorderBrush="#24A484FF" BorderThickness="1" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="EXPORT PLANNING"
                                           FontSize="11"
                                           FontWeight="Black"
                                           Foreground="#A484FF"
                                           LetterSpacing="2.4"/>
                                <TextBlock Text="{Binding ExportPlanningSignal}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           Foreground="#CFC4B3"/>
                                <Border CornerRadius="14" Background="#12F4EBDA" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="LAST MIX"
                                                   FontSize="10"
                                                   FontWeight="Black"
                                                   LetterSpacing="2"
                                                   Foreground="#F4EBDA"/>
                                        <TextBlock Text="{Binding LastExportedMixLabel}"
                                                   Margin="0,4,0,0"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap"
                                                   Foreground="#CFC4B3"/>
                                    </StackPanel>
                                </Border>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <Border CornerRadius="14" Background="#10F0B868" Padding="10">
                                        <TextBlock Text="DJ-ready clip"
                                                   FontSize="11"
                                                   FontWeight="Black"
                                                   Foreground="#F0B868"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                    <Border Grid.Column="1" CornerRadius="14" Background="#1057DAE2" Padding="10">
                                        <TextBlock Text="Visual-ready mix"
                                                   FontSize="11"
                                                   FontWeight="Black"
                                                   Foreground="#57DAE2"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                </Grid>
                                <Button Content="Open last mix"
                                        Command="{Binding OpenExportedMixCommand}"
                                        Padding="14,12"
                                        HorizontalAlignment="Stretch"
                                        Background="#A484FF"
                                        Foreground="#0B0912"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3" CornerRadius="18" Background="#14F4EBDA" Padding="14">
                <TextBlock Text="{Binding Status}"
                           FontSize="13"
                           FontWeight="Black"
                           TextWrapping="Wrap"
                           Foreground="#F4EBDA"/>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
