                        <Border Width="10"
                                Height="{Binding}"
                                CornerRadius="999"
                                VerticalAlignment="Bottom"
                                Margin="5,0"
                                Background="#7AFFD2B8"
                                BorderBrush="#4AE1786E"
                                BorderThickness="1">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleY="1.8"/>
                            </Border.RenderTransform>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding ChromeVisible}">
            <StackPanel Margin="18" Spacing="14" MaxWidth="980" HorizontalAlignment="Center">
                <Border CornerRadius="34"
                        Padding="14"
                        BorderBrush="#A064C7B6"
                        BorderThickness="1"
                        ClipToBounds="True"
                        BoxShadow="0 30 70 0 #AA000000, inset 0 0 50 0 #2310EFFF">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#C6060A12" Offset="0"/>
                            <GradientStop Color="#A9082230" Offset="0.44"/>
                            <GradientStop Color="#96320F0B" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="9">
                        <Path Grid.RowSpan="3"
                              Data="M 0 50 C 90 20, 160 78, 250 45 S 420 24, 560 64 S 780 35, 960 58"
                              Stroke="#8064C7B6"
                              StrokeThickness="1.6"
                              Stretch="Fill"
                              IsHitTestVisible="False"/>
                        <Path Grid.RowSpan="3"
                              Data="M 0 112 C 110 85, 190 150, 310 102 S 510 95, 690 132 S 850 105, 980 126"
                              Stroke="#6CFF7A4F"
                              StrokeThickness="1.2"
                              Stretch="Fill"
                              IsHitTestVisible="False"/>
                        <Path Grid.RowSpan="3"
                              Data="M 70 18 L 140 4 L 210 34 L 238 96 L 194 142 L 118 132 L 58 76 Z"
                              Fill="#1010EFFF"
                              Stroke="#7080F7FF"
                              StrokeThickness="1.1"
                              Stretch="None"
                              IsHitTestVisible="False"/>
                        <Path Grid.RowSpan="3"
                              Data="M 735 22 C 812 -10, 930 18, 982 78 C 916 90, 842 124, 770 174 C 774 116, 762 66, 735 22 Z"
                              Fill="#1552FF9A"
                              Stroke="#7A85FFCA"
                              StrokeThickness="1.1"
                              Stretch="None"
                              IsHitTestVisible="False"/>

                        <Grid Grid.RowSpan="3"
                              Width="202"
                              Height="202"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0,-34,24,0"
                              Opacity="{Binding RecordSpinOpacity}"
                              RenderTransformOrigin="0.5,0.5"
                              IsHitTestVisible="False">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform Angle="{Binding RecordSpinAngle}"/>
                                    <ScaleTransform ScaleX="{Binding RecordSpinScale}"
                                                    ScaleY="{Binding RecordSpinScale}"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Ellipse Fill="#0F03050A"
                                     Stroke="#D0F8EFE0"
                                     StrokeThickness="1.4"/>
                            <Ellipse Width="174"
                                     Height="174"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="#22080A12"
                                     Stroke="#8C64C7B6"
                                     StrokeThickness="1"/>
                            <Ellipse Width="138"
                                     Height="138"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="#0803060C"
                                     Stroke="#44F8EFE0"
                                     StrokeThickness="1"/>
                            <Ellipse Width="106"
                                     Height="106"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="#1808060C"
                                     Stroke="#66E1786E"
                                     StrokeThickness="1"/>
                            <Ellipse Width="62"
                                     Height="62"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="#C8F8EFE0"
                                     Stroke="#FFE9B06E"
                                     StrokeThickness="2"/>
                            <Ellipse Width="13"
                                     Height="13"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="#06070C"/>
                            <Rectangle Width="6"
                                       Height="84"
                                       RadiusX="999"
                                       RadiusY="999"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top"
                                       Margin="0,14,0,0"
                                       Fill="#F8F8EFE0"/>
                            <Rectangle Width="2"
                                       Height="92"
                                       RadiusX="999"
                                       RadiusY="999"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top"
                                       Margin="0,8,0,0"
                                       Fill="#FF64C7B6"/>
                            <Path Data="M 22 100 C 58 84, 100 84, 140 100 S 180 116, 200 100"
                                  Stroke="#CC64C7B6"
                                  StrokeThickness="2.4"
                                  StrokeLineCap="Round"
                                  Stretch="Fill"/>
                            <Path Data="M 100 6 L 116 76 L 100 100 L 84 76 Z"
                                  Fill="#96E1786E"
                                  Stretch="Fill"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                            <StackPanel>
                                <TextBlock Text="GateKPT Music OS"
                                           IsVisible="{Binding !IsRecording}"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           LetterSpacing="0.4"
                                           Foreground="#F8EFE0"/>
                                <TextBlock Text="{Binding RecordingGuardLabel}"
                                           IsVisible="{Binding IsRecording}"
                                           FontSize="26"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="#F8EFE0"/>
                                <TextBlock Text="{Binding CaptureInstruction}"
                                           IsVisible="{Binding IsRecording}"
                                           Margin="0,2,0,0"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="#8CD6D8"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    IsVisible="{Binding HasVisibleSignal}"
                                    CornerRadius="24"
                                    MinWidth="122"
                                    Padding="16,12"
                                    Background="#06070C"
                                    BorderBrush="#B064C7B6"
                                    BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PeakDecibelLabel}"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Foreground="#D6FFFF"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="1"
                                IsVisible="False"
                                CornerRadius="21"
                                Padding="8"
                                Background="#E61B1717"
                                BorderBrush="#4DDDA36B"
                                BorderThickness="1"
                                MinHeight="58"
                                MaxHeight="66">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="13">
                                <ItemsControl
                                              ItemsSource="{Binding SignalBars}"
                                              VerticalAlignment="Stretch"
                                              HorizontalAlignment="Stretch">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="8"
                                                    Height="{Binding}"
                                                    CornerRadius="999"
                                                    VerticalAlignment="Center"
                                                    Margin="2,0"
                                                    Background="#E1786E"
                                                    BorderBrush="#5264C7B6"
                                                    BorderThickness="1"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SimpleSignalLabel}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           LetterSpacing="1.5"
                                           VerticalAlignment="Center"
                                           Foreground="#64C7B6"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1"
                              IsHitTestVisible="False">
                            <Border IsVisible="{Binding IsBusy}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    CornerRadius="999"
                                    Padding="13,8"
                                    Background="#E61C1309"
                                    BorderBrush="#8064C7B6"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ProgressBar IsIndeterminate="True"
                                                 Width="42"
                                                 Height="6"
                                                 Background="#2A211A"
                                                 Foreground="#E1786E"/>
                                    <TextBlock Text="{Binding BusyLabel}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#E8E1D2"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="1"
                                CornerRadius="999"
                                Padding="10"
                                HorizontalAlignment="Center"
                                Background="#B4080A10"
                                BorderBrush="#A064C7B6"
                                BorderThickness="1"
                                BoxShadow="0 22 0 0 #3410EFFF, 0 34 70 0 #AA000000, inset 0 0 34 0 #1829D8FF"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <SkewTransform AngleX="-5" AngleY="0"/>
                            </Border.RenderTransform>
                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                  ColumnSpacing="10"
                                  HorizontalAlignment="Center">
                            <Button
                                    Command="{Binding StartRecordingCommand}"
                                    IsVisible="{Binding CanStartRecording}"
                                    Content="CAPTURE"
                                    ToolTip.Tip="Capture one take"
                                    Padding="20,13"
                                    MinWidth="116"
                                    MinHeight="50"
                                    Margin="0"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    LetterSpacing="1.4"
                                    BorderThickness="1"
                                    BorderBrush="#B0FFF3D6"
                                    Background="#080A12"
                                    Foreground="#F7EBD7"/>
                            <Button
                                    Command="{Binding StopRecordingCommand}"
                                    IsVisible="{Binding CanStopRecording}"
                                    Content="SAVE"
                                    ToolTip.Tip="Save this take"
                                    Padding="20,13"
                                    MinWidth="116"
                                    MinHeight="50"
                                    Margin="0"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    LetterSpacing="1.4"
                                    BorderThickness="1"
                                    BorderBrush="#D8FFD0A8"
                                    Background="#FF6C3E"
                                    Foreground="#080A12"/>
                            <Button Grid.Column="1"
                                    Content="▶"
                                    ToolTip.Tip="Play latest"
                                    Command="{Binding PlaySelectedCommand}"
                                    Padding="18,12"
                                    MinWidth="92"
                                    MinHeight="50"
                                    Margin="0"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    LetterSpacing="1"
                                    BorderBrush="#A0F4E6CF"
                                    BorderThickness="1"
                                    Background="#FFF4E6CF"
                                    Foreground="#120918"/>
                            <Button Grid.Column="2"
                                    Content="1 WAV"
                                    ToolTip.Tip="Combine this session into one WAV"
                                    Command="{Binding MixSessionTakesCommand}"
                                    Padding="18,12"
                                    MinWidth="92"
                                    MinHeight="50"
                                    Margin="0"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    LetterSpacing="1"
                                    BorderBrush="#C8D6FFFF"
                                    BorderThickness="1"
                                    Background="#64C7B6"
                                    Foreground="#120918"/>
                            <Button Grid.Column="3"
                                    Content="FILES"
                                    ToolTip.Tip="Open folder"
                                    Command="{Binding OpenFolderCommand}"
                                    Padding="18,12"
                                    MinWidth="102"
                                    MinHeight="50"
                                    Margin="0"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    LetterSpacing="1"
                                    BorderBrush="#9864C7B6"
                                    BorderThickness="1"
                                    Background="#2B120D"
                                    Foreground="#F7EBD7"/>
                            <Button Grid.Column="4"
                                    Content="INPUT"
                                    ToolTip.Tip="Pick Scarlett / RC-505 input"
                                    Command="{Binding FindScarlettCommand}"
                                    Padding="18,12"
                                    MinWidth="102"
                                    MinHeight="50"
                                    Margin="0"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    LetterSpacing="1"
                                    BorderBrush="#B0D6FFFF"
                                    BorderThickness="1"
                                    Background="#102432"
                                    Foreground="#D6FFFF"/>
                            <TextBox Grid.Column="5"
                                     IsVisible="False"
                                     Text="{Binding SessionName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Session 1"
                                     MinHeight="40"/>
                            <ComboBox Grid.Column="6"
                                      IsVisible="False"
                                      ItemsSource="{Binding InputDevices}"
                                      SelectedItem="{Binding SelectedInputDevice}"
                                      MinHeight="40"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2"
                                CornerRadius="18"
                                Padding="12,9"
                                Background="#4406070C"
                                BorderBrush="#4064C7B6"
                                BorderThickness="1">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Status}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       MaxLines="2"
                                       Foreground="#E8E1D2"/>
                            <TextBlock Text="{Binding SignalProbeSummary}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       MaxLines="1"
                                       Foreground="#8CD6D8"/>
                            <TextBlock Text="{Binding HarvestStatus}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       MaxLines="1"
                                       Foreground="#D6FFFF"/>
                            <TextBlock Text="{Binding LastRecorderDiagnostic}"
                                       IsVisible="False"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       MaxLines="1"
                                       Foreground="#A88B62"/>
                        </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border CornerRadius="24"
                        Padding="14"
                        BorderBrush="#A8D6FFFF"
                        BorderThickness="1"
                        Background="#A006080E"
                        BoxShadow="0 24 48 0 #88000000, inset 0 0 34 0 #1228A7FF">
                    <StackPanel Spacing="9">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding ChatText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Ask GateKPT..."
                                     MinHeight="42"/>
                            <Button Grid.Column="1"
                                     Content=">"
                                     Command="{Binding RunChatCommandCommand}"
                                     Padding="16,10"
                                     MinWidth="58"
                                     Background="#D6FFFF"
                                     Foreground="#120918"/>
                        </Grid>
                        <TextBlock Text="{Binding CommandResult}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="#E8E1D2"/>
                        <Border CornerRadius="20"
                                Padding="12"
                                BorderBrush="#66D6FFFF"
                                BorderThickness="1"
                                Background="#8A070A0E"
                                BoxShadow="0 18 36 0 #66000000, inset 0 0 22 0 #1428A7FF">
                            <Grid ColumnDefinitions="*" ColumnSpacing="10">
                                <Ellipse Width="260"
                                         Height="86"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Margin="16,0,0,0"
                                         Fill="#0E28A7FF"
                                         IsHitTestVisible="False"/>
                                <Ellipse Width="220"
                                         Height="82"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Fill="#0EFF6C3E"
                                         IsHitTestVisible="False"/>
                                <Ellipse Width="200"
                                         Height="94"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"
                                         Margin="0,0,34,0"
                                         Fill="#0E52FF9A"
                                         IsHitTestVisible="False"/>
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Command="{Binding StageRawCleanCommand}" Width="128" Height="48" Padding="0" Margin="0,0,10,0" Background="Transparent" BorderThickness="0" ToolTip.Tip="Clean/raw take">
                                        <Border CornerRadius="16" BorderBrush="#88F2EEE3" BorderThickness="1.2" BoxShadow="0 10 22 0 #66000000, inset 0 0 18 0 #30F8EFE0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                    <GradientStop Color="#050507" Offset="0"/>
                                                    <GradientStop Color="#E8E1D2" Offset="0.34"/>
                                                    <GradientStop Color="#6B6258" Offset="0.62"/>
                                                    <GradientStop Color="#080A12" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid>
                                                <Ellipse Width="28" Height="28" HorizontalAlignment="Left" Margin="14,0,0,0" Fill="#B0F8EFE0"/>
                                                <Path Data="M 50 25 L 114 25" Stroke="#B0080A12" StrokeThickness="2.2"/>
                                                <Path Data="M 52 18 L 80 18 M 84 32 L 112 32" Stroke="#75F8EFE0" StrokeThickness="1.1"/>
                                            </Grid>
                                        </Border>
                                    </Button>
                                    <Button Command="{Binding StageLateNightChromeCommand}" Width="128" Height="48" Padding="0" Margin="0,0,10,0" Background="Transparent" BorderThickness="0" ToolTip.Tip="Chrome/gloss">
                                        <Border CornerRadius="16" BorderBrush="#B8D6FFFF" BorderThickness="1.2" BoxShadow="0 10 22 0 #66000000, inset 0 0 22 0 #5028A7FF">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                    <GradientStop Color="#080A12" Offset="0"/>
                                                    <GradientStop Color="#F8EFE0" Offset="0.2"/>
                                                    <GradientStop Color="#6DEBFF" Offset="0.44"/>
                                                    <GradientStop Color="#F8EFE0" Offset="0.62"/>
                                                    <GradientStop Color="#122D5D" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid>
                                                <Path Data="M 12 32 C 36 8, 74 42, 118 12" Stroke="#CC080A12" StrokeThickness="1.6"/>
                                                <Path Data="M 14 16 L 52 16 M 72 35 L 116 35" Stroke="#B8D6FFFF" StrokeThickness="1.2"/>
                                                <Ellipse Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#78D6FFFF"/>
                                            </Grid>
                                        </Border>
                                    </Button>
                                    <Button Command="{Binding StageRobotVocoderCommand}" Width="128" Height="48" Padding="0" Margin="0,0,10,0" Background="Transparent" BorderThickness="0" ToolTip.Tip="Robot/vocoder">
                                        <Border CornerRadius="16" BorderBrush="#D8FFF0C8" BorderThickness="1.2" BoxShadow="0 10 22 0 #66000000, inset 0 0 26 0 #7080F7FF">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                    <GradientStop Color="#030407" Offset="0"/>
                                                    <GradientStop Color="#132B38" Offset="0.24"/>
                                                    <GradientStop Color="#D6FFFF" Offset="0.48"/>
                                                    <GradientStop Color="#7B53FF" Offset="0.7"/>
                                                    <GradientStop Color="#080A12" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid>
                                                <Path Data="M 18 32 L 31 18 L 45 32 L 59 18 L 73 32 L 87 18 L 101 32 L 116 18"
                                                      Stroke="#F8EFE0"
                                                      StrokeThickness="1.6"/>
                                                <Path Data="M 18 16 L 116 16 M 18 36 L 116 36"
                                                      Stroke="#7064C7B6"
                                                      StrokeThickness="1"/>
                                                <Ellipse Width="24" Height="24" HorizontalAlignment="Center" Fill="#70D6FFFF"/>
                                            </Grid>
                                        </Border>
                                    </Button>
                                    <Button Command="{Binding QuickWarmerCommand}" Width="128" Height="48" Padding="0" Margin="0,0,10,0" Background="Transparent" BorderThickness="0" ToolTip.Tip="Warm/fire">
                                        <Border CornerRadius="16" BorderBrush="#CCFFBFA9" BorderThickness="1.2" BoxShadow="0 10 22 0 #66000000, inset 0 0 24 0 #55FF6C3E">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0%,100%" EndPoint="100%,0%">
                                                    <GradientStop Color="#120407" Offset="0"/>
                                                    <GradientStop Color="#B21A11" Offset="0.28"/>
                                                    <GradientStop Color="#FF6C3E" Offset="0.58"/>
                                                    <GradientStop Color="#FFD17A" Offset="0.82"/>
                                                    <GradientStop Color="#2A0808" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid>
                                                <Path Data="M 20 38 C 28 18, 38 28, 44 12 C 54 32, 68 20, 74 36 C 84 12, 102 24, 110 36"
                                                      Stroke="#F8EFE0" StrokeThickness="1.5"/>
                                                <Path Data="M 15 38 C 34 28, 56 44, 77 31 S 104 26, 120 34" Stroke="#80FFD17A" StrokeThickness="1"/>
                                            </Grid>
                                        </Border>
                                    </Button>
                                    <Button Command="{Binding QuickReverbCommand}" Width="128" Height="48" Padding="0" Margin="0,0,10,0" Background="Transparent" BorderThickness="0" ToolTip.Tip="Room/space">
                                        <Border CornerRadius="16" BorderBrush="#A8D6FFFF" BorderThickness="1.2" BoxShadow="0 10 22 0 #66000000, inset 0 0 22 0 #334CFF9D">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                    <GradientStop Color="#031A21" Offset="0"/>
                                                    <GradientStop Color="#064D52" Offset="0.42"/>
                                                    <GradientStop Color="#64C7B6" Offset="0.68"/>
                                                    <GradientStop Color="#080A12" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid>
                                                <Path Data="M 14 30 C 32 8, 96 8, 116 30" Stroke="#D6FFFF" StrokeThickness="1.35"/>
                                                <Path Data="M 30 36 C 46 22, 80 22, 98 36" Stroke="#A8F8EFE0" StrokeThickness="1.05"/>
                                                <Path Data="M 12 16 C 40 28, 84 2, 118 18" Stroke="#7064C7B6" StrokeThickness="1"/>
                                            </Grid>
                                        </Border>
                                    </Button>
                                    <Button Command="{Binding QuickLouderCommand}" Width="128" Height="48" Padding="0" Margin="0,0,10,0" Background="Transparent" BorderThickness="0" ToolTip.Tip="Lift/loud">
                                        <Border CornerRadius="16" BorderBrush="#C8F6D28A" BorderThickness="1.2" BoxShadow="0 10 22 0 #66000000, inset 0 0 24 0 #38F6D28A">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0%,100%" EndPoint="100%,0%">
                                                    <GradientStop Color="#05070B" Offset="0"/>
                                                    <GradientStop Color="#123338" Offset="0.38"/>
                                                    <GradientStop Color="#D99B55" Offset="0.72"/>
                                                    <GradientStop Color="#FFE2A4" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid>
                                                <Ellipse Width="78" Height="32" HorizontalAlignment="Right" Margin="0,0,12,0" Fill="#34F8EFE0"/>
                                                <Ellipse Width="38" Height="38" HorizontalAlignment="Center" Fill="#44D6FFFF"/>
                                                <Ellipse Width="18" Height="18" HorizontalAlignment="Left" Margin="20,0,0,0" Fill="#B8F6D28A"/>
                                            </Grid>
                                        </Border>
                                    </Button>
                                    <Button Command="{Binding QuickDeleteCommand}" Width="54" Height="48" Padding="0" Margin="0" Background="Transparent" BorderThickness="0" ToolTip.Tip="Delete last">
                                        <Border Background="Transparent" BorderThickness="0">
                                            <Grid Width="54" Height="48">
                                                <Path Data="M 20 17 L 34 31 M 34 17 L 20 31"
                                                      Stroke="#FFF4E6CF"
                                                      StrokeThickness="2.35"
                                                      StrokeLineCap="Round"/>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </WrapPanel>
                            </Grid>
                        </Border>
                        <StackPanel IsVisible="{Binding IsCommandBusy}" Spacing="6">
                            <TextBlock Text="Working..."
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1.8"
                                       Foreground="#DDA36B"/>
                            <ProgressBar IsIndeterminate="True"
                                         Height="6"
                                         Background="#2A211A"
                                         Foreground="#F2C56B"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border CornerRadius="28"
                        Padding="0"
                        BorderBrush="#80D6FFFF"
                        BorderThickness="1"
                        Background="#6A06080E"
                        ClipToBounds="True"
                        BoxShadow="0 30 60 0 #99000000, inset 0 0 34 0 #1010EFFF">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="0">
                        <Border Padding="14"
                                Background="#4C0B1017">
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                                <Ellipse Grid.RowSpan="2"
                                         Width="320"
                                         Height="120"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Margin="-90,0,0,0"
                                         Fill="#1228A7FF"
                                         IsHitTestVisible="False"/>
                                <Ellipse Grid.RowSpan="2"
                                         Width="360"
                                         Height="130"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"
                                         Margin="0,0,-110,0"
                                         Fill="#14FF6C3E"
                                         IsHitTestVisible="False"/>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="13">
                                    <TextBlock Text="TAKES"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               LetterSpacing="2.2"
                                               Foreground="#F8EFE0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SelectedTakeMixLabel}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Foreground="#80F7FF"/>
                                </Grid>
                                <ScrollViewer Grid.Row="1"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto"
                                              MaxHeight="108">
                                    <ListBox Classes="take-list"
                                             ItemsSource="{Binding Versions}"
                                             SelectedItem="{Binding SelectedVersion}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="svc:RecorderVersionFile">
                                                <Border Classes="take-row"
                                                        CornerRadius="18"
                                                        Padding="12,10"
                                                        Margin="0,0,0,7"
                                                        Background="#38102432"
                                                        BorderBrush="#78D6FFFF"
                                                        BorderThickness="1">
                                                    <Grid ColumnDefinitions="*" ColumnSpacing="10">
                                                        <Border CornerRadius="16"
                                                                Background="#300C3E62"
                                                                BorderBrush="#55D6FFFF"
                                                                BorderThickness="1"
                                                                IsHitTestVisible="False"/>
                                                        <Ellipse Width="190"
                                                                 Height="48"
                                                                 HorizontalAlignment="Left"
                                                                 Margin="-40,0,0,0"
                                                                 Fill="#2432A8FF"
                                                                 IsHitTestVisible="False"/>
                                                        <Ellipse Width="240"
                                                                 Height="52"
                                                                 HorizontalAlignment="Right"
                                                                 Margin="0,0,-70,0"
                                                                 Fill="#1AFF6C3E"
                                                                 IsHitTestVisible="False"/>
                                                        <Border Width="110"
                                                                Height="26"
                                                                CornerRadius="999"
                                                                HorizontalAlignment="Center"
                                                                Background="#12F8EFE0"
                                                                IsHitTestVisible="False"/>
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       TextWrapping="Wrap"/>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding DisplayMeta}"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#7FCAD1"/>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border CornerRadius="28"
                        Padding="16"
                        BorderBrush="#80D6FFFF"
                        BorderThickness="1"
                        Background="#6606080E"
                        ClipToBounds="True"
                        BoxShadow="0 28 62 0 #88000000, inset 0 0 34 0 #1010EFFF">
                    <Grid ColumnDefinitions="1.08*,0.92*" ColumnSpacing="14">
                        <Border CornerRadius="22"
                                Padding="14"
                                Background="#4406070C"
                                BorderBrush="#70D6FFFF"
                                BorderThickness="1"
                                MinHeight="150">
                            <Grid>
                                <Path Data="M 36 26 L 106 10 L 176 42 L 202 104 L 154 142 L 82 126 L 24 72 Z"
                                      Fill="#0610EFFF"
                                      Stroke="#4CD6FFFF"
                                      StrokeThickness="1.1"
                                      Stretch="None"
                                      IsHitTestVisible="False"/>
                                <Path Data="M 520 14 C 600 -20, 734 14, 786 84 C 700 94, 622 132, 542 190 C 548 120, 542 64, 520 14 Z"
                                      Fill="#0A52FF9A"
                                      Stroke="#48A8FFDC"
                                      StrokeThickness="1"
                                      Stretch="None"
                                      IsHitTestVisible="False"/>
                                <Path Data="M -20 84 C 72 22, 142 130, 245 70 S 438 20, 620 98 S 782 50, 940 84"
                                      Stroke="#88FF6C3E"
                                      StrokeThickness="2"
                                      Stretch="Fill"
                                      IsHitTestVisible="False"/>
                                <Path Data="M -20 112 C 90 42, 190 150, 312 96 S 528 74, 724 128 S 838 88, 960 122"
                                      Stroke="#68D6FFFF"
                                      StrokeThickness="1.5"
                                      Stretch="Fill"
                                      IsHitTestVisible="False"/>
                                <Path Data="M 20 28 C 130 84, 232 10, 358 50 S 560 106, 760 36"
                                      Stroke="#40F8EFE0"
                                      StrokeThickness="1.05"
                                      Stretch="Fill"
                                      IsHitTestVisible="False"/>
                                <ItemsControl ItemsSource="{Binding SignalBars}"
                                              IsVisible="False"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              Margin="-12,0,-12,0"
                                              Opacity="0.52"
                                              IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="9"
                                                    Height="{Binding}"
                                                    CornerRadius="999"
                                                    Margin="3,0"
                                                    VerticalAlignment="Center"
                                                    Background="#5CFF6C3E"
                                                    BorderBrush="#60D6FFFF"
                                                    BorderThickness="1">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleY="4.2"/>
                                                </Border.RenderTransform>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid VerticalAlignment="Bottom"
                                      ColumnDefinitions="*,Auto"
                                      ColumnSpacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="FRAME"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   LetterSpacing="2.4"
                                                   Foreground="#F8EFE0"/>
                                        <TextBlock Text="screen / face / sound"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F8EFE0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding VideoSyncLabel}"
                                               VerticalAlignment="Bottom"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#80F7FF"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1"
                                CornerRadius="22"
                                Padding="14"
                                Background="#5A10080A"
                                BorderBrush="#80D6FFFF"
                                BorderThickness="1"
                                MinWidth="320"
                                BoxShadow="0 14 0 0 #1810EFFF, 0 28 52 0 #88000000, inset 0 0 28 0 #1010EFFF"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <SkewTransform AngleX="4" AngleY="0"/>
                            </Border.RenderTransform>
                            <Grid RowDefinitions="*,Auto" RowSpacing="10">
                                <Border CornerRadius="18"
                                        Background="#3E111C24"
                                        BorderBrush="#70D6FFFF"
                                        BorderThickness="1"
                                        BoxShadow="inset 0 0 30 0 #44000000, 0 10 24 0 #66000000">
                                    <Grid>
                                        <Ellipse Width="120"
                                                 Height="120"
                                                 Fill="#1228A7FF"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Top"
                                                 Margin="0,-45,-28,0"/>
                                        <Path Data="M 10 86 C 45 30, 90 122, 132 70 S 218 36, 252 92"
                                              Stroke="#8CFF6C3E"
                                              StrokeThickness="2"
                                              Stretch="Fill"/>
                                        <Path Data="M 20 42 C 70 8, 126 88, 184 38 S 224 20, 250 58"
                                              Stroke="#60D6FFFF"
                                              StrokeThickness="1.1"
                                              Stretch="Fill"/>
                                        <TextBlock Text="◉"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="34"
                                                   FontWeight="SemiBold"
                                                   LetterSpacing="2"
                                                   Foreground="#80F7FF"/>
                                    </Grid>
                                </Border>
                                <WrapPanel Grid.Row="1"
                                           Orientation="Horizontal"
                                           HorizontalAlignment="Right">
                                    <Button Content="◉"
                                            ToolTip.Tip="Open camera"
                                            Command="{Binding OpenCameraCommand}"
                                            Padding="14,9"
                                            MinWidth="58"
                                            Margin="0,0,8,0"
                                            FontSize="17"
                                            Background="#080A12"
                                            Foreground="#F7EBD7"/>
                                    <Button Content="↔"
                                            ToolTip.Tip="Auto sync"
                                            Command="{Binding AutoSyncPostClipCommand}"
                                            Padding="14,9"
                                            MinWidth="58"
                                            Margin="0,0,8,0"
                                            FontSize="17"
                                            Background="#80F7FF"
                                            Foreground="#10080A"/>
                                    <Button Content="↑"
                                            ToolTip.Tip="Make post clip"
                                            Command="{Binding MakePostClipCommand}"
                                            Padding="14,9"
                                            MinWidth="58"
                                            FontSize="17"
                                            Background="#FF6C3E"
                                            Foreground="#10080A"/>
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border IsVisible="False"
                        CornerRadius="28"
                        Padding="18"
                        BorderBrush="#44DDA36B"
                        BorderThickness="1"
                        Background="#D90E1013">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="13">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="13">
                            <StackPanel Spacing="6">
                                <TextBlock Text="CONTENT PACK"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           LetterSpacing="2.2"
                                           Foreground="#DDA36B"/>
                                <TextBlock Text="One take -> one world -> one post."
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="#E8E1D2"/>
                                <TextBlock Text="{Binding ContentPackTakeLabel}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="#7FCAD1"/>
                            </StackPanel>
                            <WrapPanel Grid.Column="1"
                                       Orientation="Horizontal"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       MaxWidth="520">
                                <ComboBox ItemsSource="{Binding ContentPackWorlds}"
                                          SelectedItem="{Binding ContentPackWorld}"
                                          MinWidth="132"
                                          Margin="0,0,8,8"/>
                                <ComboBox ItemsSource="{Binding ContentPackClipTypes}"
                                          SelectedItem="{Binding ContentPackClipType}"
                                          MinWidth="132"
                                          Margin="0,0,8,8"/>
                                <Button Content="Generate"
                                        Command="{Binding GenerateContentPackCommand}"
                                        Padding="16,11"
                                        MinWidth="118"
                                        Margin="0,0,8,8"
                                        Background="#DDA36B"
                                        Foreground="#120918"/>
                                <Button Content="Packs"
                                        Command="{Binding OpenContentPackFolderCommand}"
                                        Padding="16,11"
                                        MinWidth="92"
                                        Margin="0,0,0,8"
                                        Background="#211815"
                                        Foreground="#E8E1D2"/>
                            </WrapPanel>
                        </Grid>
                        <StackPanel Grid.Row="1" Spacing="8">
                            <TextBlock Text="{Binding ContentPackSaveLabel}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="#7FCAD1"/>
                            <TextBox Text="{Binding ContentPackResult}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="116"
                                     Background="#FFF2E2C8"
                                     Foreground="#120918"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border IsVisible="False"
                        CornerRadius="28"
                        Padding="18"
                        BorderBrush="#33DDA36B"
                        BorderThickness="1"
                        Background="#CC090D13">
                    <StackPanel Spacing="13">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="13">
                            <StackPanel Spacing="6">
                                <TextBlock Text="TASTE MEMORY"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           LetterSpacing="2.2"
                                           Foreground="#DDA36B"/>
                                <TextBlock Text="{Binding TasteMemorySummary}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="#E8E1D2"/>
                                <TextBlock Text="{Binding TasteNextMove}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="#7FCAD1"/>
                            </StackPanel>
                            <WrapPanel Grid.Column="1"
                                       Orientation="Horizontal"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       MaxWidth="420">
                                <ComboBox ItemsSource="{Binding TasteRatings}"
                                          SelectedItem="{Binding TasteRating}"
                                          MinWidth="82"
                                          Margin="0,0,8,8"/>
                                <ComboBox ItemsSource="{Binding ContentPackWorlds}"
                                          SelectedItem="{Binding TasteMood}"
                                          MinWidth="124"
                                          Margin="0,0,8,8"/>
                                <Button Content="Save taste"
                                        Command="{Binding SaveTasteMemoryCommand}"
                                        Padding="16,11"
                                        MinWidth="122"
                                        Margin="0,0,8,8"
                                        Background="#DDA36B"
                                        Foreground="#120918"/>
                                <Button Content="Memory"
                                        Command="{Binding OpenTasteMemoryFolderCommand}"
                                        Padding="16,11"
                                        MinWidth="100"
                                        Margin="0,0,0,8"
                                        Background="#211815"
                                        Foreground="#E8E1D2"/>
                            </WrapPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="13">
                            <TextBox Text="{Binding TasteWorked}"
                                     PlaceholderText="What worked?"
                                     MinHeight="82"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding TasteOff}"
                                     PlaceholderText="What was off?"
                                     MinHeight="82"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"/>
                        </Grid>
                        <TextBlock Text="{Binding TasteMemoryStatus}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="#F2C56B"/>
                    </StackPanel>
                </Border>

                <Border IsVisible="False"
                        CornerRadius="28"
                        Padding="18"
                        BorderBrush="#446EE7FF"
                        BorderThickness="1"
                        Background="#CC07111F">
                    <StackPanel Spacing="13">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="13">
                            <StackPanel Spacing="6">
                                <TextBlock Text="LIVE ALBUM"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           LetterSpacing="2.2"
                                           Foreground="#7FCAD1"/>
                                <TextBlock Text="{Binding LiveAlbumEra}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="#E8E1D2"/>
                                <TextBlock Text="{Binding LiveAlbumPlan}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="#DDA36B"/>
                            </StackPanel>
                            <WrapPanel Grid.Column="1"
                                       Orientation="Horizontal"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       MaxWidth="420">
                                <ComboBox ItemsSource="{Binding LiveAlbumScenes}"
                                          SelectedItem="{Binding LiveAlbumScene}"
                                          MinWidth="164"
                                          Margin="0,0,8,8"/>
                                <Button Content="Save note"
                                        Command="{Binding SaveLiveAlbumNoteCommand}"
                                        Padding="16,11"
                                        MinWidth="118"
                                        Margin="0,0,8,8"
                                        Background="#7FCAD1"
                                        Foreground="#120918"/>
                                <Button Content="Folder"
                                        Command="{Binding OpenLiveAlbumFolderCommand}"
                                        Padding="16,11"
                                        MinWidth="92"
                                        Margin="0,0,0,8"
                                        Background="#211815"
                                        Foreground="#E8E1D2"/>
                            </WrapPanel>
                        </Grid>
                        <TextBox Text="{Binding LiveAlbumNote}"
                                 PlaceholderText="What is this session becoming?"
                                 MinHeight="82"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding LiveAlbumStatus}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="#F2C56B"/>
                    </StackPanel>
                </Border>

                <Border IsVisible="False"
                        CornerRadius="28"
                        Padding="18"
                        BorderBrush="#44DDA36B"
                        BorderThickness="1"
                        Background="#D90E1013">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="21">
                        <StackPanel Spacing="8">
                            <TextBlock Text="POST CLIP"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       LetterSpacing="2.2"
                                       Foreground="#DDA36B"/>
                            <TextBlock Text="{Binding VideoLayerTitle}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="#E8E1D2"/>
                            <TextBlock Text="{Binding VideoLayerDetail}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="#7FCAD1"/>
                            <TextBlock Text="{Binding VideoWorkflowStatus}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="#F2C56B"/>
                            <WrapPanel Orientation="Horizontal">
                                <Button Content="Audio earlier"
                                        Command="{Binding AudioEarlierCommand}"
                                        Padding="13,9"
                                        MinWidth="118"
                                        Margin="0,0,8,8"
                                        Background="#211815"
                                        Foreground="#E8E1D2"/>
                                <Border CornerRadius="999"
                                        Padding="13,9"
                                        Margin="0,0,8,8"
                                        BorderBrush="#44DDA36B"
                                        BorderThickness="1"
                                        Background="#99130F16">
                                    <TextBlock Text="{Binding VideoSyncLabel}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#7FCAD1"/>
                                </Border>
                                <Button Content="Audio later"
                                        Command="{Binding AudioLaterCommand}"
                                        Padding="13,9"
                                        MinWidth="108"
                                        Margin="0,0,8,8"
                                        Background="#211815"
                                        Foreground="#E8E1D2"/>
                                <Button Content="Reset"
                                        Command="{Binding ResetVideoSyncCommand}"
                                        Padding="13,9"
                                        MinWidth="76"
                                        Margin="0,0,8,8"
                                        Background="#99130F16"
                                        Foreground="#E8E1D2"/>
                                <Button Content="Auto sync"
                                        Command="{Binding AutoSyncPostClipCommand}"
                                        Padding="13,9"
                                        MinWidth="100"
                                        Margin="0,0,8,8"
                                        Background="#7FCAD1"
                                        Foreground="#120918"/>
                                <Button Content="{Binding VideoExportPresetLabel}"
                                        Command="{Binding ToggleVideoPresetCommand}"
                                        Padding="13,9"
                                        MinWidth="112"
                                        Margin="0,0,8,8"
                                        Background="#DDA36B"
                                        Foreground="#120918"/>
                            </WrapPanel>
                        </StackPanel>
                        <WrapPanel Grid.Column="1"
                                   Orientation="Horizontal"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   MaxWidth="360">
                            <Button Content="Find video"
                                    Command="{Binding FindLatestPhoneVideoCommand}"
                                    Padding="16,11"
                                    MinWidth="118"
                                    Margin="0,0,8,8"
                                    Background="#211815"
                                    Foreground="#E8E1D2"/>
                            <Button Content="Use take audio"
                                    Command="{Binding RenderPhoneVideoWithTakeCommand}"
                                    Padding="16,11"
                                    MinWidth="142"
                                    Margin="0,0,8,8"
                                    Background="#DDA36B"
                                    Foreground="#120918"/>
                            <Button Content="Make post clip"
                                    Command="{Binding MakePostClipCommand}"
                                    Padding="16,11"
                                    MinWidth="150"
                                    Margin="0,0,8,8"
                                    Background="#7FCAD1"
                                    Foreground="#120918"/>
                            <Button Content="Open clip"
                                    Command="{Binding OpenLatestPostClipCommand}"
                                    Padding="16,11"
                                    MinWidth="110"
                                    Margin="0,0,8,8"
                                    Background="#211815"
                                    Foreground="#E8E1D2"/>
                            <Button Content="Exports"
                                    Command="{Binding OpenVideoOutputFolderCommand}"
                                    Padding="16,11"
                                    MinWidth="96"
                                    Margin="0,0,8,8"
                                    Background="#F2EEE3"
                                    Foreground="#120918"/>
                        </WrapPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Unmistakable live badge: pulsing dot + timer. -->
        <Border IsVisible="{Binding IsRecording}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,18,0,0"
                CornerRadius="999"
                Padding="20,11"
                Background="#E61209"
                BorderBrush="#FFFF7A6E"
                BorderThickness="1.5"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="#FF2A1A" BlurRadius="34" Opacity="0.9"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Panel Width="46" Height="46" VerticalAlignment="Center">
                    <Ellipse Width="{Binding RecGlowSize}"
                             Height="{Binding RecGlowSize}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Fill="#FFFFFFFF"
                             Opacity="{Binding RecGlowOpacity}"/>
                    <Ellipse Width="{Binding RecDotSize}"
                             Height="{Binding RecDotSize}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Fill="#FFFFFFFF"/>
                </Panel>
                <TextBlock Text="LIVE"
                           FontSize="24"
                           FontWeight="Bold"
                           LetterSpacing="2"
                           VerticalAlignment="Center"
                           Foreground="#FFFFFF"/>
                <TextBlock Text="{Binding RecordingElapsedLabel}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="#FFE7E2"/>
            </StackPanel>
        </Border>

        <!-- Cam / Elgato layout guide: line your OBS or Elgato source up to this box. -->
        <Canvas IsVisible="{Binding CamGuideVisible}" IsHitTestVisible="False">
            <Rectangle Canvas.Left="64"
                       Canvas.Top="74"
                       Width="900"
                       Height="548"
                       RadiusX="24"
                       RadiusY="24"
                       Stroke="#407FE7DF"
                       StrokeThickness="1"
                       StrokeDashArray="10,8"
                       Fill="#03000000"/>
            <Rectangle Canvas.Left="832"
                       Canvas.Top="122"
                       Width="86"
                       Height="374"
                       RadiusX="20"
                       RadiusY="20"
                       Fill="#102B120D"
                       Stroke="#30E9B06E"
                       StrokeThickness="1"
                       StrokeDashArray="6,8"/>
            <Rectangle Canvas.Left="190"
                       Canvas.Top="548"
                       Width="640"
                       Height="58"
                       RadiusX="20"
                       RadiusY="20"
                       Fill="#0E041C2F"
                       Stroke="#2C7FE7DF"
                       StrokeThickness="1"
                       StrokeDashArray="6,8"/>
            <Grid Canvas.Left="{Binding CamGuideLeft}"
                  Canvas.Top="{Binding CamGuideTop}"
                  Width="{Binding CamGuideWidth}"
                  Height="{Binding CamGuideHeight}">
                <Rectangle RadiusX="14"
                           RadiusY="14"
                           Stroke="#CC7FE7DF"
                           StrokeThickness="2"
                           StrokeDashArray="6,4"
                           Fill="#14041C2F"/>
                <Border CornerRadius="10"
                        Background="#CC041C2F"
                        BorderBrush="#9979F0E4"
                        BorderThickness="1"
                        Padding="10,4"
                        Margin="10"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                    <TextBlock Text="{Binding CamGuideLabel}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               LetterSpacing="1"
                               Foreground="#D6FFFF"/>
                </Border>
                <Border CornerRadius="10"
                        Background="#B4080A12"
                        BorderBrush="#66E9B06E"
                        BorderThickness="1"
                        Padding="10,4"
                        Margin="10"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding CamGuideNote}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="#F8EFE0"/>
                </Border>
            </Grid>
        </Canvas>

        <!-- Minimal stage toggle: collapse all chrome for a clean screen recording. -->
        <Button Content="{Binding StageButtonLabel}"
                Command="{Binding ToggleStageCommand}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,18,18,0"
                MinHeight="34"
                Padding="16,7"
                FontSize="12"
                Background="#B3041C2F"
                BorderBrush="#8879F0E4"
                Foreground="#D6FFFF"/>
    </Grid>
</Window>

