<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GateKPT.MusicOS.ViewModels"
        xmlns:svc="using:GateKPT.MusicOS.Services"
        x:Class="GateKPT.MusicOS.Views.RecorderWindow"
        x:DataType="vm:RecorderWindowViewModel"
        Icon="/Assets/gatekpt.ico"
        Title="GateKPT Music OS"
        Width="1020"
        Height="760"
        MinWidth="520"
        MinHeight="580"
        Background="#06070C">

    <Design.DataContext>
        <vm:RecorderWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift, Segoe UI Variable Display, Segoe UI, Arial"/>
            <Setter Property="Foreground" Value="#E8E1D2"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#78DDA36B"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="FontFamily" Value="Bahnschrift, Segoe UI Variable Display, Segoe UI, Arial"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-2px)"/>
            <Setter Property="BorderBrush" Value="#DDF2C56B"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Background" Value="#FFF4E6CF"/>
            <Setter Property="Foreground" Value="#120918"/>
            <Setter Property="FontFamily" Value="Bahnschrift, Segoe UI Variable Text, Segoe UI, Arial"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Regular"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Background" Value="#04100F"/>
            <Setter Property="Foreground" Value="#FFF4E6CF"/>
            <Setter Property="BorderBrush" Value="#88DDA36B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Bahnschrift, Segoe UI Variable Text, Segoe UI, Arial"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="ComboBox:pointerover">
            <Setter Property="Background" Value="#211815"/>
            <Setter Property="BorderBrush" Value="#DDF2C56B"/>
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Height" Value="13"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Background" Value="#2A211A"/>
            <Setter Property="Foreground" Value="#DDA36B"/>
        </Style>
        <Style Selector="Border.take-row:pointerover">
            <Setter Property="Background" Value="#57351F17"/>
            <Setter Property="BorderBrush" Value="#BBDDA36B"/>
            <Setter Property="RenderTransform" Value="translateY(-1px)"/>
        </Style>
        <Style Selector="Button.take-select">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ListBox.take-list">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.take-list ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.take-list ListBoxItem:selected Border.take-row">
            <Setter Property="Background" Value="#883E2117"/>
            <Setter Property="BorderBrush" Value="#EEDDA36B"/>
        </Style>
    </Window.Styles>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#02050B" Offset="0"/>
                <GradientStop Color="#041817" Offset="0.34"/>
                <GradientStop Color="#221118" Offset="0.72"/>
                <GradientStop Color="#030407" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Ellipse Width="520"
                 Height="520"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="0,-240,-180,0"
                 Fill="#28E1786E"
                 IsHitTestVisible="False"/>
        <Ellipse Width="460"
                 Height="460"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Bottom"
                 Margin="-190,0,0,-170"
                 Fill="#20246166"
                 IsHitTestVisible="False"/>
        <Ellipse Width="380"
                 Height="380"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,-130,-120"
                 Fill="#2064C7B6"
                 IsHitTestVisible="False"/>
        <Grid Width="1320"
              Height="780"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Margin="0,28,0,0"
              Opacity="0.08"
              IsHitTestVisible="False"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <SkewTransform AngleX="-28" AngleY="0"/>
            </Grid.RenderTransform>
            <UniformGrid Columns="18" Rows="1">
                <Border BorderBrush="#22F2EEE3" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#18E7B06D" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#147FCAD1" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#22F2EEE3" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#18E7B06D" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#147FCAD1" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#22F2EEE3" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#18E7B06D" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#147FCAD1" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#22F2EEE3" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#18E7B06D" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#147FCAD1" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#22F2EEE3" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#18E7B06D" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#147FCAD1" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#22F2EEE3" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#18E7B06D" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#147FCAD1" BorderThickness="1,0,0,0"/>
            </UniformGrid>
            <UniformGrid Columns="1" Rows="12">
                <Border BorderBrush="#167FCAD1" BorderThickness="0,1,0,0"/>
                <Border BorderBrush="#22E7B06D" BorderThickness="0,1,0,0"/>
                <Border BorderBrush="#167FCAD1" BorderThickness="0,1,0,0"/>
                <Border BorderBrush="#22E7B06D" BorderThickness="0,1,0,0"/>
                <Border BorderBrush="#167FCAD1" BorderThickness="0,1,0,0"/>
                <Border BorderBrush="#22E7B06D" BorderThickness="0,1,0,0"/>
                <Border BorderBrush="#167FCAD1" BorderThickness="0,1,0,0"/>
                <Border BorderBrush="#22E7B06D" BorderThickness="0,1,0,0"/>
                <Border BorderBrush="#167FCAD1" BorderThickness="0,1,0,0"/>
                <Border BorderBrush="#22E7B06D" BorderThickness="0,1,0,0"/>
                <Border BorderBrush="#167FCAD1" BorderThickness="0,1,0,0"/>
                <Border BorderBrush="#22E7B06D" BorderThickness="0,1,0,0"/>
            </UniformGrid>
        </Grid>

        <Canvas IsHitTestVisible="False"
                ClipToBounds="False">
            <Path Data="M 1040 -20 L 1450 88 L 1370 378 L 980 238 Z"
                  Fill="#1DFFD2B8"
                  Stroke="#44FFD2B8"
                  StrokeThickness="1.4"/>
            <Path Data="M 900 30 L 1132 116 L 1110 282 L 848 220 Z"
                  Fill="#1264C7B6"
                  Stroke="#3C64C7B6"
                  StrokeThickness="1.2"/>
            <Path Data="M -80 520 L 240 438 L 328 722 L 0 832 Z"
                  Fill="#17153245"
                  Stroke="#355C8EB8"
                  StrokeThickness="1.1"/>
            <Path Data="M 1180 520 L 1540 440 L 1660 780 L 1260 850 Z"
                  Fill="#16E1786E"
                  Stroke="#38E1786E"
                  StrokeThickness="1.1"/>
            <Path Data="M 360 690 C 520 572, 706 770, 898 640 S 1240 548, 1460 700"
                  Stroke="#7AFFD2B8"
                  StrokeThickness="2.6"/>
            <Path Data="M 120 110 C 260 26, 430 176, 592 82 S 844 8, 1080 126"
                  Stroke="#4864C7B6"
                  StrokeThickness="2"/>
            <Path Data="M 160 590 C 344 446, 478 684, 678 528 S 980 394, 1214 586"
                  Stroke="#50E1786E"
                  StrokeThickness="1.8"/>
            <Ellipse Width="300"
                     Height="300"
                     Canvas.Left="1020"
                     Canvas.Top="520"
                     Fill="#0E64C7B6"
                     Stroke="#2464C7B6"
                     StrokeThickness="1"/>
            <Ellipse Width="210"
                     Height="210"
                     Canvas.Left="108"
                     Canvas.Top="302"
                     Fill="#0FE1786E"
                     Stroke="#2BE1786E"
                     StrokeThickness="1"/>
        </Canvas>

        <Canvas IsHitTestVisible="False"
                ClipToBounds="False"
                Opacity="0.86"
                RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <TranslateTransform X="{Binding VisualDriftX}"
                                        Y="{Binding VisualLiftY}"/>
                    <ScaleTransform ScaleX="{Binding VisualBackScale}"
                                    ScaleY="{Binding VisualBackScale}"/>
                </TransformGroup>
            </Canvas.RenderTransform>
            <Ellipse Width="5" Height="5" Canvas.Left="118" Canvas.Top="146" Fill="#C8FFD2B8"/>
            <Ellipse Width="3" Height="3" Canvas.Left="205" Canvas.Top="310" Fill="#9064C7B6"/>
            <Ellipse Width="7" Height="7" Canvas.Left="312" Canvas.Top="212" Fill="#A8E1786E"/>
            <Ellipse Width="4" Height="4" Canvas.Left="468" Canvas.Top="128" Fill="#9CFFF4E6CF"/>
            <Ellipse Width="6" Height="6" Canvas.Left="572" Canvas.Top="402" Fill="#A064C7B6"/>
            <Ellipse Width="3" Height="3" Canvas.Left="738" Canvas.Top="292" Fill="#D0FFD2B8"/>
            <Ellipse Width="8" Height="8" Canvas.Left="846" Canvas.Top="172" Fill="#7AE1786E"/>
            <Ellipse Width="4" Height="4" Canvas.Left="1018" Canvas.Top="358" Fill="#B864C7B6"/>
            <Ellipse Width="6" Height="6" Canvas.Left="1168" Canvas.Top="236" Fill="#B8FFF4E6CF"/>
            <Ellipse Width="3" Height="3" Canvas.Left="1284" Canvas.Top="510" Fill="#90FFD2B8"/>
            <Ellipse Width="7" Height="7" Canvas.Left="1388" Canvas.Top="118" Fill="#8C64C7B6"/>
            <Border Width="72" Height="1.5" Canvas.Left="250" Canvas.Top="484" Background="#55FFD2B8" CornerRadius="999"/>
            <Border Width="96" Height="1" Canvas.Left="898" Canvas.Top="456" Background="#5064C7B6" CornerRadius="999"/>
            <Border Width="54" Height="1.5" Canvas.Left="1110" Canvas.Top="642" Background="#48E1786E" CornerRadius="999"/>
            <Border Width="112" Height="1" Canvas.Left="420" Canvas.Top="620" Background="#36FFF4E6CF" CornerRadius="999"/>
        </Canvas>

        <Path Data="M 20 675 C 210 448, 430 808, 705 548 S 1118 392, 1510 708"
              Stroke="#3A64C7B6"
              StrokeThickness="7"
              Opacity="0.20"
              Stretch="Fill"
              IsHitTestVisible="False"/>
        <Path Data="M -40 720 C 180 472, 450 850, 710 610 S 1125 460, 1540 760"
              Stroke="#24F2EEE3"
              StrokeThickness="3"
              Opacity="0.18"
              Stretch="Fill"
              IsHitTestVisible="False"/>
        <Path Data="M -120 520 C 128 350, 372 620, 590 430 S 910 330, 1220 520 S 1470 410, 1680 490"
              Stroke="#3CE1786E"
              StrokeThickness="5"
              Opacity="0.18"
              Stretch="Fill"
              IsHitTestVisible="False"/>
        <Ellipse Width="220"
                 Height="220"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Center"
                 Margin="-90,-80,0,0"
                 Fill="#1464C7B6"
                 Stroke="#3064C7B6"
                 StrokeThickness="1"
                 IsHitTestVisible="False"/>
        <Ellipse Width="180"
                 Height="180"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Center"
                 Margin="0,160,-45,0"
                 Fill="#20E1786E"
                 Stroke="#44E1786E"
                 StrokeThickness="1"
                 IsHitTestVisible="False"/>
        <Grid Width="1120"
              Height="560"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Margin="0,70,0,0"
              Opacity="0.10"
              IsHitTestVisible="False"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <SkewTransform AngleX="-18" AngleY="0"/>
            </Grid.RenderTransform>
            <UniformGrid Columns="14" Rows="1">
                <Border BorderBrush="#2ADDA36B" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#2ADDA36B" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#2ADDA36B" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#2ADDA36B" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#2ADDA36B" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#2ADDA36B" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#2ADDA36B" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#2ADDA36B" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#2ADDA36B" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#2ADDA36B" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#2ADDA36B" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#2ADDA36B" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#2ADDA36B" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#2ADDA36B" BorderThickness="1,0,0,0"/>
            </UniformGrid>
            <UniformGrid Columns="1" Rows="9">
                <Border BorderBrush="#227FCAD1" BorderThickness="0,1,0,0"/>
                <Border BorderBrush="#227FCAD1" BorderThickness="0,1,0,0"/>
                <Border BorderBrush="#227FCAD1" BorderThickness="0,1,0,0"/>
                <Border BorderBrush="#227FCAD1" BorderThickness="0,1,0,0"/>
                <Border BorderBrush="#227FCAD1" BorderThickness="0,1,0,0"/>
                <Border BorderBrush="#227FCAD1" BorderThickness="0,1,0,0"/>
                <Border BorderBrush="#227FCAD1" BorderThickness="0,1,0,0"/>
                <Border BorderBrush="#227FCAD1" BorderThickness="0,1,0,0"/>
                <Border BorderBrush="#227FCAD1" BorderThickness="0,1,0,0"/>
            </UniformGrid>
        </Grid>
        <Grid Width="128"
              Height="128"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="0,118,0,0"
              Opacity="0.58"
              IsHitTestVisible="False">
            <Ellipse Fill="#141A1F"
                     Stroke="#78DDA36B"
                     StrokeThickness="1.2"/>
            <UniformGrid Columns="4" Rows="4" Margin="18">
                <Border Margin="3" CornerRadius="3" Background="#90F2EEE3"/>
                <Border Margin="3" CornerRadius="3" Background="#55DDA36B"/>
                <Border Margin="3" CornerRadius="3" Background="#667FCAD1"/>
                <Border Margin="3" CornerRadius="3" Background="#80F2C56B"/>
                <Border Margin="3" CornerRadius="3" Background="#667FCAD1"/>
                <Border Margin="3" CornerRadius="3" Background="#B8F2EEE3"/>
                <Border Margin="3" CornerRadius="3" Background="#55DDA36B"/>
                <Border Margin="3" CornerRadius="3" Background="#667FCAD1"/>
                <Border Margin="3" CornerRadius="3" Background="#55DDA36B"/>
                <Border Margin="3" CornerRadius="3" Background="#667FCAD1"/>
                <Border Margin="3" CornerRadius="3" Background="#B8F2EEE3"/>
                <Border Margin="3" CornerRadius="3" Background="#80DDA36B"/>
                <Border Margin="3" CornerRadius="3" Background="#80F2C56B"/>
                <Border Margin="3" CornerRadius="3" Background="#55DDA36B"/>
                <Border Margin="3" CornerRadius="3" Background="#667FCAD1"/>
                <Border Margin="3" CornerRadius="3" Background="#90F2EEE3"/>
            </UniformGrid>
        </Grid>
        <ItemsControl ItemsSource="{Binding SignalBars}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Top"
                      Margin="-80,78,-80,0"
                      Opacity="0.06"
                      IsHitTestVisible="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="18"
                            Height="{Binding}"
                            CornerRadius="999"
                            VerticalAlignment="Center"
                            Margin="5,0"
                            Background="#8F7FCAD1"
                            BorderBrush="#44E8E1D2"
                            BorderThickness="1">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleY="1.7"/>
                        </Border.RenderTransform>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding SignalBars}"
                      Width="1450"
                      Height="120"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="0,-80,0,0"
                      Opacity="0.05"
                      IsHitTestVisible="False"
                      RenderTransformOrigin="0.5,0.5">
            <ItemsControl.RenderTransform>
                <RotateTransform Angle="-12"/>
            </ItemsControl.RenderTransform>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="15"
                            Height="{Binding}"
                            CornerRadius="999"
                            VerticalAlignment="Center"
                            Margin="5,0"
                            Background="#8E7FCAD1"
                            BorderBrush="#48E8E1D2"
                            BorderThickness="1">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleY="2.8"/>
                        </Border.RenderTransform>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding SignalBars}"
                      Width="1500"
                      Height="150"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="0,180,0,0"
                      Opacity="0.05"
                      IsHitTestVisible="False"
                      RenderTransformOrigin="0.5,0.5">
            <ItemsControl.RenderTransform>
                <RotateTransform Angle="16"/>
            </ItemsControl.RenderTransform>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="19"
                            Height="{Binding}"
                            CornerRadius="999"
                            VerticalAlignment="Center"
                            Margin="6,0"
                            Background="#86E1786E"
                            BorderBrush="#6064C7B6"
                            BorderThickness="1">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleY="4.4"/>
                        </Border.RenderTransform>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding SignalBars}"
                      Width="1780"
                      Height="190"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="0,330,0,0"
                      Opacity="0.04"
                      IsHitTestVisible="False"
                      RenderTransformOrigin="0.5,0.5">
            <ItemsControl.RenderTransform>
                <RotateTransform Angle="-29"/>
            </ItemsControl.RenderTransform>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="22"
                            Height="{Binding}"
                            CornerRadius="999"
                            VerticalAlignment="Center"
                            Margin="8,0"
                            Background="#80F2EEE3"
                            BorderBrush="#5E64C7B6"
                            BorderThickness="1">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleY="7.2"/>
                        </Border.RenderTransform>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding SignalBars}"
                      Width="1260"
                      Height="110"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      Margin="0,222,0,0"
                      Opacity="0.07"
                      IsHitTestVisible="False"
                      RenderTransformOrigin="0.5,0.5">
            <ItemsControl.RenderTransform>
                <SkewTransform AngleX="22" AngleY="0"/>
            </ItemsControl.RenderTransform>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="10"
                            Height="{Binding}"
                            CornerRadius="999"
                            VerticalAlignment="Center"
                            Margin="4,0"
                            Background="#96E1786E"
                            BorderBrush="#5264C7B6"
                            BorderThickness="1">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleY="3.4"/>
                        </Border.RenderTransform>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Path Data="M -40 115 C 110 40, 220 155, 370 92 S 620 30, 820 124 S 1120 80, 1460 130"
              Stroke="#56E1786E"
              StrokeThickness="2.4"
              Opacity="0.28"
              Stretch="Fill"
              IsHitTestVisible="False"/>
        <Path Data="M -70 165 C 130 98, 270 208, 430 142 S 710 90, 940 180 S 1210 125, 1500 175"
              Stroke="#4264C7B6"
              StrokeThickness="1.5"
              Opacity="0.26"
              Stretch="Fill"
              IsHitTestVisible="False"/>
        <Path Data="M -40 220 C 120 110, 250 290, 420 170 S 720 80, 1040 210 S 1320 120, 1480 190"
              Stroke="#3264C7B6"
              StrokeThickness="1.7"
              Opacity="0.22"
              Stretch="Fill"
              IsHitTestVisible="False"/>
        <Path Data="M -20 320 C 150 260, 260 370, 430 310 S 760 260, 1020 350 S 1260 295, 1500 360"
              Stroke="#55FFD2B8"
              StrokeThickness="1.4"
              Opacity="0.24"
              Stretch="Fill"
              IsHitTestVisible="False"/>
        <ItemsControl ItemsSource="{Binding SignalBars}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      Margin="-20,0,-20,0"
                      Opacity="0.10"
                      IsHitTestVisible="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="11"
                            Height="{Binding}"
                            CornerRadius="999"
                            VerticalAlignment="Center"
                            Margin="3,0"
                            Background="#98E1786E"
                            BorderBrush="#55D7C4AD"
                            BorderThickness="1">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleY="5.4"/>
                        </Border.RenderTransform>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Path Data="M -80 470 C 170 390, 300 540, 520 455 S 860 405, 1120 500 S 1360 440, 1520 490"
              Stroke="#44E8E1D2"
              StrokeThickness="1.3"
              Stretch="Fill"
              IsHitTestVisible="False"/>
        <ItemsControl ItemsSource="{Binding SignalBars}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Bottom"
                      Margin="-130,0,-130,170"
                      Opacity="0.08"
                      IsHitTestVisible="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="24"
                            Height="{Binding}"
                            CornerRadius="999"
                            VerticalAlignment="Center"
                            Margin="6,0"
                            Background="#8BE1786E"
                            BorderBrush="#6064C7B6"
                            BorderThickness="1">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleY="6.8"/>
                        </Border.RenderTransform>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Height="450"
              VerticalAlignment="Bottom"
              Margin="0,0,0,-28"
              Opacity="0.94"
              IsHitTestVisible="False">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#00130F16" Offset="0"/>
                    <GradientStop Color="#33130F16" Offset="0.34"/>
                    <GradientStop Color="#551F140D" Offset="0.68"/>
                    <GradientStop Color="#00130F16" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Path Data="M -80 310 C 120 150, 300 390, 520 250 S 850 105, 1120 330 S 1370 170, 1560 270"
                  Stroke="#72A16945"
                  StrokeThickness="4.4"
                  Opacity="0.30"
                  Stretch="Fill"/>
            <Path Data="M -70 360 C 140 235, 320 440, 540 325 S 880 215, 1150 390 S 1380 255, 1560 350"
                  Stroke="#7464C7B6"
                  StrokeThickness="3.1"
                  Opacity="0.28"
                  Stretch="Fill"/>
            <Path Data="M -40 210 C 130 95, 270 265, 470 175 S 800 85, 1080 245 S 1340 130, 1560 205"
                  Stroke="#66E1786E"
                  StrokeThickness="2.3"
                  Opacity="0.24"
                  Stretch="Fill"/>
            <Path Data="M 620 85 C 780 5, 1010 18, 1210 122 S 1460 355, 1230 460 S 780 510, 650 365 S 470 160, 620 85"
                  Stroke="#50C9B8FF"
                  StrokeThickness="2.8"
                  Opacity="0.18"
                  Stretch="Fill"/>
            <Path Data="M 690 135 C 830 68, 1030 78, 1175 170 S 1320 335, 1140 415 S 805 430, 710 330 S 565 202, 690 135"
                  Stroke="#8264C7B6"
                  StrokeThickness="2"
                  Opacity="0.18"
                  Stretch="Fill"/>
            <Path Data="M 760 190 C 875 132, 1040 145, 1135 220 S 1210 326, 1075 368 S 855 360, 790 292 S 650 240, 760 190"
                  Stroke="#8BF2EEE3"
                  StrokeThickness="1.45"
                  Opacity="0.16"
                  Stretch="Fill"/>
            <Path Data="M 805 225 C 900 180, 1022 190, 1088 245 S 1130 315, 1038 338 S 875 328, 835 287 S 725 263, 805 225"
                  Stroke="#65F08A3C"
                  StrokeThickness="1.2"
                  Opacity="0.14"
                  Stretch="Fill"/>
            <ItemsControl ItemsSource="{Binding SignalBars}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Bottom"
                          Margin="0,0,0,34">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="8"
                                Height="{Binding}"
                                CornerRadius="999"
                                Margin="4,0"
                                VerticalAlignment="Bottom"
                                Background="#A0E1786E"
                                BorderBrush="#8064C7B6"
                                BorderThickness="1"
                                RenderTransformOrigin="0.5,1">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleY="2.65"/>
                            </Border.RenderTransform>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <Grid Width="860"
              Height="520"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Margin="0,-36,0,0"
              IsHitTestVisible="False"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <RotateTransform Angle="{Binding VisualRoomTilt}"/>
                    <ScaleTransform ScaleX="{Binding VisualRoomScale}"
                                    ScaleY="{Binding VisualRoomScale}"/>
                    <TranslateTransform X="{Binding VisualDriftX}"
                                        Y="{Binding VisualLiftY}"/>
                </TransformGroup>
            </Grid.RenderTransform>

            <Ellipse Width="{Binding VisualBloomSize}"
                     Height="{Binding VisualBloomSize}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Fill="#20E7B06D"
                     Stroke="#24F2EEE3"
                     StrokeThickness="1"
                     Opacity="{Binding VisualBloomOpacity}"/>
            <Ellipse Width="{Binding VisualCoreSize}"
                     Height="{Binding VisualCoreSize}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Fill="#2864C7B6"
                     Stroke="#7DF2C56B"
                     StrokeThickness="2"
                     Opacity="0.72"/>
            <Ellipse Width="430"
                     Height="136"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Stroke="#44DDA36B"
                     StrokeThickness="2"
                     Fill="Transparent"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <RotateTransform Angle="-18"/>
                        <ScaleTransform ScaleX="{Binding VisualBackScale}"
                                        ScaleY="{Binding VisualBackScale}"/>
                    </TransformGroup>
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="560"
                     Height="168"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Stroke="#4481D7DA"
                     StrokeThickness="2"
                     Fill="Transparent"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <RotateTransform Angle="14"/>
                        <ScaleTransform ScaleX="{Binding VisualMidScale}"
                                        ScaleY="{Binding VisualMidScale}"/>
                    </TransformGroup>
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="720"
                     Height="210"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Stroke="#38F2EEE3"
                     StrokeThickness="1.4"
                     Fill="Transparent"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <RotateTransform Angle="-4"/>
                        <ScaleTransform ScaleX="{Binding VisualFrontScale}"
                                        ScaleY="{Binding VisualFrontScale}"/>
                    </TransformGroup>
                </Ellipse.RenderTransform>
            </Ellipse>

            <ItemsControl ItemsSource="{Binding SignalBars}"
                          Width="780"
                          Height="220"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Opacity="0.18"
                          RenderTransformOrigin="0.5,0.5">
                <ItemsControl.RenderTransform>
                    <TransformGroup>
                        <RotateTransform Angle="-8"/>
                        <ScaleTransform ScaleX="{Binding VisualMidScale}"
                                        ScaleY="{Binding VisualMidScale}"/>
                    </TransformGroup>
                </ItemsControl.RenderTransform>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="9"
                                Height="{Binding}"
                                CornerRadius="999"
                                VerticalAlignment="Center"
                                Margin="3,0"
                                Background="#B2F2C56B"
                                BorderBrush="#7464C7B6"
                                BorderThickness="1">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleY="3.6"/>
                            </Border.RenderTransform>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding SignalBars}"
                          Width="900"
                          Height="260"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Opacity="0.12"
                          RenderTransformOrigin="0.5,0.5">
                <ItemsControl.RenderTransform>
                    <TransformGroup>
                        <RotateTransform Angle="24"/>
                        <ScaleTransform ScaleX="{Binding VisualFrontScale}"
                                        ScaleY="{Binding VisualFrontScale}"/>
                    </TransformGroup>
                </ItemsControl.RenderTransform>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="14"
                                Height="{Binding}"
                                CornerRadius="999"
                                VerticalAlignment="Center"
                                Margin="5,0"
                                Background="#8AE7B06D"
                                BorderBrush="#55F2EEE3"
                                BorderThickness="1">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleY="5.8"/>
                            </Border.RenderTransform>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18" Spacing="14" MaxWidth="980" HorizontalAlignment="Center">
                <Border CornerRadius="34"
                        Padding="16"
                        BorderBrush="#78E1786E"
                        BorderThickness="1"
                        ClipToBounds="True"
                        BoxShadow="0 30 70 0 #AA000000">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#E8061110" Offset="0"/>
                            <GradientStop Color="#D20A2022" Offset="0.48"/>
                            <GradientStop Color="#C02B121A" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="9">
                        <Path Grid.RowSpan="3"
                              Data="M 0 50 C 90 20, 160 78, 250 45 S 420 24, 560 64 S 780 35, 960 58"
                              Stroke="#46E1786E"
                              StrokeThickness="1.2"
                              Stretch="Fill"
                              IsHitTestVisible="False"/>
                        <Path Grid.RowSpan="3"
                              Data="M 0 112 C 110 85, 190 150, 310 102 S 510 95, 690 132 S 850 105, 980 126"
                              Stroke="#3064C7B6"
                              StrokeThickness="1"
                              Stretch="Fill"
                              IsHitTestVisible="False"/>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                            <StackPanel IsVisible="{Binding IsRecording}">
                                <TextBlock Text="{Binding RecordingGuardLabel}"
                                           FontSize="26"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="#120918"/>
                                <TextBlock Text="{Binding CaptureInstruction}"
                                           Margin="0,2,0,0"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="#4A351E"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    IsVisible="{Binding HasVisibleSignal}"
                                    CornerRadius="24"
                                    MinWidth="122"
                                    Padding="16,12"
                                    Background="#06070C"
                                    BorderBrush="#8064C7B6"
                                    BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PeakDecibelLabel}"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Foreground="#FFD2B8"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="1"
                                IsVisible="False"
                                CornerRadius="21"
                                Padding="8"
                                Background="#E61B1717"
                                BorderBrush="#4DDDA36B"
                                BorderThickness="1"
                                MinHeight="58"
                                MaxHeight="66">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="13">
                                <ItemsControl
                                              ItemsSource="{Binding SignalBars}"
                                              VerticalAlignment="Stretch"
                                              HorizontalAlignment="Stretch">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="8"
                                                    Height="{Binding}"
                                                    CornerRadius="999"
                                                    VerticalAlignment="Center"
                                                    Margin="2,0"
                                                    Background="#E1786E"
                                                    BorderBrush="#5264C7B6"
                                                    BorderThickness="1"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SimpleSignalLabel}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           LetterSpacing="1.5"
                                           VerticalAlignment="Center"
                                           Foreground="#64C7B6"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1"
                              IsHitTestVisible="False">
                            <Border IsVisible="{Binding IsBusy}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    CornerRadius="999"
                                    Padding="13,8"
                                    Background="#E61C1309"
                                    BorderBrush="#8064C7B6"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ProgressBar IsIndeterminate="True"
                                                 Width="42"
                                                 Height="6"
                                                 Background="#2A211A"
                                                 Foreground="#E1786E"/>
                                    <TextBlock Text="{Binding BusyLabel}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#E8E1D2"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="1"
                                CornerRadius="999"
                                Padding="12"
                                HorizontalAlignment="Center"
                                Background="#CC07070C"
                                BorderBrush="#88E1786E"
                                BorderThickness="1"
                                BoxShadow="0 22 0 0 #4D0B1715, 0 34 70 0 #AA000000"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <SkewTransform AngleX="-5" AngleY="0"/>
                            </Border.RenderTransform>
                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto"
                                  ColumnSpacing="11"
                                  HorizontalAlignment="Center">
                            <Button
                                    Command="{Binding StartRecordingCommand}"
                                    IsVisible="{Binding CanStartRecording}"
                                    Content="●"
                                    ToolTip.Tip="Record"
                                    Padding="22,13"
                                    MinWidth="108"
                                    MinHeight="50"
                                    Margin="0"
                                    FontSize="20"
                                    LetterSpacing="0.6"
                                    BorderThickness="1"
                                    BorderBrush="#60F2E2C8"
                                    Background="#05070B"
                                    Foreground="#F7EBD7"/>
                            <Button
                                    Command="{Binding StopRecordingCommand}"
                                    IsVisible="{Binding CanStopRecording}"
                                    Content="■"
                                    ToolTip.Tip="Stop and save"
                                    Padding="22,13"
                                    MinWidth="108"
                                    MinHeight="50"
                                    Margin="0"
                                    FontSize="19"
                                    LetterSpacing="0.6"
                                    BorderThickness="1"
                                    BorderBrush="#80F2E2C8"
                                    Background="#E1786E"
                                    Foreground="#10080A"/>
                            <Button Grid.Column="1"
                                    Content="▶"
                                    ToolTip.Tip="Play latest"
                                    Command="{Binding PlaySelectedCommand}"
                                    Padding="18,12"
                                    MinWidth="82"
                                    MinHeight="50"
                                    Margin="0"
                                    FontSize="18"
                                    BorderBrush="#55F2E2C8"
                                    BorderThickness="1"
                                    Background="#FFF4E6CF"
                                    Foreground="#120918"/>
                            <Button Grid.Column="2"
                                    Content="∿"
                                    ToolTip.Tip="Mix session"
                                    Command="{Binding MixSessionTakesCommand}"
                                    Padding="18,12"
                                    MinWidth="82"
                                    MinHeight="50"
                                    Margin="0"
                                    FontSize="22"
                                    BorderBrush="#9AFFD2B8"
                                    BorderThickness="1"
                                    Background="#64C7B6"
                                    Foreground="#120918"/>
                            <Button Grid.Column="3"
                                    Content="⌂"
                                    ToolTip.Tip="Open folder"
                                    Command="{Binding OpenFolderCommand}"
                                    Padding="18,12"
                                    MinWidth="82"
                                    MinHeight="50"
                                    Margin="0"
                                    FontSize="19"
                                    BorderBrush="#6064C7B6"
                                    BorderThickness="1"
                                    Background="#04100F"
                                    Foreground="#F7EBD7"/>
                            <TextBox Grid.Column="4"
                                     IsVisible="False"
                                     Text="{Binding SessionName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Session 1"
                                     MinHeight="40"/>
                            <ComboBox Grid.Column="5"
                                      IsVisible="False"
                                      ItemsSource="{Binding InputDevices}"
                                      SelectedItem="{Binding SelectedInputDevice}"
                                      MinHeight="40"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2"
                                CornerRadius="18"
                                Padding="12,9"
                                Background="#6606070C"
                                BorderBrush="#24E7B06D"
                                BorderThickness="1">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Status}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       MaxLines="2"
                                       Foreground="#E8E1D2"/>
                            <TextBlock Text="{Binding SignalProbeSummary}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       MaxLines="1"
                                       Foreground="#8CD6D8"/>
                            <TextBlock Text="{Binding LastRecorderDiagnostic}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       MaxLines="1"
                                       Foreground="#A88B62"/>
                        </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border CornerRadius="24"
                        Padding="14"
                        BorderBrush="#55DDA36B"
                        BorderThickness="1"
                        Background="#D90E1013"
                        BoxShadow="0 24 48 0 #88000000">
                    <StackPanel Spacing="9">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding ChatText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Ask GateKPT..."
                                     MinHeight="42"/>
                            <Button Grid.Column="1"
                                     Content=">"
                                     Command="{Binding RunChatCommandCommand}"
                                     Padding="16,10"
                                     MinWidth="58"
                                     Background="#DDA36B"
                                     Foreground="#120918"/>
                        </Grid>
                        <TextBlock Text="{Binding CommandResult}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="#E8E1D2"/>
                        <Border CornerRadius="20"
                                Padding="12"
                                BorderBrush="#44DDA36B"
                                BorderThickness="1"
                                Background="#99130F16"
                                BoxShadow="0 18 36 0 #66000000">
                            <Grid ColumnDefinitions="*" ColumnSpacing="10">
                                <WrapPanel Orientation="Horizontal">
                                    <Button Command="{Binding StageRawCleanCommand}" Width="108" Height="34" Padding="0" Margin="0,0,8,0" Background="Transparent" BorderThickness="0">
                                        <Border CornerRadius="12" BorderBrush="#70F2EEE3" BorderThickness="1.1">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                    <GradientStop Color="#1A1814" Offset="0"/>
                                                    <GradientStop Color="#F2EEE3" Offset="0.38"/>
                                                    <GradientStop Color="#5B5148" Offset="0.7"/>
                                                    <GradientStop Color="#0B0B0D" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Path Data="M 10 17 L 98 17" Stroke="#AA06070C" StrokeThickness="1.8"/>
                                        </Border>
                                    </Button>
                                    <Button Command="{Binding StageLateNightChromeCommand}" Width="108" Height="34" Padding="0" Margin="0,0,8,0" Background="Transparent" BorderThickness="0">
                                        <Border CornerRadius="12" BorderBrush="#80F2EEE3" BorderThickness="1.1">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                    <GradientStop Color="#080A12" Offset="0"/>
                                                    <GradientStop Color="#F7F3EA" Offset="0.28"/>
                                                    <GradientStop Color="#7B8493" Offset="0.48"/>
                                                    <GradientStop Color="#FFF8F0" Offset="0.62"/>
                                                    <GradientStop Color="#1C2230" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid>
                                                <Path Data="M 8 24 C 28 6, 63 30, 100 10" Stroke="#996EE7FF" StrokeThickness="1.6"/>
                                                <Path Data="M 12 9 L 40 9 M 62 25 L 96 25" Stroke="#99F2EEE3" StrokeThickness="1.1"/>
                                            </Grid>
                                        </Border>
                                    </Button>
                                    <Button Command="{Binding QuickWarmerCommand}" Width="108" Height="34" Padding="0" Margin="0,0,8,0" Background="Transparent" BorderThickness="0">
                                        <Border CornerRadius="12" BorderBrush="#94F08A3C" BorderThickness="1.1">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                    <GradientStop Color="#160908" Offset="0"/>
                                                    <GradientStop Color="#F08A3C" Offset="0.42"/>
                                                    <GradientStop Color="#C64925" Offset="0.72"/>
                                                    <GradientStop Color="#180907" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Grid>
                                                <Path Data="M 8 25 C 18 9, 25 24, 34 10 C 42 26, 55 19, 64 28 C 76 10, 88 19, 101 8" Stroke="#DDF2EEE3" StrokeThickness="1.25"/>
                                                <Path Data="M 10 27 L 98 27" Stroke="#55FFF0B8" StrokeThickness="1"/>
                                            </Grid>
                                        </Border>
                                    </Button>
                                    <Button Command="{Binding QuickReverbCommand}" Width="108" Height="34" Padding="0" Margin="0,0,8,0" Background="Transparent" BorderThickness="0">
                                        <Border CornerRadius="12" BorderBrush="#7864C7B6" BorderThickness="1.1">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                    <GradientStop Color="#081016" Offset="0"/>
                                                    <GradientStop Color="#16313A" Offset="0.44"/>
                                                    <GradientStop Color="#64C7B6" Offset="0.63"/>
                                                    <GradientStop Color="#081016" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Path Data="M 12 18 C 30 4, 78 4, 96 18 M 24 24 C 40 14, 68 14, 84 24" Stroke="#DDF2EEE3" StrokeThickness="1.25"/>
                                        </Border>
                                    </Button>
                                    <Button Command="{Binding QuickLouderCommand}" Width="108" Height="34" Padding="0" Margin="0,0,8,0" Background="Transparent" BorderThickness="0">
                                        <Border CornerRadius="12" BorderBrush="#7064C7B6" BorderThickness="1.1">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                    <GradientStop Color="#081016" Offset="0"/>
                                                    <GradientStop Color="#0B3E4D" Offset="0.58"/>
                                                    <GradientStop Color="#DDA36B" Offset="0.82"/>
                                                    <GradientStop Color="#130F0B" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Path Data="M 10 25 L 18 12 L 27 24 L 37 8 L 47 26 L 58 14 L 70 23 L 83 10 L 99 24" Stroke="#DDF2EEE3" StrokeThickness="1.25"/>
                                        </Border>
                                    </Button>
                                    <Button Content="X" Command="{Binding QuickDeleteCommand}" Width="42" Height="34" Padding="0" Margin="0,0,8,0" Background="#4A231B" Foreground="#E8E1D2"/>
                                </WrapPanel>
                            </Grid>
                        </Border>
                        <StackPanel IsVisible="{Binding IsCommandBusy}" Spacing="6">
                            <TextBlock Text="Working..."
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1.8"
                                       Foreground="#DDA36B"/>
                            <ProgressBar IsIndeterminate="True"
                                         Height="6"
                                         Background="#2A211A"
                                         Foreground="#F2C56B"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border CornerRadius="28"
                        Padding="0"
                        BorderBrush="#33DDA36B"
                        BorderThickness="1"
                        Background="#CC090D13"
                        ClipToBounds="True"
                        BoxShadow="0 30 60 0 #99000000">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="0">
                        <Border Padding="14"
                                Background="#B90B1017">
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="13">
                                    <TextBlock Text="TAKES"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               LetterSpacing="2.2"
                                               Foreground="#DDA36B"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SelectedTakeMixLabel}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Foreground="#7FCAD1"/>
                                </Grid>
                                <ScrollViewer Grid.Row="1"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto"
                                              MaxHeight="108">
                                    <ListBox Classes="take-list"
                                             ItemsSource="{Binding Versions}"
                                             SelectedItem="{Binding SelectedVersion}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="svc:RecorderVersionFile">
                                                <Border Classes="take-row"
                                                        CornerRadius="18"
                                                        Padding="12,10"
                                                        Margin="0,0,0,7"
                                                        Background="#66131A24"
                                                        BorderBrush="#2EDDA36B"
                                                        BorderThickness="1">
                                                    <Grid ColumnDefinitions="*" ColumnSpacing="10">
                                                        <Path
                                                              Data="M -8 29 C 46 12, 92 38, 146 22 S 248 10, 312 31 S 432 43, 540 18"
                                                              Stroke="#267FCAD1"
                                                              StrokeThickness="1.2"
                                                              Stretch="Fill"
                                                              IsHitTestVisible="False"/>
                                                        <Path
                                                              Data="M -10 43 C 62 24, 126 53, 202 35 S 338 19, 452 48"
                                                              Stroke="#24DDA36B"
                                                              StrokeThickness="1"
                                                              Stretch="Fill"
                                                              IsHitTestVisible="False"/>
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       TextWrapping="Wrap"/>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding DisplayMeta}"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#7FCAD1"/>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border CornerRadius="28"
                        Padding="16"
                        BorderBrush="#68E1786E"
                        BorderThickness="1"
                        Background="#C90A0D13"
                        ClipToBounds="True"
                        BoxShadow="0 28 62 0 #88000000">
                    <Grid ColumnDefinitions="*,270" ColumnSpacing="14">
                        <Border CornerRadius="22"
                                Padding="14"
                                Background="#B706070C"
                                BorderBrush="#3A64C7B6"
                                BorderThickness="1"
                                MinHeight="150">
                            <Grid>
                                <Path Data="M -20 84 C 72 22, 142 130, 245 70 S 438 20, 620 98 S 782 50, 940 84"
                                      Stroke="#78E1786E"
                                      StrokeThickness="2.1"
                                      Stretch="Fill"
                                      IsHitTestVisible="False"/>
                                <Path Data="M -20 112 C 90 42, 190 150, 312 96 S 528 74, 724 128 S 838 88, 960 122"
                                      Stroke="#7064C7B6"
                                      StrokeThickness="1.8"
                                      Stretch="Fill"
                                      IsHitTestVisible="False"/>
                                <Path Data="M 20 28 C 130 84, 232 10, 358 50 S 560 106, 760 36"
                                      Stroke="#55F2E2C8"
                                      StrokeThickness="1.2"
                                      Stretch="Fill"
                                      IsHitTestVisible="False"/>
                                <ItemsControl ItemsSource="{Binding SignalBars}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              Margin="-12,0,-12,0"
                                              Opacity="0.52"
                                              IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="9"
                                                    Height="{Binding}"
                                                    CornerRadius="999"
                                                    Margin="3,0"
                                                    VerticalAlignment="Center"
                                                    Background="#96E1786E"
                                                    BorderBrush="#5E64C7B6"
                                                    BorderThickness="1">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleY="4.2"/>
                                                </Border.RenderTransform>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid VerticalAlignment="Bottom"
                                      ColumnDefinitions="*,Auto"
                                      ColumnSpacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="FRAME"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   LetterSpacing="2.4"
                                                   Foreground="#E1786E"/>
                                        <TextBlock Text="screen / face / sound"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="#F7EBD7"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding VideoSyncLabel}"
                                               VerticalAlignment="Bottom"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#64C7B6"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1"
                                CornerRadius="22"
                                Padding="13"
                                Background="#D810080A"
                                BorderBrush="#94E1786E"
                                BorderThickness="1"
                                BoxShadow="0 14 0 0 #330B1715, 0 28 52 0 #88000000"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <SkewTransform AngleX="4" AngleY="0"/>
                            </Border.RenderTransform>
                            <Grid RowDefinitions="*,Auto" RowSpacing="10">
                                <Border CornerRadius="18"
                                        Background="#181C2430"
                                        BorderBrush="#4A64C7B6"
                                        BorderThickness="1"
                                        BoxShadow="inset 0 0 30 0 #44000000, 0 10 24 0 #66000000">
                                    <Grid>
                                        <Ellipse Width="120"
                                                 Height="120"
                                                 Fill="#241D2938"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Top"
                                                 Margin="0,-45,-28,0"/>
                                        <Path Data="M 10 86 C 45 30, 90 122, 132 70 S 218 36, 252 92"
                                              Stroke="#80E1786E"
                                              StrokeThickness="2"
                                              Stretch="Fill"/>
                                        <TextBlock Text="◉"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="34"
                                                   FontWeight="SemiBold"
                                                   LetterSpacing="2"
                                                   Foreground="#F7EBD7"/>
                                    </Grid>
                                </Border>
                                <WrapPanel Grid.Row="1"
                                           Orientation="Horizontal"
                                           HorizontalAlignment="Right">
                                    <Button Content="◉"
                                            ToolTip.Tip="Open camera"
                                            Command="{Binding OpenCameraCommand}"
                                            Padding="14,9"
                                            MinWidth="58"
                                            Margin="0,0,8,0"
                                            FontSize="17"
                                            Background="#04100F"
                                            Foreground="#F7EBD7"/>
                                    <Button Content="↔"
                                            ToolTip.Tip="Auto sync"
                                            Command="{Binding AutoSyncPostClipCommand}"
                                            Padding="14,9"
                                            MinWidth="58"
                                            Margin="0,0,8,0"
                                            FontSize="17"
                                            Background="#64C7B6"
                                            Foreground="#10080A"/>
                                    <Button Content="↑"
                                            ToolTip.Tip="Make post clip"
                                            Command="{Binding MakePostClipCommand}"
                                            Padding="14,9"
                                            MinWidth="58"
                                            FontSize="17"
                                            Background="#E1786E"
                                            Foreground="#10080A"/>
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border IsVisible="False"
                        CornerRadius="28"
                        Padding="18"
                        BorderBrush="#44DDA36B"
                        BorderThickness="1"
                        Background="#D90E1013">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="13">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="13">
                            <StackPanel Spacing="6">
                                <TextBlock Text="CONTENT PACK"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           LetterSpacing="2.2"
                                           Foreground="#DDA36B"/>
                                <TextBlock Text="One take -> one world -> one post."
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="#E8E1D2"/>
                                <TextBlock Text="{Binding ContentPackTakeLabel}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="#7FCAD1"/>
                            </StackPanel>
                            <WrapPanel Grid.Column="1"
                                       Orientation="Horizontal"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       MaxWidth="520">
                                <ComboBox ItemsSource="{Binding ContentPackWorlds}"
                                          SelectedItem="{Binding ContentPackWorld}"
                                          MinWidth="132"
                                          Margin="0,0,8,8"/>
                                <ComboBox ItemsSource="{Binding ContentPackClipTypes}"
                                          SelectedItem="{Binding ContentPackClipType}"
                                          MinWidth="132"
                                          Margin="0,0,8,8"/>
                                <Button Content="Generate"
                                        Command="{Binding GenerateContentPackCommand}"
                                        Padding="16,11"
                                        MinWidth="118"
                                        Margin="0,0,8,8"
                                        Background="#DDA36B"
                                        Foreground="#120918"/>
                                <Button Content="Packs"
                                        Command="{Binding OpenContentPackFolderCommand}"
                                        Padding="16,11"
                                        MinWidth="92"
                                        Margin="0,0,0,8"
                                        Background="#211815"
                                        Foreground="#E8E1D2"/>
                            </WrapPanel>
                        </Grid>
                        <StackPanel Grid.Row="1" Spacing="8">
                            <TextBlock Text="{Binding ContentPackSaveLabel}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="#7FCAD1"/>
                            <TextBox Text="{Binding ContentPackResult}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="116"
                                     Background="#FFF2E2C8"
                                     Foreground="#120918"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border IsVisible="False"
                        CornerRadius="28"
                        Padding="18"
                        BorderBrush="#33DDA36B"
                        BorderThickness="1"
                        Background="#CC090D13">
                    <StackPanel Spacing="13">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="13">
                            <StackPanel Spacing="6">
                                <TextBlock Text="TASTE MEMORY"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           LetterSpacing="2.2"
                                           Foreground="#DDA36B"/>
                                <TextBlock Text="{Binding TasteMemorySummary}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="#E8E1D2"/>
                                <TextBlock Text="{Binding TasteNextMove}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="#7FCAD1"/>
                            </StackPanel>
                            <WrapPanel Grid.Column="1"
                                       Orientation="Horizontal"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       MaxWidth="420">
                                <ComboBox ItemsSource="{Binding TasteRatings}"
                                          SelectedItem="{Binding TasteRating}"
                                          MinWidth="82"
                                          Margin="0,0,8,8"/>
                                <ComboBox ItemsSource="{Binding ContentPackWorlds}"
                                          SelectedItem="{Binding TasteMood}"
                                          MinWidth="124"
                                          Margin="0,0,8,8"/>
                                <Button Content="Save taste"
                                        Command="{Binding SaveTasteMemoryCommand}"
                                        Padding="16,11"
                                        MinWidth="122"
                                        Margin="0,0,8,8"
                                        Background="#DDA36B"
                                        Foreground="#120918"/>
                                <Button Content="Memory"
                                        Command="{Binding OpenTasteMemoryFolderCommand}"
                                        Padding="16,11"
                                        MinWidth="100"
                                        Margin="0,0,0,8"
                                        Background="#211815"
                                        Foreground="#E8E1D2"/>
                            </WrapPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="13">
                            <TextBox Text="{Binding TasteWorked}"
                                     PlaceholderText="What worked?"
                                     MinHeight="82"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding TasteOff}"
                                     PlaceholderText="What was off?"
                                     MinHeight="82"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"/>
                        </Grid>
                        <TextBlock Text="{Binding TasteMemoryStatus}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="#F2C56B"/>
                    </StackPanel>
                </Border>

                <Border IsVisible="False"
                        CornerRadius="28"
                        Padding="18"
                        BorderBrush="#446EE7FF"
                        BorderThickness="1"
                        Background="#CC07111F">
                    <StackPanel Spacing="13">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="13">
                            <StackPanel Spacing="6">
                                <TextBlock Text="LIVE ALBUM"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           LetterSpacing="2.2"
                                           Foreground="#7FCAD1"/>
                                <TextBlock Text="{Binding LiveAlbumEra}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="#E8E1D2"/>
                                <TextBlock Text="{Binding LiveAlbumPlan}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="#DDA36B"/>
                            </StackPanel>
                            <WrapPanel Grid.Column="1"
                                       Orientation="Horizontal"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       MaxWidth="420">
                                <ComboBox ItemsSource="{Binding LiveAlbumScenes}"
                                          SelectedItem="{Binding LiveAlbumScene}"
                                          MinWidth="164"
                                          Margin="0,0,8,8"/>
                                <Button Content="Save note"
                                        Command="{Binding SaveLiveAlbumNoteCommand}"
                                        Padding="16,11"
                                        MinWidth="118"
                                        Margin="0,0,8,8"
                                        Background="#7FCAD1"
                                        Foreground="#120918"/>
                                <Button Content="Folder"
                                        Command="{Binding OpenLiveAlbumFolderCommand}"
                                        Padding="16,11"
                                        MinWidth="92"
                                        Margin="0,0,0,8"
                                        Background="#211815"
                                        Foreground="#E8E1D2"/>
                            </WrapPanel>
                        </Grid>
                        <TextBox Text="{Binding LiveAlbumNote}"
                                 PlaceholderText="What is this session becoming?"
                                 MinHeight="82"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding LiveAlbumStatus}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="#F2C56B"/>
                    </StackPanel>
                </Border>

                <Border IsVisible="False"
                        CornerRadius="28"
                        Padding="18"
                        BorderBrush="#44DDA36B"
                        BorderThickness="1"
                        Background="#D90E1013">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="21">
                        <StackPanel Spacing="8">
                            <TextBlock Text="POST CLIP"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       LetterSpacing="2.2"
                                       Foreground="#DDA36B"/>
                            <TextBlock Text="{Binding VideoLayerTitle}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="#E8E1D2"/>
                            <TextBlock Text="{Binding VideoLayerDetail}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="#7FCAD1"/>
                            <TextBlock Text="{Binding VideoWorkflowStatus}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="#F2C56B"/>
                            <WrapPanel Orientation="Horizontal">
                                <Button Content="Audio earlier"
                                        Command="{Binding AudioEarlierCommand}"
                                        Padding="13,9"
                                        MinWidth="118"
                                        Margin="0,0,8,8"
                                        Background="#211815"
                                        Foreground="#E8E1D2"/>
                                <Border CornerRadius="999"
                                        Padding="13,9"
                                        Margin="0,0,8,8"
                                        BorderBrush="#44DDA36B"
                                        BorderThickness="1"
                                        Background="#99130F16">
                                    <TextBlock Text="{Binding VideoSyncLabel}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#7FCAD1"/>
                                </Border>
                                <Button Content="Audio later"
                                        Command="{Binding AudioLaterCommand}"
                                        Padding="13,9"
                                        MinWidth="108"
                                        Margin="0,0,8,8"
                                        Background="#211815"
                                        Foreground="#E8E1D2"/>
                                <Button Content="Reset"
                                        Command="{Binding ResetVideoSyncCommand}"
                                        Padding="13,9"
                                        MinWidth="76"
                                        Margin="0,0,8,8"
                                        Background="#99130F16"
                                        Foreground="#E8E1D2"/>
                                <Button Content="Auto sync"
                                        Command="{Binding AutoSyncPostClipCommand}"
                                        Padding="13,9"
                                        MinWidth="100"
                                        Margin="0,0,8,8"
                                        Background="#7FCAD1"
                                        Foreground="#120918"/>
                                <Button Content="{Binding VideoExportPresetLabel}"
                                        Command="{Binding ToggleVideoPresetCommand}"
                                        Padding="13,9"
                                        MinWidth="112"
                                        Margin="0,0,8,8"
                                        Background="#DDA36B"
                                        Foreground="#120918"/>
                            </WrapPanel>
                        </StackPanel>
                        <WrapPanel Grid.Column="1"
                                   Orientation="Horizontal"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   MaxWidth="360">
                            <Button Content="Find video"
                                    Command="{Binding FindLatestPhoneVideoCommand}"
                                    Padding="16,11"
                                    MinWidth="118"
                                    Margin="0,0,8,8"
                                    Background="#211815"
                                    Foreground="#E8E1D2"/>
                            <Button Content="Use take audio"
                                    Command="{Binding RenderPhoneVideoWithTakeCommand}"
                                    Padding="16,11"
                                    MinWidth="142"
                                    Margin="0,0,8,8"
                                    Background="#DDA36B"
                                    Foreground="#120918"/>
                            <Button Content="Make post clip"
                                    Command="{Binding MakePostClipCommand}"
                                    Padding="16,11"
                                    MinWidth="150"
                                    Margin="0,0,8,8"
                                    Background="#7FCAD1"
                                    Foreground="#120918"/>
                            <Button Content="Open clip"
                                    Command="{Binding OpenLatestPostClipCommand}"
                                    Padding="16,11"
                                    MinWidth="110"
                                    Margin="0,0,8,8"
                                    Background="#211815"
                                    Foreground="#E8E1D2"/>
                            <Button Content="Exports"
                                    Command="{Binding OpenVideoOutputFolderCommand}"
                                    Padding="16,11"
                                    MinWidth="96"
                                    Margin="0,0,8,8"
                                    Background="#F2EEE3"
                                    Foreground="#120918"/>
                        </WrapPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

