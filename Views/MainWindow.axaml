<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GateKPT.MusicOS.ViewModels"
        xmlns:svc="using:GateKPT.MusicOS.Services"
        xmlns:model="using:GateKPT.MusicOS.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1360"
        d:DesignHeight="860"
        x:Class="GateKPT.MusicOS.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/gatekpt.ico"
        Title="GateKPT Music OS"
        Width="1360"
        Height="860"
        MinWidth="1080"
        MinHeight="720"
        Background="#06111C">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial"/>
        </Style>

        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="LetterSpacing" Value="2"/>
            <Setter Property="Foreground" Value="#C8A96B"/>
        </Style>

        <Style Selector="Border.card">
            <Setter Property="CornerRadius" Value="28"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1DF8F0E5"/>
            <Setter Property="Background" Value="#B00F0C08"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="BoxShadow" Value="0 14 42 0 #52000000"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Opacity" Value="0.84"/>
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="Opacity" Value="0.64"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="CaretBrush" Value="#E37B45"/>
            <Setter Property="SelectionBrush" Value="#66E37B45"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="#E37B45"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="BorderBrush" Value="#26F8F0E5"/>
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="#12F8F0E5"/>
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="#20E37B45"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#06111C" Offset="0"/>
                <GradientStop Color="#0B1B2A" Offset="0.48"/>
                <GradientStop Color="#0D1813" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Ellipse Grid.RowSpan="2" Width="640" Height="640" Fill="#1292BFB3"
                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-280,-320,0,0"/>
        <Ellipse Grid.RowSpan="2" Width="720" Height="720" Fill="#12C6A96D"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-320,-340"/>

        <Border Padding="24,16" BorderBrush="#18E8E1D2" BorderThickness="0,0,0,1" Background="#D006111C">
            <Grid ColumnDefinitions="260,*,Auto" VerticalAlignment="Center" ColumnSpacing="18">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="15">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#E8E1D2" Offset="0"/>
                                <GradientStop Color="#92BFB3" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Image Source="/Assets/gatekpt-icon.png"
                               Width="34"
                               Height="34"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel MinWidth="0">
                        <TextBlock Text="GateKPT" FontSize="16" FontWeight="Black" Foreground="#F8F0E5" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="NIGHT SESSION / ARTIST ARCHIVE" FontSize="10" FontWeight="Bold" Foreground="#92BFB3" LetterSpacing="1.8" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" CornerRadius="999" Background="#0CFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1"
                        Padding="16,8" HorizontalAlignment="Center" MaxWidth="520">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding TodayState}" FontSize="12" FontWeight="Bold" Foreground="#A89B88" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="|" FontSize="12" Foreground="#4DFFFFFF"/>
                        <TextBlock Text="{Binding ToolchainStatus}" FontSize="12" FontWeight="Bold" Foreground="#D9B36F" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" CornerRadius="999" Background="#18E8E1D2" BorderBrush="#2892BFB3" BorderThickness="1" Padding="14,8" MaxWidth="150">
                    <TextBlock Text="{Binding OperatorName}" FontSize="12" FontWeight="Black" Foreground="#E8E1D2" TextTrimming="CharacterEllipsis"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="292,*" Margin="24" ColumnSpacing="21">
            <Border Classes="card" Padding="20" Background="#C4081722" BorderBrush="#2BE8E1D2">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">
                    <StackPanel>
                        <TextBlock Classes="label" Text="NIGHT SESSION"/>
                        <TextBlock Text="{Binding ActiveRoom}"
                                   Margin="0,10,0,0"
                                   FontSize="30"
                                   FontWeight="Black"
                                   TextWrapping="Wrap"
                                   Foreground="#F8F0E5"/>
                        <TextBlock Text="{Binding BusinessMode}"
                                   Margin="0,10,0,0"
                                   FontSize="12"
                                   LineHeight="18"
                                   TextWrapping="Wrap"
                                   Foreground="#958875"/>
                    </StackPanel>

                    <Button Grid.Row="1"
                            Padding="18,11"
                            HorizontalAlignment="Stretch"
                            Background="#F2EADC"
                            Foreground="#15120D"
                            FontWeight="Black"
                            Command="{Binding StartSessionCommand}"
                            Content="Start session"
                            IsVisible="False"/>

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Rooms}"
                             SelectedItem="{Binding SelectedRoom}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:OsRoom">
                                <Border CornerRadius="18" Background="#8F0F0C08" BorderBrush="#14F8F0E5" BorderThickness="1" Padding="11">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Width="34" Height="34" CornerRadius="13" Background="#0EF8F0E5" Margin="0,0,11,0">
                                            <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="11" FontWeight="Black" Foreground="{Binding Accent}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Black" Foreground="#F8F0E5"/>
                                            <TextBlock Text="{Binding Description}" Margin="0,3,0,0" FontSize="10"
                                                       LineHeight="14"
                                                       MaxHeight="30"
                                                       TextWrapping="Wrap" Foreground="#7E7466"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="18">
                <Border IsVisible="{Binding IsPerformanceRevealRoom}"
                        CornerRadius="34"
                        BorderBrush="#36F2EADC"
                        BorderThickness="1"
                        Padding="28"
                        BoxShadow="0 24 80 0 #80000000">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#1E120B" Offset="0"/>
                            <GradientStop Color="#10100C" Offset="0.46"/>
                            <GradientStop Color="#10251F" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="21">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="21">
                            <StackPanel>
                                <TextBlock Text="PERFORMANCE / REVEAL"
                                           FontSize="11"
                                           FontWeight="Black"
                                           Foreground="#F2EADC"
                                           LetterSpacing="3"/>
                                <TextBlock Text="{Binding PerformanceModeStatus}"
                                           Margin="0,8,0,0"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#C8A96B"/>
                            </StackPanel>
                            <WrapPanel Grid.Column="1">
                                <Button Content="Start art feed"
                                        Command="{Binding StartVisualizerFeedCommand}"
                                        Padding="16,10"
                                        Margin="0,0,8,8"
                                        Background="#F2EADC"
                                        Foreground="#15120D"
                                        FontWeight="Black"/>
                                <Button Content="Reveal"
                                        Command="{Binding RevealVisualizerPaintingCommand}"
                                        Padding="16,10"
                                        Margin="0,0,8,8"
                                        Background="#E37B45"
                                        Foreground="#15120D"
                                        FontWeight="Black"/>
                                <Button Content="Blackout"
                                        Command="{Binding ResetVisualizerPaintingCommand}"
                                        Padding="16,10"
                                        Margin="0,0,8,8"
                                        Background="#2B0A0806"
                                        Foreground="#D9C5A5"
                                        FontWeight="Black"/>
                            </WrapPanel>
                        </Grid>

                        <Grid Grid.Row="1" ColumnDefinitions="1.05*,1.25*" ColumnSpacing="21">
                            <Border CornerRadius="28" Background="#A80F0C08" BorderBrush="#22E37B45" BorderThickness="1" Padding="24">
                                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="18">
                                    <TextBlock Text="{Binding LiveCueTitle}"
                                               FontSize="52"
                                               FontWeight="Black"
                                               TextWrapping="Wrap"
                                               Foreground="#F8F0E5"/>
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding LiveCuePrimary}"
                                               FontSize="28"
                                               FontWeight="Black"
                                               TextWrapping="Wrap"
                                               Foreground="#E37B45"/>
                                    <TextBlock Grid.Row="2"
                                               Text="{Binding LiveCueNextMove}"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               LineHeight="30"
                                               TextWrapping="Wrap"
                                               Foreground="#D9C5A5"/>
                                    <WrapPanel Grid.Row="3">
                                        <Button Content="Next section"
                                                Command="{Binding PrimeNextSectionCommand}"
                                                Padding="18,12"
                                                Margin="0,0,8,8"
                                                Background="#F2EADC"
                                                Foreground="#15120D"
                                                FontWeight="Black"/>
                                        <Button Content="Complete section"
                                                Command="{Binding CompleteCurrentSectionCommand}"
                                                Padding="18,12"
                                                Margin="0,0,8,8"
                                                Background="#E37B45"
                                                Foreground="#15120D"
                                                FontWeight="Black"/>
                                        <Button Content="Stamp visual"
                                                Command="{Binding StampCurrentVisualCommand}"
                                                Padding="18,12"
                                                Margin="0,0,8,8"
                                                Background="#6FB6A6"
                                                Foreground="#15120D"
                                                FontWeight="Black"/>
                                    </WrapPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" CornerRadius="34" BorderBrush="#26F8F0E5" BorderThickness="1" Padding="24" MinHeight="520">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                        <GradientStop Color="#3015120D" Offset="0"/>
                                        <GradientStop Color="#241D2A18" Offset="0.35"/>
                                        <GradientStop Color="#10251F1A" Offset="0.72"/>
                                        <GradientStop Color="#090806" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="13">
                                        <StackPanel>
                                            <TextBlock Text="{Binding VisualPaintingTitle}"
                                                       FontSize="38"
                                                       FontWeight="Black"
                                                       TextWrapping="Wrap"
                                                       Foreground="#F8F0E5"/>
                                            <TextBlock Text="{Binding VisualPaintingMood}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="#E37B45"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding InputMeterLabel}"
                                                   FontSize="12"
                                                   Foreground="#9DBFB3"/>
                                    </Grid>

                                    <Grid Grid.Row="1" ClipToBounds="True">
                                        <Border Width="{Binding VisualBloomSize}"
                                                Height="{Binding VisualBloomSize}"
                                                CornerRadius="999"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#26E37B45"/>
                                        <Border Width="{Binding VisualPulseSize}"
                                                Height="{Binding VisualPulseSize}"
                                                CornerRadius="999"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#446FB6A6"/>
                                        <Border Width="144"
                                                Height="144"
                                                CornerRadius="999"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#D9F8F0E5"/>
                                        <Grid VerticalAlignment="Bottom" ColumnDefinitions="*,*,*,*,*,*,*,*" ColumnSpacing="10" Height="120" Margin="0,0,0,8">
                                            <ProgressBar Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding VisualStrokeLevel}" Orientation="Vertical" Foreground="#E37B45" Background="#17120D"/>
                                            <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding InputMeterLevel}" Orientation="Vertical" Foreground="#6FB6A6" Background="#17120D"/>
                                            <ProgressBar Grid.Column="2" Minimum="0" Maximum="100" Value="{Binding VisualizerIntensity}" Orientation="Vertical" Foreground="#EABF7A" Background="#17120D"/>
                                            <ProgressBar Grid.Column="3" Minimum="0" Maximum="100" Value="{Binding VisualStrokeLevel}" Orientation="Vertical" Foreground="#D9C5A5" Background="#17120D"/>
                                            <ProgressBar Grid.Column="4" Minimum="0" Maximum="100" Value="{Binding InputMeterLevel}" Orientation="Vertical" Foreground="#9DBFB3" Background="#17120D"/>
                                            <ProgressBar Grid.Column="5" Minimum="0" Maximum="100" Value="{Binding VisualizerIntensity}" Orientation="Vertical" Foreground="#E37B45" Background="#17120D"/>
                                            <ProgressBar Grid.Column="6" Minimum="0" Maximum="100" Value="{Binding VisualStrokeLevel}" Orientation="Vertical" Foreground="#6FB6A6" Background="#17120D"/>
                                            <ProgressBar Grid.Column="7" Minimum="0" Maximum="100" Value="{Binding InputMeterLevel}" Orientation="Vertical" Foreground="#F2EADC" Background="#17120D"/>
                                        </Grid>
                                    </Grid>

                                    <TextBlock Grid.Row="2"
                                               Text="{Binding VisualPaintingComposition}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"
                                               Foreground="#D9C5A5"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Grid.Row="2" CornerRadius="20" Background="#5515120D" Padding="14">
                            <TextBlock Text="{Binding LiveCueSecondary}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Foreground="#9DBFB3"/>
                        </Border>
                    </Grid>
                </Border>
                <StackPanel IsVisible="{Binding IsWorldMemoryRoom}" Spacing="18">
                    <Border CornerRadius="34"
                            BorderBrush="#338DB7AD"
                            BorderThickness="1"
                            Padding="30"
                            BoxShadow="0 24 70 0 #66000000">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#0B1B2A" Offset="0"/>
                                <GradientStop Color="#07110E" Offset="0.55"/>
                                <GradientStop Color="#17120D" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="21">
                            <StackPanel>
                                <TextBlock Classes="label" Text="WORLD MEMORY"/>
                                <TextBlock Text="Save the signal."
                                           Margin="0,10,0,0"
                                           FontSize="44"
                                           FontWeight="Black"
                                           TextWrapping="Wrap"
                                           Foreground="#F8F0E5"/>
                                <TextBlock Text="{Binding WorldMemorySignal}"
                                           Margin="0,10,0,0"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           Foreground="#8DB7AD"/>
                            </StackPanel>

                            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="13">
                                <Button Content="Phrase"
                                        Command="{Binding PrimeWorldPhraseCommand}"
                                        Padding="18,14"
                                        Background="#8DB7AD"
                                        Foreground="#07110E"
                                        FontWeight="Black"/>
                                <Button Grid.Column="1"
                                        Content="Person / place"
                                        Command="{Binding PrimeWorldPersonPlaceCommand}"
                                        Padding="18,14"
                                        Background="#203C36"
                                        Foreground="#E8E1D2"
                                        FontWeight="Black"/>
                                <Button Grid.Column="2"
                                        Content="Food"
                                        Command="{Binding PrimeWorldFoodCommand}"
                                        Padding="18,14"
                                        Background="#C6A96D"
                                        Foreground="#07110E"
                                        FontWeight="Black"/>
                                <Button Grid.Column="3"
                                        Content="Song seed"
                                        Command="{Binding PrimeWorldSongSeedCommand}"
                                        Padding="18,14"
                                        Background="#E37B45"
                                        Foreground="#15120D"
                                        FontWeight="Black"/>
                            </Grid>

                            <Grid Grid.Row="2" ColumnDefinitions="1.15*,0.85*" ColumnSpacing="21">
                                <Border CornerRadius="28" Padding="21" Background="#D9F8F0E5" BorderBrush="#338DB7AD" BorderThickness="1">
                                    <StackPanel Spacing="13">
                                        <TextBlock Text="{Binding WorldMemoryPrompt}"
                                                   FontSize="13"
                                                   FontWeight="Black"
                                                   TextWrapping="Wrap"
                                                   Foreground="#203C36"/>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="13" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                                            <TextBox Text="{Binding WorldMemoryType}"
                                                     PlaceholderText="Type: field sound, phrase, cover seed"
                                                     MinHeight="44"/>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding WorldMemoryLanguage}"
                                                     PlaceholderText="Language"
                                                     MinHeight="44"/>
                                            <TextBox Grid.Row="1"
                                                     Text="{Binding WorldMemoryPhrase}"
                                                     PlaceholderText="Phrase / hook / field sound"
                                                     MinHeight="44"/>
                                            <TextBox Grid.Row="1"
                                                     Grid.Column="1"
                                                     Text="{Binding WorldMemoryMeaning}"
                                                     PlaceholderText="Meaning"
                                                     MinHeight="44"/>
                                            <TextBox Grid.Row="2"
                                                     Text="{Binding WorldMemoryPlace}"
                                                     PlaceholderText="Place"
                                                     MinHeight="44"/>
                                            <TextBox Grid.Row="2"
                                                     Grid.Column="1"
                                                     Text="{Binding WorldMemoryPerson}"
                                                     PlaceholderText="Person"
                                                     MinHeight="44"/>
                                            <TextBox Grid.Row="3"
                                                     Text="{Binding WorldMemoryFood}"
                                                     PlaceholderText="Ritual / food / reset"
                                                     MinHeight="44"/>
                                            <TextBox Grid.Row="3"
                                                     Grid.Column="1"
                                                     Text="{Binding WorldMemoryRhythm}"
                                                     PlaceholderText="Rhythm / instrument / preset"
                                                     MinHeight="44"/>
                                        </Grid>
                                        <TextBox Text="{Binding WorldMemorySongIdea}"
                                                 PlaceholderText="Cover, hook, visual, or post idea"
                                                 MinHeight="44"/>
                                        <TextBox Text="{Binding WorldMemoryNotes}"
                                                 PlaceholderText="Trail, lake, storm, room, car, gym, pressure, language, or feeling..."
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="110"/>
                                        <WrapPanel>
                                            <Button Content="Save memory"
                                                    Command="{Binding SaveWorldMemoryCommand}"
                                                    Padding="18,12"
                                                    Margin="0,0,8,8"
                                                    Background="#07110E"
                                                    Foreground="#E8E1D2"
                                                    FontWeight="Black"/>
                                            <Button Content="Clear"
                                                    Command="{Binding ClearWorldMemoryCommand}"
                                                    Padding="18,12"
                                                    Margin="0,0,8,8"
                                                    Background="#203C36"
                                                    Foreground="#E8E1D2"
                                                    FontWeight="Black"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" CornerRadius="28" Padding="21" Background="#A807110E" BorderBrush="#22F8F0E5" BorderThickness="1">
                                    <StackPanel Spacing="13">
                                        <TextBlock Text="RECENT MEMORY"
                                                   FontSize="11"
                                                   FontWeight="Black"
                                                   LetterSpacing="2.5"
                                                   Foreground="#C6A96D"/>
                                        <ItemsControl ItemsSource="{Binding WorldMemories}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:WorldMemoryItem">
                                                    <Border CornerRadius="18" Padding="13" Margin="0,0,0,10" Background="#13000000" BorderBrush="#1F8DB7AD" BorderThickness="1">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Black" Foreground="#F8F0E5"/>
                                                            <TextBlock Text="{Binding Summary}" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="#9DBFB3"/>
                                                            <TextBlock Text="{Binding CreatedAt}" Margin="0,5,0,0" FontSize="10" FontWeight="Black" Foreground="#C6A96D"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
                <StackPanel IsVisible="{Binding IsContentLabRoom}" Spacing="18">
                    <Border CornerRadius="34"
                            BorderBrush="#36C6A96D"
                            BorderThickness="1"
                            Padding="30"
                            BoxShadow="0 24 70 0 #66000000">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#0B1B2A" Offset="0"/>
                                <GradientStop Color="#07110E" Offset="0.55"/>
                                <GradientStop Color="#1C160B" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="21">
                            <StackPanel>
                                <TextBlock Classes="label" Text="CONTENT LAB"/>
                                <TextBlock Text="Grow the audience one honest clip at a time."
                                           Margin="0,10,0,0"
                                           FontSize="42"
                                           FontWeight="Black"
                                           TextWrapping="Wrap"
                                           Foreground="#F8F0E5"/>
                                <TextBlock Text="Not monetization first. Build proof: cover, field note, visual, caption, post."
                                           Margin="0,10,0,0"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           Foreground="#8DB7AD"/>
                            </StackPanel>

                            <Grid Grid.Row="1" ColumnDefinitions="1.1*,0.9*" ColumnSpacing="21">
                                <Border CornerRadius="28" Padding="21" Background="#D9F8F0E5" BorderBrush="#33C6A96D" BorderThickness="1">
                                    <StackPanel Spacing="13">
                                        <TextBlock Text="{Binding ContentPlanSummary}"
                                                   FontSize="13"
                                                   FontWeight="Black"
                                                   TextWrapping="Wrap"
                                                   Foreground="#203C36"/>
                                        <Border CornerRadius="18" Padding="13" Background="#1907110E" BorderBrush="#338DB7AD" BorderThickness="1">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{Binding ContentEngineFormula}"
                                                           FontSize="13"
                                                           FontWeight="Black"
                                                           TextWrapping="Wrap"
                                                           Foreground="#203C36"/>
                                                <TextBlock Text="{Binding ContentAudiencePromise}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           Foreground="#35544D"/>
                                            </StackPanel>
                                        </Border>
                                        <Border CornerRadius="18" Padding="13" Background="#2107110E" BorderBrush="#44C6A96D" BorderThickness="1">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="MISSION"
                                                           FontSize="10"
                                                           FontWeight="Black"
                                                           LetterSpacing="1.8"
                                                           Foreground="#806A3F"/>
                                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                                                    <TextBox Text="{Binding ContentMission}"
                                                             PlaceholderText="Mission"
                                                             MinHeight="44"/>
                                                    <TextBox Grid.Column="1"
                                                             Text="{Binding ContentTone}"
                                                             PlaceholderText="Tone: playful, romantic, goofy, noble"
                                                             MinHeight="44"/>
                                                    <TextBox Grid.Row="1"
                                                             Grid.ColumnSpan="2"
                                                             Text="{Binding ContentPreset}"
                                                             PlaceholderText="Preset direction"
                                                             MinHeight="44"/>
                                                </Grid>
                                                <TextBlock Text="{Binding ContentMissionGuide}"
                                                           FontSize="12"
                                                           FontWeight="Black"
                                                           TextWrapping="Wrap"
                                                           Foreground="#35544D"/>
                                            </StackPanel>
                                        </Border>
                                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                                            <TextBox Text="{Binding ContentLanguage}"
                                                     PlaceholderText="Language: English, Spanish, Korean, Italian"
                                                     MinHeight="44"/>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding ContentTerrain}"
                                                     PlaceholderText="Terrain: car, trail, lake, parking lot, room, gym, storm"
                                                     MinHeight="44"/>
                                            <TextBox Grid.Row="1"
                                                     Text="{Binding ContentPillar}"
                                                     PlaceholderText="Pillar: Cover, Process, World, Look, Build"
                                                     MinHeight="44"/>
                                            <TextBox Grid.Row="1"
                                                     Grid.Column="1"
                                                     Text="{Binding ContentPostStatus}"
                                                     PlaceholderText="Post status"
                                                     MinHeight="44"/>
                                            <TextBox Grid.Row="2"
                                                     Text="{Binding ContentCta}"
                                                     PlaceholderText="CTA/question"
                                                     MinHeight="44"/>
                                            <TextBox Grid.Row="2"
                                                     Grid.Column="1"
                                                     Text="{Binding ContentHashtags}"
                                                     PlaceholderText="Hashtags"
                                                     MinHeight="44"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                            <Border CornerRadius="18" Padding="13" Background="#1407110E" BorderBrush="#338DB7AD" BorderThickness="1">
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="RECORD"
                                                               FontSize="10"
                                                               FontWeight="Black"
                                                               LetterSpacing="1.8"
                                                               Foreground="#806A3F"/>
                                                    <TextBlock Text="{Binding ContentRecordingPlan}"
                                                               FontSize="12"
                                                               FontWeight="Black"
                                                               TextWrapping="Wrap"
                                                               Foreground="#203C36"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" CornerRadius="18" Padding="13" Background="#1407110E" BorderBrush="#338DB7AD" BorderThickness="1">
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="PLATFORM"
                                                               FontSize="10"
                                                               FontWeight="Black"
                                                               LetterSpacing="1.8"
                                                               Foreground="#806A3F"/>
                                                    <TextBlock Text="{Binding ContentPlatformPlan}"
                                                               FontSize="12"
                                                               FontWeight="Black"
                                                               TextWrapping="Wrap"
                                                               Foreground="#203C36"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" CornerRadius="18" Padding="13" Background="#1407110E" BorderBrush="#338DB7AD" BorderThickness="1">
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="SHOT"
                                                               FontSize="10"
                                                               FontWeight="Black"
                                                               LetterSpacing="1.8"
                                                               Foreground="#806A3F"/>
                                                    <TextBlock Text="{Binding ContentShotPlan}"
                                                               FontSize="12"
                                                               FontWeight="Black"
                                                               TextWrapping="Wrap"
                                                               Foreground="#203C36"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="13" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                                            <TextBox Text="{Binding ContentSeries}"
                                                     PlaceholderText="Series: Raw to Chrome, After Work Covers"
                                                     MinHeight="44"/>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding ContentFormat}"
                                                     PlaceholderText="Format: cover, drums, guitar, vocal, visual"
                                                     MinHeight="44"/>
                                            <TextBox Grid.Row="1"
                                                     Grid.ColumnSpan="2"
                                                     Text="{Binding ContentPlatform}"
                                                     PlaceholderText="Platform: Snapchat, TikTok, Reels, YouTube"
                                                     MinHeight="44"/>
                                            <TextBox Grid.Row="2"
                                                     Text="{Binding ContentSetting}"
                                                     PlaceholderText="Setting: trail, lake, car, room, storm"
                                                     MinHeight="44"/>
                                            <TextBox Grid.Row="2"
                                                     Grid.Column="1"
                                                     Text="{Binding ContentSong}"
                                                     PlaceholderText="Song / cover / hook"
                                                     MinHeight="44"/>
                                            <TextBox Grid.Row="3"
                                                     Grid.ColumnSpan="2"
                                                     Text="{Binding ContentHook}"
                                                     PlaceholderText="Hook line"
                                                     MinHeight="44"/>
                                        </Grid>
                                        <TextBox Text="{Binding ContentCaption}"
                                                 PlaceholderText="Caption seed"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="76"/>
                                        <TextBox Text="{Binding ContentVisualDirection}"
                                                 PlaceholderText="Visual direction"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="76"/>
                                        <TextBox Text="{Binding ContentNextAction}"
                                                 PlaceholderText="Next action"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="76"/>
                                        <WrapPanel>
                                            <Button Content="Raw to Chrome"
                                                    Command="{Binding PrimeRawToChromeCommand}"
                                                    Padding="18,12"
                                                    Margin="0,0,8,8"
                                                    Background="#8DB7AD"
                                                    Foreground="#07110E"
                                                    FontWeight="Black"/>
                                            <Button Content="After work"
                                                    Command="{Binding PrimeAfterWorkContentCommand}"
                                                    Padding="18,12"
                                                    Margin="0,0,8,8"
                                                    Background="#203C36"
                                                    Foreground="#E8E1D2"
                                                    FontWeight="Black"/>
                                            <Button Content="Guitar cover"
                                                    Command="{Binding PrimeRawGuitarCoverCommand}"
                                                    Padding="18,12"
                                                    Margin="0,0,8,8"
                                                    Background="#D9F8F0E5"
                                                    Foreground="#07110E"
                                                    FontWeight="Black"/>
                                            <Button Content="Goofy hook"
                                                    Command="{Binding PrimeGoofyHookSeedCommand}"
                                                    Padding="18,12"
                                                    Margin="0,0,8,8"
                                                    Background="#203C36"
                                                    Foreground="#E8E1D2"
                                                    FontWeight="Black"/>
                                            <Button Content="Spanish line"
                                                    Command="{Binding PrimeSpanishColorLineCommand}"
                                                    Padding="18,12"
                                                    Margin="0,0,8,8"
                                                    Background="#8DB7AD"
                                                    Foreground="#07110E"
                                                    FontWeight="Black"/>
                                            <Button Content="Field note"
                                                    Command="{Binding PrimeFloridaFieldNoteCommand}"
                                                    Padding="18,12"
                                                    Margin="0,0,8,8"
                                                    Background="#D9F8F0E5"
                                                    Foreground="#07110E"
                                                    FontWeight="Black"/>
                                            <Button Content="Phone cover"
                                                    Command="{Binding PrimePhoneVideoCoverCommand}"
                                                    Padding="18,12"
                                                    Margin="0,0,8,8"
                                                    Background="#203C36"
                                                    Foreground="#E8E1D2"
                                                    FontWeight="Black"/>
                                            <Button Content="Noble note"
                                                    Command="{Binding PrimeNobleNoteCommand}"
                                                    Padding="18,12"
                                                    Margin="0,0,8,8"
                                                    Background="#07110E"
                                                    Foreground="#E8E1D2"
                                                    FontWeight="Black"/>
                                            <Button Content="Generate post"
                                                    Command="{Binding GenerateContentPlanCommand}"
                                                    Padding="18,12"
                                                    Margin="0,0,8,8"
                                                    Background="#C6A96D"
                                                    Foreground="#07110E"
                                                    FontWeight="Black"/>
                                            <Button Content="Use latest memory"
                                                    Command="{Binding PrimeContentFromWorldMemoryCommand}"
                                                    Padding="18,12"
                                                    Margin="0,0,8,8"
                                                    Background="#D9F8F0E5"
                                                    Foreground="#07110E"
                                                    FontWeight="Black"/>
                                            <Button Content="Save to GateKPT"
                                                    Command="{Binding SaveContentPlanCommand}"
                                                    Padding="18,12"
                                                    Margin="0,0,8,8"
                                                    Background="#07110E"
                                                    Foreground="#E8E1D2"
                                                    FontWeight="Black"/>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding ContentPlanStatus}"
                                                   FontSize="12"
                                                   FontWeight="Black"
                                                   TextWrapping="Wrap"
                                                   Foreground="#203C36"/>
                                        <TextBlock Text="{Binding ContentTonightSequence}"
                                                   FontSize="12"
                                                   FontWeight="Black"
                                                   TextWrapping="Wrap"
                                                   Foreground="#806A3F"/>
                                        <Border CornerRadius="18" Padding="13" Background="#1407110E" BorderBrush="#338DB7AD" BorderThickness="1">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="POST PACK"
                                                           FontSize="10"
                                                           FontWeight="Black"
                                                           LetterSpacing="1.8"
                                                           Foreground="#806A3F"/>
                                                <TextBlock Text="{Binding ContentPostPackPreview}"
                                                           FontSize="12"
                                                           FontWeight="Black"
                                                           TextWrapping="Wrap"
                                                           Foreground="#203C36"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" CornerRadius="28" Padding="21" Background="#A807110E" BorderBrush="#22F8F0E5" BorderThickness="1">
                                    <StackPanel Spacing="13">
                                        <TextBlock Text="CONTENT PATH"
                                                   FontSize="11"
                                                   FontWeight="Black"
                                                   LetterSpacing="2.5"
                                                   Foreground="#C6A96D"/>
                                        <Border CornerRadius="18" Padding="13" Background="#19000000" BorderBrush="#228DB7AD" BorderThickness="1">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="TONIGHT POST"
                                                           FontSize="10"
                                                           FontWeight="Black"
                                                           LetterSpacing="2.2"
                                                           Foreground="#C6A96D"/>
                                                <TextBlock Text="{Binding ContentSprintBrief}"
                                                           FontSize="12"
                                                           FontWeight="Black"
                                                           TextWrapping="Wrap"
                                                           Foreground="#9DBFB3"/>
                                                <TextBlock Text="{Binding ContentSprintPack}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           Foreground="#D9C5A5"/>
                                                <TextBlock Text="{Binding ContentSprintStatus}"
                                                           FontSize="11"
                                                           FontWeight="Black"
                                                           TextWrapping="Wrap"
                                                           Foreground="#C6A96D"/>
                                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                                    <TextBox Text="{Binding ContentSprintAngle}"
                                                             PlaceholderText="Clip angle"
                                                             MinHeight="40"/>
                                                    <TextBox Grid.Column="1"
                                                             Text="{Binding ContentSprintLength}"
                                                             PlaceholderText="Length"
                                                             MinHeight="40"/>
                                                    <TextBox Grid.Row="1"
                                                             Grid.ColumnSpan="2"
                                                             Text="{Binding ContentSprintOpeningFrame}"
                                                             PlaceholderText="Opening frame"
                                                             MinHeight="40"/>
                                                </Grid>
                                                <TextBox Text="{Binding ContentSprintSteps}"
                                                         PlaceholderText="Steps for this post"
                                                         TextWrapping="Wrap"
                                                         MinHeight="44"/>
                                                <WrapPanel>
                                                    <Button Content="Generate tonight"
                                                            Command="{Binding GenerateContentSprintCommand}"
                                                            Padding="13,9"
                                                            Margin="0,0,8,8"
                                                            Background="#C6A96D"
                                                            Foreground="#07110E"
                                                            FontWeight="Black"/>
                                                    <Button Content="Use latest"
                                                            Command="{Binding PrimeSprintFromLatestTakeCommand}"
                                                            Padding="13,9"
                                                            Margin="0,0,8,8"
                                                            Background="#8DB7AD"
                                                            Foreground="#07110E"
                                                            FontWeight="Black"/>
                                                    <Button Content="Copy"
                                                            Command="{Binding CopyContentSprintCommand}"
                                                            Padding="13,9"
                                                            Margin="0,0,8,8"
                                                            Background="#07110E"
                                                            Foreground="#E8E1D2"
                                                            FontWeight="Black"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border CornerRadius="18" Padding="13" Background="#19000000" BorderBrush="#228DB7AD" BorderThickness="1">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="MOMENTUM / ROTATION"
                                                           FontSize="10"
                                                           FontWeight="Black"
                                                           LetterSpacing="2.2"
                                                           Foreground="#C6A96D"/>
                                                <TextBlock Text="{Binding MomentumSummary}"
                                                           FontSize="12"
                                                           FontWeight="Black"
                                                           TextWrapping="Wrap"
                                                           Foreground="#9DBFB3"/>
                                                <TextBlock Text="{Binding VarietyGuardSignal}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           Foreground="#D9C5A5"/>
                                                <TextBlock Text="{Binding NextVariationSignal}"
                                                           FontSize="11"
                                                           FontWeight="Black"
                                                           TextWrapping="Wrap"
                                                           Foreground="#C6A96D"/>
                                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                                    <TextBox Text="{Binding MomentumPlatform}"
                                                             PlaceholderText="Platform"
                                                             MinHeight="40"/>
                                                    <TextBox Grid.Column="1"
                                                             Text="{Binding MomentumVideoTitle}"
                                                             PlaceholderText="Video title"
                                                             MinHeight="40"/>
                                                    <TextBox Grid.Row="1"
                                                             Text="{Binding MomentumViews}"
                                                             PlaceholderText="Views"
                                                             MinHeight="40"/>
                                                    <TextBox Grid.Row="1"
                                                             Grid.Column="1"
                                                             Text="{Binding MomentumComments}"
                                                             PlaceholderText="Comments"
                                                             MinHeight="40"/>
                                                    <TextBox Grid.Row="2"
                                                             Grid.ColumnSpan="2"
                                                             Text="{Binding MomentumBestComment}"
                                                             PlaceholderText="Best comment / audience note"
                                                             MinHeight="40"/>
                                                </Grid>
                                                <TextBox Text="{Binding MomentumAudienceSignal}"
                                                         PlaceholderText="What did people respond to?"
                                                         TextWrapping="Wrap"
                                                         MinHeight="44"/>
                                                <TextBox Text="{Binding MomentumNextPost}"
                                                         PlaceholderText="Follow-up idea"
                                                         TextWrapping="Wrap"
                                                         MinHeight="44"/>
                                                <WrapPanel>
                                                    <Button Content="Save signal"
                                                            Command="{Binding SaveVideoMomentumCommand}"
                                                            Padding="13,9"
                                                            Margin="0,0,8,8"
                                                            Background="#8DB7AD"
                                                            Foreground="#07110E"
                                                            FontWeight="Black"/>
                                                    <Button Content="Follow-up"
                                                            Command="{Binding GenerateMomentumFollowUpCommand}"
                                                            Padding="13,9"
                                                            Margin="0,0,8,8"
                                                            Background="#C6A96D"
                                                            Foreground="#07110E"
                                                            FontWeight="Black"/>
                                                    <Button Content="Rotate"
                                                            Command="{Binding RotateContentLaneCommand}"
                                                            Padding="13,9"
                                                            Margin="0,0,8,8"
                                                            Background="#07110E"
                                                            Foreground="#E8E1D2"
                                                            FontWeight="Black"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border CornerRadius="18" Padding="13" Background="#19000000" BorderBrush="#228DB7AD" BorderThickness="1">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="SOUND TASTE MAP"
                                                           FontSize="10"
                                                           FontWeight="Black"
                                                           LetterSpacing="2.2"
                                                           Foreground="#C6A96D"/>
                                                <TextBlock Text="{Binding SoundTasteSummary}"
                                                           FontSize="12"
                                                           FontWeight="Black"
                                                           TextWrapping="Wrap"
                                                           Foreground="#9DBFB3"/>
                                                <TextBlock Text="{Binding SoundTasteNextMove}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           Foreground="#D9C5A5"/>
                                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                                    <TextBox Text="{Binding TasteLaneName}"
                                                             PlaceholderText="Lane name"
                                                             MinHeight="40"/>
                                                    <TextBox Grid.Column="1"
                                                             Text="{Binding TasteReferenceSongs}"
                                                             PlaceholderText="References"
                                                             MinHeight="40"/>
                                                    <TextBox Grid.Row="1"
                                                             Text="{Binding TasteBeatFeel}"
                                                             PlaceholderText="Beat feel"
                                                             MinHeight="40"/>
                                                    <TextBox Grid.Row="1"
                                                             Grid.Column="1"
                                                             Text="{Binding TasteTempoRange}"
                                                             PlaceholderText="Tempo"
                                                             MinHeight="40"/>
                                                    <TextBox Grid.Row="2"
                                                             Text="{Binding TasteFitScore}"
                                                             PlaceholderText="Fit 1-10"
                                                             MinHeight="40"/>
                                                    <TextBox Grid.Row="2"
                                                             Grid.Column="1"
                                                             Text="{Binding TasteMemorabilityScore}"
                                                             PlaceholderText="Memory 1-10"
                                                             MinHeight="40"/>
                                                </Grid>
                                                <TextBox Text="{Binding TasteVocalEnergy}"
                                                         PlaceholderText="Vocal energy"
                                                         TextWrapping="Wrap"
                                                         MinHeight="44"/>
                                                <TextBox Text="{Binding TasteLyricThemes}"
                                                         PlaceholderText="Lyric themes"
                                                         TextWrapping="Wrap"
                                                         MinHeight="44"/>
                                                <TextBox Text="{Binding TasteVisualEnergy}"
                                                         PlaceholderText="Visual energy"
                                                         TextWrapping="Wrap"
                                                         MinHeight="44"/>
                                                <TextBox Text="{Binding TasteAvoid}"
                                                         PlaceholderText="Avoid"
                                                         TextWrapping="Wrap"
                                                         MinHeight="44"/>
                                                <WrapPanel>
                                                    <Button Content="Add lane"
                                                            Command="{Binding AddSoundTasteLaneCommand}"
                                                            Padding="13,9"
                                                            Margin="0,0,8,8"
                                                            Background="#8DB7AD"
                                                            Foreground="#07110E"
                                                            FontWeight="Black"/>
                                                    <Button Content="Use lane"
                                                            Command="{Binding PrimeContentFromTasteLaneCommand}"
                                                            Padding="13,9"
                                                            Margin="0,0,8,8"
                                                            Background="#C6A96D"
                                                            Foreground="#07110E"
                                                            FontWeight="Black"/>
                                                    <Button Content="Rotate lane"
                                                            Command="{Binding RotateTasteLaneCommand}"
                                                            Padding="13,9"
                                                            Margin="0,0,8,8"
                                                            Background="#07110E"
                                                            Foreground="#E8E1D2"
                                                            FontWeight="Black"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border CornerRadius="18" Padding="13" Background="#19000000" BorderBrush="#228DB7AD" BorderThickness="1">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="COVER RADAR"
                                                           FontSize="10"
                                                           FontWeight="Black"
                                                           LetterSpacing="2.2"
                                                           Foreground="#C6A96D"/>
                                                <TextBlock Text="{Binding CoverRadarSummary}"
                                                           FontSize="12"
                                                           FontWeight="Black"
                                                           TextWrapping="Wrap"
                                                           Foreground="#9DBFB3"/>
                                                <TextBlock Text="{Binding NextCoverTestSignal}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           Foreground="#D9C5A5"/>
                                                <TextBlock Text="{Binding CoverRadarPlan}"
                                                           FontSize="11"
                                                           FontWeight="Black"
                                                           TextWrapping="Wrap"
                                                           Foreground="#C6A96D"/>
                                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                                    <TextBox Text="{Binding CoverSignalSong}"
                                                             PlaceholderText="Song people mention"
                                                             MinHeight="40"/>
                                                    <TextBox Grid.Column="1"
                                                             Text="{Binding CoverSignalArtist}"
                                                             PlaceholderText="Artist"
                                                             MinHeight="40"/>
                                                    <TextBox Grid.Row="1"
                                                             Text="{Binding CoverSignalSuggestedBy}"
                                                             PlaceholderText="Suggested by"
                                                             MinHeight="40"/>
                                                    <TextBox Grid.Row="1"
                                                             Grid.Column="1"
                                                             Text="{Binding CoverSignalVocalLane}"
                                                             PlaceholderText="Raw Clean / Chrome / Luna"
                                                             MinHeight="40"/>
                                                    <TextBox Grid.Row="2"
                                                             Text="{Binding CoverSignalVoiceFitScore}"
                                                             PlaceholderText="Voice 1-10"
                                                             MinHeight="40"/>
                                                    <TextBox Grid.Row="2"
                                                             Grid.Column="1"
                                                             Text="{Binding CoverSignalAudienceScore}"
                                                             PlaceholderText="Audience 0-10"
                                                             MinHeight="40"/>
                                                </Grid>
                                                <TextBox Text="{Binding CoverSignalFitReason}"
                                                         PlaceholderText="Why it might fit your voice"
                                                         TextWrapping="Wrap"
                                                         MinHeight="44"/>
                                                <TextBox Text="{Binding CoverSignalTestHook}"
                                                         PlaceholderText="What 30-second part to test"
                                                         TextWrapping="Wrap"
                                                         MinHeight="44"/>
                                                <WrapPanel>
                                                    <Button Content="Add signal"
                                                            Command="{Binding AddCoverSignalCommand}"
                                                            Padding="13,9"
                                                            Margin="0,0,8,8"
                                                            Background="#8DB7AD"
                                                            Foreground="#07110E"
                                                            FontWeight="Black"/>
                                                    <Button Content="Prime test"
                                                            Command="{Binding PrimeTopCoverSignalCommand}"
                                                            Padding="13,9"
                                                            Margin="0,0,8,8"
                                                            Background="#C6A96D"
                                                            Foreground="#07110E"
                                                            FontWeight="Black"/>
                                                    <Button Content="Tested"
                                                            Command="{Binding MarkTopCoverTestedCommand}"
                                                            Padding="13,9"
                                                            Margin="0,0,8,8"
                                                            Background="#07110E"
                                                            Foreground="#E8E1D2"
                                                            FontWeight="Black"/>
                                                </WrapPanel>
                                                <ItemsControl ItemsSource="{Binding CoverSignals}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="model:CoverSignalItem">
                                                            <Border CornerRadius="14"
                                                                    Padding="10"
                                                                    Margin="0,0,0,8"
                                                                    Background="#13000000"
                                                                    BorderBrush="#1F8DB7AD"
                                                                    BorderThickness="1">
                                                                <StackPanel Spacing="4">
                                                                    <TextBlock Text="{Binding SongTitle}"
                                                                               FontSize="12"
                                                                               FontWeight="Black"
                                                                               TextWrapping="Wrap"
                                                                               Foreground="#F8F0E5"/>
                                                                    <TextBlock Text="{Binding Artist}"
                                                                               FontSize="10"
                                                                               FontWeight="Black"
                                                                               Foreground="#C6A96D"/>
                                                                    <TextBlock Text="{Binding FitReason}"
                                                                               FontSize="10"
                                                                               TextWrapping="Wrap"
                                                                               Foreground="#9DBFB3"/>
                                                                    <TextBlock Text="{Binding Status}"
                                                                               FontSize="10"
                                                                               FontWeight="Black"
                                                                               Foreground="#D9C5A5"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                        <Border CornerRadius="18" Padding="13" Background="#19000000" BorderBrush="#228DB7AD" BorderThickness="1">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="SONG STUDY"
                                                           FontSize="10"
                                                           FontWeight="Black"
                                                           LetterSpacing="2.2"
                                                           Foreground="#C6A96D"/>
                                                <TextBlock Text="{Binding SongStudySummary}"
                                                           FontSize="12"
                                                           FontWeight="Black"
                                                           TextWrapping="Wrap"
                                                           Foreground="#9DBFB3"/>
                                                <TextBlock Text="{Binding SongStudyNextMove}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           Foreground="#D9C5A5"/>
                                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                                    <TextBox Text="{Binding SongStudyTitle}"
                                                             PlaceholderText="Top song"
                                                             MinHeight="40"/>
                                                    <TextBox Grid.Column="1"
                                                             Text="{Binding SongStudyArtist}"
                                                             PlaceholderText="Artist"
                                                             MinHeight="40"/>
                                                    <TextBox Grid.Row="1"
                                                             Text="{Binding SongStudySource}"
                                                             PlaceholderText="Chart/source"
                                                             MinHeight="40"/>
                                                    <TextBox Grid.Row="1"
                                                             Grid.Column="1"
                                                             Text="{Binding SongStudyRank}"
                                                             PlaceholderText="Rank"
                                                             MinHeight="40"/>
                                                    <TextBox Grid.Row="2"
                                                             Text="{Binding SongStudyGenreLane}"
                                                             PlaceholderText="Genre lane"
                                                             MinHeight="40"/>
                                                    <TextBox Grid.Row="2"
                                                             Grid.Column="1"
                                                             Text="{Binding SongStudyCoverFit}"
                                                             PlaceholderText="Cover fit"
                                                             MinHeight="40"/>
                                                </Grid>
                                                <TextBox Text="{Binding SongStudyThemes}"
                                                         PlaceholderText="Themes, not copied lyrics"
                                                         TextWrapping="Wrap"
                                                         MinHeight="44"/>
                                                <TextBox Text="{Binding SongStudyHookMechanics}"
                                                         PlaceholderText="Hook mechanics"
                                                         TextWrapping="Wrap"
                                                         MinHeight="44"/>
                                                <TextBox Text="{Binding SongStudyImagery}"
                                                         PlaceholderText="Imagery / world"
                                                         TextWrapping="Wrap"
                                                         MinHeight="44"/>
                                                <TextBox Text="{Binding SongStudyContentUse}"
                                                         PlaceholderText="How this helps content"
                                                         TextWrapping="Wrap"
                                                         MinHeight="44"/>
                                                <WrapPanel>
                                                    <Button Content="Add study"
                                                            Command="{Binding AddSongStudyCommand}"
                                                            Padding="13,9"
                                                            Margin="0,0,8,8"
                                                            Background="#8DB7AD"
                                                            Foreground="#07110E"
                                                            FontWeight="Black"/>
                                                    <Button Content="Cover test"
                                                            Command="{Binding PrimeCoverFromSongStudyCommand}"
                                                            Padding="13,9"
                                                            Margin="0,0,8,8"
                                                            Background="#C6A96D"
                                                            Foreground="#07110E"
                                                            FontWeight="Black"/>
                                                    <Button Content="Original seed"
                                                            Command="{Binding PrimeOriginalFromSongStudyCommand}"
                                                            Padding="13,9"
                                                            Margin="0,0,8,8"
                                                            Background="#07110E"
                                                            Foreground="#E8E1D2"
                                                            FontWeight="Black"/>
                                                </WrapPanel>
                                                <ItemsControl ItemsSource="{Binding SongStudies}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="model:SongStudyItem">
                                                            <Border CornerRadius="14"
                                                                    Padding="10"
                                                                    Margin="0,0,0,8"
                                                                    Background="#13000000"
                                                                    BorderBrush="#1F8DB7AD"
                                                                    BorderThickness="1">
                                                                <StackPanel Spacing="4">
                                                                    <TextBlock Text="{Binding SongTitle}"
                                                                               FontSize="12"
                                                                               FontWeight="Black"
                                                                               TextWrapping="Wrap"
                                                                               Foreground="#F8F0E5"/>
                                                                    <TextBlock Text="{Binding Artist}"
                                                                               FontSize="10"
                                                                               FontWeight="Black"
                                                                               Foreground="#C6A96D"/>
                                                                    <TextBlock Text="{Binding HookMechanics}"
                                                                               FontSize="10"
                                                                               TextWrapping="Wrap"
                                                                               Foreground="#9DBFB3"/>
                                                                    <TextBlock Text="{Binding Status}"
                                                                               FontSize="10"
                                                                               FontWeight="Black"
                                                                               Foreground="#D9C5A5"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                        <Border CornerRadius="18" Padding="13" Background="#19000000" BorderBrush="#228DB7AD" BorderThickness="1">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="EP SEED"
                                                           FontSize="10"
                                                           FontWeight="Black"
                                                           LetterSpacing="2.2"
                                                           Foreground="#C6A96D"/>
                                                <TextBlock Text="{Binding ContentEpPlanSignal}"
                                                           FontSize="12"
                                                           FontWeight="Black"
                                                           TextWrapping="Wrap"
                                                           Foreground="#9DBFB3"/>
                                                <TextBlock Text="{Binding ContentEpTrackMapSignal}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           Foreground="#D9C5A5"/>
                                                <TextBlock Text="{Binding ContentWeekendPackSignal}"
                                                           FontSize="11"
                                                           FontWeight="Black"
                                                           TextWrapping="Wrap"
                                                           Foreground="#C6A96D"/>
                                                <WrapPanel>
                                                    <Button Content="Track 1"
                                                            Command="{Binding PrimeOrangeCountyGlowCommand}"
                                                            Padding="13,9"
                                                            Margin="0,0,8,8"
                                                            Background="#C6A96D"
                                                            Foreground="#07110E"
                                                            FontWeight="Black"/>
                                                    <Button Content="Weekend pack"
                                                            Command="{Binding PrimeWeekendPackCommand}"
                                                            Padding="13,9"
                                                            Margin="0,0,8,8"
                                                            Background="#203C36"
                                                            Foreground="#E8E1D2"
                                                            FontWeight="Black"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border CornerRadius="18" Padding="13" Background="#19000000" BorderBrush="#228DB7AD" BorderThickness="1">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="ARCHIVE REVIEW"
                                                           FontSize="10"
                                                           FontWeight="Black"
                                                           LetterSpacing="2.2"
                                                           Foreground="#C6A96D"/>
                                                <TextBlock Text="{Binding ContentArchiveReviewSummary}"
                                                           FontSize="12"
                                                           FontWeight="Black"
                                                           TextWrapping="Wrap"
                                                           Foreground="#9DBFB3"/>
                                                <TextBlock Text="{Binding ContentReviewNote}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           Foreground="#D9C5A5"/>
                                                <TextBlock Text="{Binding BestArtistSessionSignal}"
                                                           FontSize="11"
                                                           FontWeight="Black"
                                                           TextWrapping="Wrap"
                                                           Foreground="#C6A96D"/>
                                                <TextBlock Text="{Binding ArtistWeeklyReviewSignal}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           Foreground="#9DBFB3"/>
                                                <TextBlock Text="{Binding NextArtistMissionSignal}"
                                                           FontSize="11"
                                                           FontWeight="Black"
                                                           TextWrapping="Wrap"
                                                           Foreground="#D9C5A5"/>
                                                <WrapPanel>
                                                    <Button Content="Prime next"
                                                            Command="{Binding PrimeNextArtistMissionCommand}"
                                                            Padding="13,9"
                                                            Margin="0,0,8,8"
                                                            Background="#C6A96D"
                                                            Foreground="#07110E"
                                                            FontWeight="Black"/>
                                                    <Button Content="Ready"
                                                            Command="{Binding MarkLatestArtistSessionReadyCommand}"
                                                            Padding="13,9"
                                                            Margin="0,0,8,8"
                                                            Background="#8DB7AD"
                                                            Foreground="#07110E"
                                                            FontWeight="Black"/>
                                                    <Button Content="Posted"
                                                            Command="{Binding MarkLatestArtistSessionPostedCommand}"
                                                            Padding="13,9"
                                                            Margin="0,0,8,8"
                                                            Background="#D9F8F0E5"
                                                            Foreground="#07110E"
                                                            FontWeight="Black"/>
                                                    <Button Content="Save review"
                                                            Command="{Binding ReviewLatestArtistSessionCommand}"
                                                            Padding="13,9"
                                                            Margin="0,0,8,8"
                                                            Background="#07110E"
                                                            Foreground="#E8E1D2"
                                                            FontWeight="Black"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border CornerRadius="18" Padding="13" Background="#19000000" BorderBrush="#228DB7AD" BorderThickness="1">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="RECENT SESSIONS"
                                                           FontSize="10"
                                                           FontWeight="Black"
                                                           LetterSpacing="2.2"
                                                           Foreground="#C6A96D"/>
                                                <ItemsControl ItemsSource="{Binding ArtistSessions}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="model:ArtistSessionItem">
                                                            <Border CornerRadius="14"
                                                                    Padding="10"
                                                                    Margin="0,0,0,8"
                                                                    Background="#13000000"
                                                                    BorderBrush="#1F8DB7AD"
                                                                    BorderThickness="1">
                                                                <StackPanel Spacing="4">
                                                                    <TextBlock Text="{Binding Title}"
                                                                               FontSize="12"
                                                                               FontWeight="Black"
                                                                               TextWrapping="Wrap"
                                                                               Foreground="#F8F0E5"/>
                                                                    <TextBlock Text="{Binding MissionType}"
                                                                               FontSize="10"
                                                                               FontWeight="Black"
                                                                               Foreground="#C6A96D"/>
                                                                    <TextBlock Text="{Binding PersonalityTone}"
                                                                               FontSize="10"
                                                                               TextWrapping="Wrap"
                                                                               Foreground="#9DBFB3"/>
                                                                    <TextBlock Text="{Binding PostStatus}"
                                                                               FontSize="10"
                                                                               FontWeight="Black"
                                                                               Foreground="#D9C5A5"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding ContentPlanItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ContentPlanItem">
                                                    <Border CornerRadius="18" Padding="13" Margin="0,0,0,10" Background="#13000000" BorderBrush="#1F8DB7AD" BorderThickness="1">
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                            <Border Width="34" Height="34" CornerRadius="13" Background="#14C6A96D">
                                                                <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Black" Foreground="#C6A96D"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Black" Foreground="#F8F0E5"/>
                                                                <TextBlock Text="{Binding Detail}" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="#9DBFB3"/>
                                                                <TextBlock Text="{Binding Action}" Margin="0,5,0,0" FontSize="10" FontWeight="Black" TextWrapping="Wrap" Foreground="#C6A96D"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="2" CornerRadius="22" Padding="16" Background="#5515120D" BorderBrush="#22C6A96D" BorderThickness="1">
                                <TextBlock Text="Rule: one clip should answer one question: where does this feeling live?"
                                           FontSize="13"
                                           FontWeight="Black"
                                           TextWrapping="Wrap"
                                           Foreground="#D9C5A5"/>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
                <StackPanel IsVisible="{Binding IsEditorRoom}" Spacing="18">
                <Border CornerRadius="34" BorderBrush="#2BE8E1D2" BorderThickness="1" Padding="30" BoxShadow="0 24 70 0 #66000000">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#0B1B2A" Offset="0"/>
                            <GradientStop Color="#06111C" Offset="0.58"/>
                            <GradientStop Color="#101810" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid RowDefinitions="Auto,Auto" RowSpacing="24">
                        <StackPanel VerticalAlignment="Center">
                            <Border CornerRadius="999" Background="#1692BFB3" Padding="12,7" HorizontalAlignment="Left">
                                <TextBlock Text="MUSICOS" FontSize="11" FontWeight="Black" Foreground="#C6A96D" LetterSpacing="3"/>
                            </Border>
                            <TextBlock Text="{Binding ProjectName}"
                                       Margin="0,18,0,4"
                                       FontSize="48"
                                       FontWeight="Black"
                                       TextWrapping="Wrap"
                                       Foreground="#E8E1D2"/>
                            <TextBlock Text="{Binding NextCreativeAction}"
                                       Margin="0,20,0,0"
                                       FontSize="15"
                                       LineHeight="24"
                                       TextWrapping="Wrap"
                                       Foreground="#C9C0AD"/>
                            <Border CornerRadius="28"
                                    Background="#E8E8E1D2"
                                    BorderBrush="#5592BFB3"
                                    BorderThickness="1"
                                    Padding="24"
                                    Margin="0,21,0,0">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="18">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="21">
                                        <StackPanel>
                                            <TextBlock Text="SIGNAL CHECK"
                                                       FontSize="11"
                                                       FontWeight="Black"
                                                       Foreground="#806A3F"
                                                       LetterSpacing="2.6"/>
                                            <TextBlock Text="{Binding SignalCheckHeadline}"
                                                       Margin="0,7,0,0"
                                                       FontSize="34"
                                                       FontWeight="Black"
                                                       TextWrapping="Wrap"
                                                       Foreground="#07100D"/>
                                            <TextBlock Text="{Binding SignalCheckDetail}"
                                                       Margin="0,8,0,0"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       LineHeight="22"
                                                       TextWrapping="Wrap"
                                                       Foreground="#4F5B52"/>
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Width="132"
                                                Height="132"
                                                CornerRadius="999"
                                                Background="#07100D">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SignalCheckPeakLabel}"
                                                           FontSize="34"
                                                           FontWeight="Black"
                                                           HorizontalAlignment="Center"
                                                           Foreground="#E8E1D2"/>
                                                <TextBlock Text="PEAK"
                                                           FontSize="10"
                                                           FontWeight="Black"
                                                           LetterSpacing="2"
                                                           HorizontalAlignment="Center"
                                                           Foreground="#92BFB3"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                                        <TextBlock Text="{Binding SignalCheckInputLabel}"
                                                   FontSize="12"
                                                   FontWeight="Black"
                                                   TextWrapping="Wrap"
                                                   Foreground="#07100D"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Content="Find Scarlett"
                                                Command="{Binding AutoConfigureFocusriteCommand}"
                                                Padding="16,10"
                                                Background="#07100D"
                                                Foreground="#E8E1D2"
                                                FontWeight="Black"/>
                                        <Button Grid.Column="2"
                                                Content="Record 3 sec test"
                                                Command="{Binding RunFocusriteInputTestCommand}"
                                                Padding="16,10"
                                                Background="#D08A56"
                                                Foreground="#07100D"
                                                FontWeight="Black"/>
                                        <Button Grid.Column="3"
                                                Content="Play test"
                                                Command="{Binding PlayFocusriteTestCommand}"
                                                Padding="16,10"
                                                Background="#6FB6A6"
                                                Foreground="#07100D"
                                                FontWeight="Black"/>
                                    </Grid>

                                    <Border Grid.Row="2"
                                            CornerRadius="20"
                                            Background="#15120D"
                                            Padding="18">
                                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="13">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding SimpleRecorderHeadline}"
                                                               FontSize="22"
                                                               FontWeight="Black"
                                                               TextWrapping="Wrap"
                                                               Foreground="#F8F0E5"/>
                                                    <TextBlock Text="{Binding SimpleRecorderDetail}"
                                                               Margin="0,6,0,0"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               TextWrapping="Wrap"
                                                               Foreground="#D9C5A5"/>
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="Start recording"
                                                        Command="{Binding StartSimpleRecordingCommand}"
                                                        Padding="18,12"
                                                        Background="#6FB6A6"
                                                        Foreground="#15120D"
                                                        FontWeight="Black"
                                                        VerticalAlignment="Center"/>
                                                <Button Grid.Column="2"
                                                        Content="Stop &amp; save"
                                                        Command="{Binding StopSimpleRecordingCommand}"
                                                        Padding="18,12"
                                                        Background="#E37B45"
                                                        Foreground="#15120D"
                                                        FontWeight="Black"
                                                        VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding SimpleRecordingStatus}"
                                                       FontSize="12"
                                                       FontWeight="Black"
                                                       TextWrapping="Wrap"
                                                       Foreground="#9DBFB3"/>
                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding SimpleRecorderFileLabel}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap"
                                                       Foreground="#EABF7A"/>
                                        </Grid>
                                    </Border>

                                    <TextBlock Grid.Row="3"
                                               Text="{Binding SignalCheckTestFile}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"
                                               Foreground="#8D5631"/>
                                </Grid>
                            </Border>
                            <Border CornerRadius="26"
                                    Background="#D9110E0A"
                                    BorderBrush="#33E37B45"
                                    BorderThickness="1"
                                    Padding="24"
                                    Margin="0,21,0,0"
                                    IsVisible="False">
                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="18">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="21">
                                        <StackPanel>
                                            <TextBlock Text="TODAY'S SESSION RAIL"
                                                       FontSize="10"
                                                       FontWeight="Black"
                                                       Foreground="#E37B45"
                                                       LetterSpacing="2.4"/>
                                            <TextBlock Text="{Binding SessionRailEnergy}"
                                                       Margin="0,5,0,0"
                                                       FontSize="18"
                                                       FontWeight="Black"
                                                       TextWrapping="Wrap"
                                                       Foreground="#F8F0E5"/>
                                            <TextBlock Text="{Binding SessionRailRoomStatus}"
                                                       Margin="0,4,0,0"
                                                       FontSize="11"
                                                       FontWeight="Black"
                                                       TextWrapping="Wrap"
                                                       Foreground="#6FB6A6"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="Start today's pass"
                                                Command="{Binding StartRoomPassCommand}"
                                                Padding="18,12"
                                                Background="#E37B45"
                                                Foreground="#15120D"
                                                FontWeight="Black"/>
                                    </Grid>

                                    <Grid Grid.Row="1" ColumnDefinitions="1.1*,0.9*" ColumnSpacing="13">
                                        <Border MinHeight="104" CornerRadius="18" Background="#331F1A13" BorderBrush="#22F8F0E5" BorderThickness="1" Padding="16">
                                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                                <TextBlock Text="PINNED PRIORITY"
                                                           FontSize="9"
                                                           FontWeight="Black"
                                                           Foreground="#EABF7A"
                                                           LetterSpacing="1.8"/>
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding SessionRailPinnedPriority}"
                                                           FontSize="13"
                                                           FontWeight="Black"
                                                           TextWrapping="Wrap"
                                                           Foreground="#F8F0E5"/>
                                                <TextBlock Grid.Row="2"
                                                           Text="{Binding SessionRailPinnedDetail}"
                                                           FontSize="10"
                                                           LineHeight="15"
                                                           TextWrapping="Wrap"
                                                           Foreground="#D9C5A5"/>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Column="1" MinHeight="104" CornerRadius="18" Background="#331F1A13" BorderBrush="#22F8F0E5" BorderThickness="1" Padding="16">
                                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                                <TextBlock Text="BEFORE EXPORT"
                                                           FontSize="9"
                                                           FontWeight="Black"
                                                           Foreground="#EABF7A"
                                                           LetterSpacing="1.8"/>
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding SessionRailGap}"
                                                           FontSize="11"
                                                           FontWeight="Black"
                                                           TextWrapping="Wrap"
                                                           Foreground="#F8F0E5"/>
                                                <TextBlock Grid.Row="2"
                                                           Text="Use the recorder panel below when you are ready to make sound."
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           TextWrapping="Wrap"
                                                           Foreground="#9DBFB3"/>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <Grid Grid.Row="2" ColumnDefinitions="1.2*,*" ColumnSpacing="13">
                                        <Border CornerRadius="18" Background="#2E1F1A13" Padding="16">
                                            <TextBlock Text="{Binding SessionRailLatestCapture}"
                                                       FontSize="11"
                                                       FontWeight="Black"
                                                       TextWrapping="Wrap"
                                                       Foreground="#D9C5A5"/>
                                        </Border>
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding ExportReadinessChecklist}" IsVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="11" Background="#22F2EADC" Padding="10,6" Margin="0,0,8,8">
                                                        <TextBlock Text="{Binding}"
                                                                   FontSize="9"
                                                                   FontWeight="Black"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="#F8F0E5"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border CornerRadius="26"
                                    Background="#CC0B0907"
                                    BorderBrush="#446FB6A6"
                                    BorderThickness="1"
                                    Padding="24"
                                    Margin="0,13,0,0">
                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="18">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="21">
                                        <StackPanel>
                                            <TextBlock Text="NEXT RECORDING MOVE"
                                                       FontSize="10"
                                                       FontWeight="Black"
                                                       Foreground="#6FB6A6"
                                                       LetterSpacing="2.4"/>
                                            <TextBlock Text="{Binding NextRecordingMoveHeadline}"
                                                       Margin="0,5,0,0"
                                                       FontSize="34"
                                                       FontWeight="Black"
                                                       TextWrapping="Wrap"
                                                       Foreground="#F8F0E5"/>
                                            <TextBlock Text="{Binding NextRecordingMoveDetail}"
                                                       Margin="0,8,0,0"
                                                       FontSize="15"
                                                       LineHeight="23"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap"
                                                       Foreground="#D9C5A5"/>
                                            <TextBlock Text="{Binding SessionSelectedLaneSignal}"
                                                       Margin="0,4,0,0"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap"
                                                       Foreground="#9DBFB3"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="Start here"
                                                Command="{Binding PrimeRecordingSessionCommand}"
                                                Padding="26,16"
                                                Background="#6FB6A6"
                                                Foreground="#15120D"
                                                FontWeight="Black"
                                                VerticalAlignment="Center"/>
                                    </Grid>

                                    <Border Grid.Row="1" CornerRadius="16" Background="#2AF2EADC" Padding="13">
                                        <TextBlock Text="{Binding SessionActionResult}"
                                                   FontSize="12"
                                                   FontWeight="Black"
                                                   TextWrapping="Wrap"
                                                   Foreground="#F8F0E5"/>
                                    </Border>

                                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="13">
                                        <TextBlock Text="{Binding SessionPackageSignal}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap"
                                                   Foreground="#D9C5A5"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Content="Save package"
                                                Command="{Binding ExportSessionPackageCommand}"
                                                Padding="12,8"
                                                Background="#15120D"
                                                Foreground="#F8F0E5"
                                                FontWeight="Black"/>
                                        <Button Grid.Column="2"
                                                Content="Open folder"
                                                Command="{Binding OpenSessionPackagesFolderCommand}"
                                                Padding="12,8"
                                                Background="#15120D"
                                                Foreground="#F8F0E5"
                                                FontWeight="Black"
                                                IsVisible="False"/>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border IsVisible="False" CornerRadius="24" Background="#3315120D" BorderBrush="#2615120D" BorderThickness="1" Padding="16" Margin="0,21,0,0">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="13">
                                    <TextBlock Text="{Binding DashboardSignal}"
                                               FontSize="11"
                                               FontWeight="Black"
                                               Foreground="#8D5631"
                                               LetterSpacing="1.4"/>
                                    <Border Grid.Row="1" CornerRadius="16" Background="#3D15120D" Padding="13,8">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="13">
                                            <StackPanel>
                                                <TextBlock Text="{Binding ProjectHealthSignal}"
                                                           FontSize="13"
                                                           FontWeight="Black"
                                                           Foreground="#15120D"/>
                                                <TextBlock Text="{Binding ProjectHealthDetail}"
                                                           Margin="0,3,0,0"
                                                           FontSize="10"
                                                           TextWrapping="Wrap"
                                                           Foreground="#6C5B47"/>
                                                <TextBlock Text="{Binding ProjectHealthBlockers}"
                                                           Margin="0,3,0,0"
                                                           FontSize="10"
                                                           FontWeight="Black"
                                                           TextWrapping="Wrap"
                                                           Foreground="#8D5631"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="MEMORY"
                                                       FontSize="10"
                                                       FontWeight="Black"
                                                       Foreground="#8D5631"
                                                       LetterSpacing="1.4"
                                                       VerticalAlignment="Center"/>
                                            <Button Grid.Column="2"
                                                    Content="{Binding PrimeGapLabel}"
                                                    Command="{Binding PrimeNextProjectGapCommand}"
                                                    Padding="12,8"
                                                    Background="#E37B45"
                                                    Foreground="#15120D"
                                                    FontWeight="Black"
                                                    VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ListBox Grid.Row="2"
                                             ItemsSource="{Binding ProjectModules}"
                                             SelectedItem="{Binding SelectedProjectModule}"
                                             Background="Transparent"
                                             BorderThickness="0">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:MusicOsModule">
                                                <Border Width="210" MinHeight="128" CornerRadius="18" Background="#3DFFFFFF" Padding="14" Margin="0,0,10,10">
                                                    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="5">
                                                        <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="Black" Foreground="{Binding Accent}" LetterSpacing="1.4"/>
                                                        <TextBlock Grid.Row="1" Text="{Binding Metric}" FontSize="12" FontWeight="Black" Foreground="#15120D" TextWrapping="Wrap"/>
                                                        <TextBlock Grid.Row="2" Text="{Binding NextAction}" FontSize="10" LineHeight="14" TextWrapping="Wrap" Foreground="#5D503F"/>
                                                        <TextBlock Grid.Row="3" Text="SELECT TO PRIME" FontSize="9" FontWeight="Black" Foreground="#8D5631" LetterSpacing="1.2"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Border Grid.Row="3" CornerRadius="18" Background="#4DF2EADC" BorderBrush="#3315120D" BorderThickness="1" Padding="13">
                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                                            <TextBlock Text="PROJECT MEMORY INSPECTOR"
                                                       FontSize="10"
                                                       FontWeight="Black"
                                                       Foreground="#8D5631"
                                                       LetterSpacing="1.4"/>
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding ProjectMemorySummary}"
                                                       FontSize="11"
                                                       FontWeight="Black"
                                                       TextWrapping="Wrap"
                                                       Foreground="#15120D"/>
                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding ProjectMemoryCounts}"
                                                       FontSize="10"
                                                       TextWrapping="Wrap"
                                                       Foreground="#5D503F"/>
                                            <TextBlock Grid.Row="3"
                                                       Text="{Binding ProjectMemoryModified}"
                                                       FontSize="10"
                                                       FontWeight="Black"
                                                       Foreground="#6FB6A6"/>
                                            <Border Grid.Row="4" CornerRadius="14" Background="#5915120D" Padding="10,7">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="13">
                                                    <TextBlock Text="{Binding SessionScore}"
                                                               FontSize="28"
                                                               FontWeight="Black"
                                                               Foreground="#E37B45"
                                                               VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SessionScoreLabel}"
                                                                   FontSize="11"
                                                                   FontWeight="Black"
                                                                   Foreground="#15120D"/>
                                                        <TextBlock Text="{Binding SessionScoreDetail}"
                                                                   Margin="0,3,0,0"
                                                                   FontSize="10"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="#5D503F"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border Grid.Row="5" CornerRadius="14" Background="#3315120D" Padding="10,7">
                                                <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="13">
                                                        <TextBlock Text="TODAY'S CREATIVE BRIEF"
                                                                   FontSize="9"
                                                                   FontWeight="Black"
                                                                   Foreground="#8D5631"
                                                                   LetterSpacing="1.4"
                                                                   VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1"
                                                                Content="Copy brief"
                                                                Command="{Binding CopyCreativeBriefCommand}"
                                                                Padding="10,5"
                                                                FontSize="9"
                                                                FontWeight="Black"
                                                                Background="#E37B45"
                                                                Foreground="#15120D"
                                                                BorderBrush="#15120D"
                                                                BorderThickness="1"
                                                                CornerRadius="10"/>
                                                    </Grid>
                                                    <TextBlock Grid.Row="1"
                                                               Text="{Binding TodaysCreativeBrief}"
                                                               FontSize="10"
                                                               FontWeight="Black"
                                                               TextWrapping="Wrap"
                                                               Foreground="#15120D"/>
                                                </Grid>
                                            </Border>
                                            <Border Grid.Row="6" CornerRadius="14" Background="#2615120D" Padding="10,7">
                                                <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                        <TextBlock Text="SESSION LAUNCH CHECKLIST"
                                                                   FontSize="9"
                                                                   FontWeight="Black"
                                                                   Foreground="#8D5631"
                                                                   LetterSpacing="1.4"
                                                                   VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1"
                                                                Content="Prime"
                                                                Command="{Binding PrimeSessionLaunchChecklistCommand}"
                                                                Padding="10,5"
                                                                FontSize="9"
                                                                FontWeight="Black"
                                                                Background="#6FB6A6"
                                                                Foreground="#15120D"
                                                                BorderBrush="#15120D"
                                                                BorderThickness="1"
                                                                CornerRadius="10"/>
                                                        <Button Grid.Column="2"
                                                                Content="Start pass"
                                                                Command="{Binding StartRoomPassCommand}"
                                                                Padding="10,5"
                                                                FontSize="9"
                                                                FontWeight="Black"
                                                                Background="#E37B45"
                                                                Foreground="#15120D"
                                                                BorderBrush="#15120D"
                                                                BorderThickness="1"
                                                                CornerRadius="10"/>
                                                    </Grid>
                                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding SessionLaunchChecklist}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,0,0,5">
                                                                    <Border Width="13" Height="13" CornerRadius="7" Background="#E37B45" Margin="0,2,0,0"/>
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding}"
                                                                               FontSize="10"
                                                                               TextWrapping="Wrap"
                                                                               Foreground="#15120D"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>
                                            <Border Grid.Row="7" CornerRadius="14" Background="#4015120D" Padding="10,7">
                                                <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="13">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding ProjectMemoryFinishedTodayCount}" FontSize="18" FontWeight="Black" Foreground="#E37B45"/>
                                                        <TextBlock Text="today" FontSize="9" FontWeight="Black" Foreground="#8D5631"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding ProjectMemoryFinishedWeekCount}" FontSize="18" FontWeight="Black" Foreground="#6FB6A6"/>
                                                        <TextBlock Text="week" FontSize="9" FontWeight="Black" Foreground="#8D5631"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding ProjectMemoryCompletionStreak}"
                                                               FontSize="10"
                                                               FontWeight="Black"
                                                               TextWrapping="Wrap"
                                                               Foreground="#15120D"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding ProjectMemoryMomentum}"
                                                               FontSize="10"
                                                               TextWrapping="Wrap"
                                                               Foreground="#5D503F"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Row="4"
                                               Text="Six rooms, one song memory: lyrics, takes, captions, visuals, routing, and exports stay attached to the project."
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="#5D503F"/>
                                    <Grid Grid.Row="5" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="13">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ProjectMemoryStatus}"
                                                       FontSize="11"
                                                       FontWeight="Black"
                                                       TextWrapping="Wrap"
                                                       Foreground="#15120D"/>
                                            <TextBlock Text="{Binding ProjectFilePath}"
                                                       Margin="0,4,0,0"
                                                       FontSize="10"
                                                       TextWrapping="Wrap"
                                                       Foreground="#6C5B47"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="Save project file"
                                                Command="{Binding SaveProjectSnapshotCommand}"
                                                Padding="14,9"
                                                Background="#15120D"
                                                Foreground="#F8F0E5"
                                                FontWeight="Black"
                                                VerticalAlignment="Center"/>
                                        <Button Grid.Column="2"
                                                Content="Open folder"
                                                Command="{Binding OpenProjectFolderCommand}"
                                                Padding="14,9"
                                                Background="#6FB6A6"
                                                Foreground="#15120D"
                                                FontWeight="Black"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Grid Margin="0,22,0,0" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                                <TextBox Text="{Binding ProjectName}" PlaceholderText="Project name" Background="#A80F0C08" Foreground="#F8F0E5" BorderBrush="#22F8F0E5"/>
                                <TextBox Grid.Column="1" Text="{Binding PlatformProfile}" PlaceholderText="Platform / aspect" Background="#A80F0C08" Foreground="#F8F0E5" BorderBrush="#22F8F0E5"/>
                                <TextBox Grid.Row="1" Text="{Binding BusinessMode}" PlaceholderText="Business mode" Background="#A80F0C08" Foreground="#F8F0E5" BorderBrush="#22F8F0E5"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LoudnessTarget}" PlaceholderText="Loudness target" Background="#A80F0C08" Foreground="#F8F0E5" BorderBrush="#22F8F0E5"/>
                            </Grid>
                            <Border CornerRadius="24" Background="#B0070706" BorderBrush="#18F8F0E5" BorderThickness="1" Padding="21" Margin="0,21,0,0">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="13">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="13">
                                        <StackPanel>
                                            <TextBlock Text="PROJECT MEMORY / SONG FILE"
                                                       FontSize="11"
                                                       FontWeight="Black"
                                                       Foreground="#E37B45"
                                                       LetterSpacing="2.8"/>
                                            <TextBlock Text="Unified local memory for the song, video, rig, captions, and exports."
                                                       Margin="0,5,0,0"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Foreground="#D9C5A5"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="Refresh memory"
                                                Command="{Binding RefreshProjectMemoryCommand}"
                                                Padding="13,8"
                                                Background="#E37B45"
                                                Foreground="#15120D"
                                                FontWeight="Black"/>
                                    </Grid>

                                    <Grid Grid.Row="1" ColumnDefinitions="1.2*,0.8*" ColumnSpacing="13">
                                        <Border CornerRadius="20" Background="#2415120D" BorderBrush="#22F8F0E5" BorderThickness="1" Padding="13">
                                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                                                <Grid ColumnDefinitions="89,*" ColumnSpacing="8">
                                                    <TextBlock Text="TITLE" FontSize="9" FontWeight="Black" Foreground="#8D5631" LetterSpacing="1.8"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ProjectMemoryTitle}" FontSize="11" FontWeight="Black" Foreground="#F8F0E5" TextWrapping="Wrap"/>
                                                </Grid>
                                                <Grid Grid.Row="1" ColumnDefinitions="89,*" ColumnSpacing="8">
                                                    <TextBlock Text="ARTIST" FontSize="9" FontWeight="Black" Foreground="#8D5631" LetterSpacing="1.8"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ProjectMemoryArtist}" FontSize="11" Foreground="#D9C5A5"/>
                                                </Grid>
                                                <Grid Grid.Row="2" ColumnDefinitions="89,*" ColumnSpacing="8">
                                                    <TextBlock Text="STATUS" FontSize="9" FontWeight="Black" Foreground="#8D5631" LetterSpacing="1.8"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ProjectMemoryStatusLabel}" FontSize="11" Foreground="#D9C5A5" TextWrapping="Wrap"/>
                                                </Grid>
                                                <Grid Grid.Row="3" ColumnDefinitions="89,*" ColumnSpacing="8">
                                                    <TextBlock Text="MODIFIED" FontSize="9" FontWeight="Black" Foreground="#8D5631" LetterSpacing="1.8"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ProjectMemoryModifiedAt}" FontSize="11" Foreground="#D9C5A5"/>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Column="1" CornerRadius="20" Background="#2615120D" BorderBrush="#22F8F0E5" BorderThickness="1" Padding="13">
                                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                                                <Grid ColumnDefinitions="55,*" ColumnSpacing="8">
                                                    <TextBlock Text="BPM" FontSize="9" FontWeight="Black" Foreground="#8D5631" LetterSpacing="1.8"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ProjectMemoryBpm}" FontSize="11" FontWeight="Black" Foreground="#F8F0E5"/>
                                                </Grid>
                                                <Grid Grid.Row="1" ColumnDefinitions="55,*" ColumnSpacing="8">
                                                    <TextBlock Text="KEY" FontSize="9" FontWeight="Black" Foreground="#8D5631" LetterSpacing="1.8"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ProjectMemoryKey}" FontSize="11" Foreground="#D9C5A5"/>
                                                </Grid>
                                                <Grid Grid.Row="2" ColumnDefinitions="55,*" ColumnSpacing="8">
                                                    <TextBlock Text="PLAT" FontSize="9" FontWeight="Black" Foreground="#8D5631" LetterSpacing="1.8"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ProjectMemoryPlatform}" FontSize="11" Foreground="#D9C5A5" TextWrapping="Wrap"/>
                                                </Grid>
                                                <Grid Grid.Row="3" ColumnDefinitions="55,*" ColumnSpacing="8">
                                                    <TextBlock Text="LOUD" FontSize="9" FontWeight="Black" Foreground="#8D5631" LetterSpacing="1.8"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ProjectMemoryLoudness}" FontSize="11" Foreground="#D9C5A5"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <WrapPanel Grid.Row="2">
                                        <Border Width="118" CornerRadius="16" Background="#2415120D" Padding="10" Margin="0,0,8,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding ProjectMemoryCaptureCount}" FontSize="18" FontWeight="Black" Foreground="#E37B45"/>
                                                <TextBlock Text="captures" FontSize="9" Foreground="#D9C5A5"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Width="118" CornerRadius="16" Background="#2415120D" Padding="10" Margin="0,0,8,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding ProjectMemoryLyricCount}" FontSize="18" FontWeight="Black" Foreground="#EABF7A"/>
                                                <TextBlock Text="lyrics" FontSize="9" Foreground="#D9C5A5"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Width="118" CornerRadius="16" Background="#2415120D" Padding="10" Margin="0,0,8,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding ProjectMemoryTakeCount}" FontSize="18" FontWeight="Black" Foreground="#6FB6A6"/>
                                                <TextBlock Text="takes" FontSize="9" Foreground="#D9C5A5"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Width="118" CornerRadius="16" Background="#2415120D" Padding="10" Margin="0,0,8,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding ProjectMemoryCaptionCount}" FontSize="18" FontWeight="Black" Foreground="#D9C5A5"/>
                                                <TextBlock Text="captions" FontSize="9" Foreground="#D9C5A5"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Width="118" CornerRadius="16" Background="#2415120D" Padding="10" Margin="0,0,8,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding ProjectMemoryVisualPresetCount}" FontSize="18" FontWeight="Black" Foreground="#F2EADC"/>
                                                <TextBlock Text="visuals" FontSize="9" Foreground="#D9C5A5"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Width="118" CornerRadius="16" Background="#2415120D" Padding="10" Margin="0,0,8,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding ProjectMemoryRoutingNoteCount}" FontSize="18" FontWeight="Black" Foreground="#9DBFB3"/>
                                                <TextBlock Text="routing" FontSize="9" Foreground="#D9C5A5"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Width="118" CornerRadius="16" Background="#2415120D" Padding="10" Margin="0,0,8,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding ProjectMemoryExportTaskCount}" FontSize="18" FontWeight="Black" Foreground="#E37B45"/>
                                                <TextBlock Text="exports" FontSize="9" Foreground="#D9C5A5"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>

                                    <Border Grid.Row="3" CornerRadius="20" Background="#2215120D" BorderBrush="#22F8F0E5" BorderThickness="1" Padding="13">
                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="13">
                                                <TextBlock Text="PROJECT MEMORY TIMELINE"
                                                           FontSize="10"
                                                           FontWeight="Black"
                                                           Foreground="#E37B45"
                                                           LetterSpacing="2.2"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="select to jump"
                                                           FontSize="9"
                                                           FontWeight="Black"
                                                           Foreground="#8D5631"
                                                           LetterSpacing="1.6"/>
                                            </Grid>
                                            <ComboBox Grid.Row="1"
                                                      ItemsSource="{Binding ProjectMemoryTimelineFilters}"
                                                      SelectedItem="{Binding SelectedProjectMemoryTimelineFilter}"
                                                      Background="#3315120D"
                                                      Foreground="#F8F0E5"
                                                      BorderBrush="#22F8F0E5"/>
                                            <ListBox Grid.Row="2"
                                                     ItemsSource="{Binding ProjectMemoryTimeline}"
                                                     SelectedItem="{Binding SelectedProjectMemoryTimelineItem}"
                                                     Background="Transparent"
                                                     BorderThickness="0">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ProjectMemoryTimelineItem">
                                                        <Border CornerRadius="14" Background="#2415120D" Padding="8" Margin="0,0,0,8">
                                                            <Grid ColumnDefinitions="70,82,*" ColumnSpacing="8">
                                                                <TextBlock Text="{Binding When}"
                                                                           FontSize="9"
                                                                           FontWeight="Black"
                                                                           Foreground="{Binding Accent}"
                                                                           TextWrapping="Wrap"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Room}"
                                                                           FontSize="9"
                                                                           FontWeight="Black"
                                                                           Foreground="#8D5631"
                                                                           LetterSpacing="1.2"/>
                                                                <StackPanel Grid.Column="2">
                                                                    <TextBlock Text="{Binding Title}"
                                                                               FontSize="10"
                                                                               FontWeight="Black"
                                                                               Foreground="#F8F0E5"
                                                                               TextWrapping="Wrap"/>
                                                                    <TextBlock Text="{Binding Detail}"
                                                                               Margin="0,3,0,0"
                                                                               FontSize="9"
                                                                               Foreground="#D9C5A5"
                                                                               TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <Grid Grid.Row="3" RowDefinitions="Auto,Auto" RowSpacing="10">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PinnedProjectMemoryItem.Title, TargetNullValue=No pinned memory action}"
                                                               FontSize="10"
                                                               FontWeight="Black"
                                                               Foreground="#F8F0E5"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding PinnedProjectMemoryItem.TargetRoom, TargetNullValue=Select or pin a memory item to make the next move visible.}"
                                                               Margin="0,3,0,0"
                                                               FontSize="9"
                                                               FontWeight="Black"
                                                               Foreground="#E37B45"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding PinnedProjectMemoryItem.Detail}"
                                                               Margin="0,3,0,0"
                                                               FontSize="9"
                                                               Foreground="#D9C5A5"
                                                               TextWrapping="Wrap"
                                                               MaxHeight="44"/>
                                                </StackPanel>
                                                <WrapPanel Grid.Row="1">
                                                    <Button Content="Pin selected"
                                                            Command="{Binding PinSelectedProjectMemoryCommand}"
                                                            Padding="13,8"
                                                            Margin="0,0,8,8"
                                                            Background="#E37B45"
                                                            Foreground="#15120D"
                                                            FontWeight="Black"/>
                                                    <Button Content="Resume pin"
                                                            Command="{Binding OpenPinnedProjectMemoryCommand}"
                                                            Padding="13,8"
                                                            Margin="0,0,8,8"
                                                            Background="#EABF7A"
                                                            Foreground="#15120D"
                                                            FontWeight="Black"/>
                                                    <Button Content="Complete pin"
                                                            Command="{Binding CompletePinnedProjectMemoryCommand}"
                                                            Padding="13,8"
                                                            Margin="0,0,8,8"
                                                            Background="#6FB6A6"
                                                            Foreground="#15120D"
                                                            FontWeight="Black"/>
                                                    <Button Content="Clear pin"
                                                            Command="{Binding ClearPinnedProjectMemoryCommand}"
                                                            Padding="13,8"
                                                            Margin="0,0,8,8"
                                                            Background="#3315120D"
                                                            Foreground="#F8F0E5"
                                                            FontWeight="Black"/>
                                                    <Button Content="Undo done"
                                                            Command="{Binding UndoLatestCompletionCommand}"
                                                            Padding="13,8"
                                                            Margin="0,0,8,8"
                                                            Background="#2415120D"
                                                            Foreground="#D9C5A5"
                                                            FontWeight="Black"/>
                                                </WrapPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="4" RowDefinitions="Auto,Auto" RowSpacing="8">
                                        <TextBox Text="{Binding ProjectMemoryFilePreview}"
                                                 IsReadOnly="True"
                                                 Background="#3315120D"
                                                 Foreground="#D9C5A5"
                                                 BorderBrush="#22F8F0E5"/>
                                        <WrapPanel Grid.Row="1">
                                            <Button Content="Open memory folder"
                                                    Command="{Binding OpenProjectFolderCommand}"
                                                    Padding="13,8"
                                                    Margin="0,0,8,8"
                                                    Background="#6FB6A6"
                                                    Foreground="#15120D"
                                                    FontWeight="Black"/>
                                        </WrapPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border CornerRadius="20" Background="#660F0C08" BorderBrush="#0EF8F0E5" BorderThickness="1" Padding="16" Margin="0,18,0,0">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                                    <TextBlock Text="SONG BUILD ORDER" FontSize="11" FontWeight="Black" Foreground="#8D5631" LetterSpacing="2.8"/>
                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding SongStages}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="svc:SongStage">
                                                <Border CornerRadius="16" Background="#1F1A13" Padding="12,9">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Step}" FontSize="10" FontWeight="Black" Foreground="{Binding Accent}"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Black" Foreground="#F8F0E5"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid Grid.Row="2" ColumnDefinitions="*,100,100" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                        <ComboBox ItemsSource="{Binding SongStages}"
                                                  SelectedItem="{Binding SelectedSongStage}"
                                                  Background="#A80F0C08"
                                                  Foreground="#F8F0E5">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="svc:SongStage">
                                                    <TextBlock Text="{Binding Name}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBox Grid.Column="1" Text="{Binding Tempo}" PlaceholderText="Tempo" Background="#A80F0C08" Foreground="#F8F0E5"/>
                                        <TextBox Grid.Column="2" Text="{Binding KeyCenter}" PlaceholderText="Key" Background="#A80F0C08" Foreground="#F8F0E5"/>
                                        <WrapPanel Grid.Row="1" Grid.ColumnSpan="3">
                                            <Button Content="Save stage"
                                                    Command="{Binding SaveSongStageCommand}"
                                                    Padding="14,9"
                                                    Margin="0,0,8,8"
                                                    Background="#15120D"
                                                    Foreground="#F8F0E5"
                                                    FontWeight="Black"/>
                                        </WrapPanel>
                                    </Grid>
                                    <TextBlock Grid.Row="3"
                                               Text="{Binding SelectedSongStageGoal}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="#D9C5A5"/>
                                    <TextBlock Grid.Row="4"
                                               Text="{Binding SelectedSongStageRouting}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="#C8A96B"/>
                                    <TextBox Grid.Row="5"
                                             Text="{Binding SongStageNotes}"
                                             PlaceholderText="Stage notes"
                                             Background="#A80F0C08"
                                             Foreground="#F8F0E5"
                                             BorderBrush="#22F8F0E5"/>
                                    <Grid Grid.Row="6" RowDefinitions="Auto,Auto" RowSpacing="8">
                                        <TextBox Text="{Binding MixPrompt}"
                                                 PlaceholderText="Type mix intent: warmer drums, less harsh guitar, more intimate vocal..."
                                                 Background="#A80F0C08"
                                                 Foreground="#F8F0E5"
                                                 BorderBrush="#22F8F0E5"/>
                                        <WrapPanel Grid.Row="1">
                                            <Button Content="Apply words"
                                                    Command="{Binding ApplyMixIntentCommand}"
                                                    Padding="14,9"
                                                    Margin="0,0,8,8"
                                                    Background="#E37B45"
                                                    Foreground="#15120D"
                                                    FontWeight="Black"/>
                                        </WrapPanel>
                                    </Grid>
                                    <Border Grid.Row="7" CornerRadius="18" Background="#2615120D" Padding="12">
                                        <Grid RowDefinitions="Auto,Auto" RowSpacing="5">
                                            <TextBlock Text="{Binding MixRecommendation}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Foreground="#D9C5A5"/>
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding MixChain}"
                                                       FontSize="11"
                                                       FontWeight="Black"
                                                       TextWrapping="Wrap"
                                                       Foreground="#C8A96B"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                            <Border CornerRadius="20" Background="#660F0C08" BorderBrush="#18F2EADC" BorderThickness="1" Padding="16" Margin="0,14,0,0">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="INSTRUMENT LANES" FontSize="11" FontWeight="Black" Foreground="#F2EADC" LetterSpacing="2.8"/>
                                            <TextBlock Text="{Binding InstrumentChannelSignal}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap"
                                                       Foreground="#D9C5A5"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="Reset lanes"
                                                Command="{Binding ResetInstrumentChannelsCommand}"
                                                Padding="14,8"
                                                Background="#3315120D"
                                                Foreground="#D9C5A5"
                                                FontWeight="Black"/>
                                    </Grid>

                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding InstrumentChannels}"
                                             SelectedItem="{Binding SelectedInstrumentChannel}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             MaxHeight="148">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:InstrumentChannelItem">
                                                <Border CornerRadius="16" Background="#2415120D" Padding="12" Margin="0,0,8,8" Width="150">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Black" Foreground="#F8F0E5"/>
                                                        <TextBlock Text="{Binding VisualPalette}" FontSize="10" Foreground="#9DBFB3"/>
                                                        <TextBlock Text="{Binding TonePrompt}" FontSize="9" TextWrapping="Wrap" Foreground="#D9C5A5" MaxHeight="34"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <TextBox Text="{Binding InstrumentTonePrompt}"
                                                 PlaceholderText="Example: make drums warmer, make vocal closer..."
                                                 Background="#A80F0C08"
                                                 Foreground="#F8F0E5"
                                                 BorderBrush="#22F8F0E5"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding InstrumentInputNote}"
                                                 PlaceholderText="Input/source: RC-505 track, Focusrite input, mic..."
                                                 Background="#A80F0C08"
                                                 Foreground="#F8F0E5"
                                                 BorderBrush="#22F8F0E5"/>
                                    </Grid>

                                    <Grid Grid.Row="3" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                        <StackPanel>
                                            <TextBlock Text="Warmth" FontSize="10" FontWeight="Black" Foreground="#C8A96B"/>
                                            <Slider Minimum="0" Maximum="100" Value="{Binding InstrumentWarmth}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Space" FontSize="10" FontWeight="Black" Foreground="#9DBFB3"/>
                                            <Slider Minimum="0" Maximum="100" Value="{Binding InstrumentSpace}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Energy" FontSize="10" FontWeight="Black" Foreground="#E37B45"/>
                                            <Slider Minimum="0" Maximum="100" Value="{Binding InstrumentEnergy}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBlock Text="{Binding InstrumentChannelVisualSignal}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="#D9C5A5"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Content="Apply lane"
                                                Command="{Binding ApplyInstrumentChannelCommand}"
                                                Padding="14,9"
                                                Background="#F2EADC"
                                                Foreground="#15120D"
                                                FontWeight="Black"/>
                                    </Grid>

                                    <Border Grid.Row="5" CornerRadius="16" Background="#2615120D" Padding="12">
                                        <TextBlock Text="{Binding InstrumentChannelResult}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="#D9C5A5"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <Border CornerRadius="20" Background="#660F0C08" BorderBrush="#22E37B45" BorderThickness="1" Padding="16" Margin="0,14,0,0" IsVisible="False">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="BUILT-IN LOOPER ALPHA" FontSize="11" FontWeight="Black" Foreground="#E37B45" LetterSpacing="2.8"/>
                                            <TextBlock Text="{Binding BuiltInLooperSignal}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap"
                                                       Foreground="#D9C5A5"/>
                                            <TextBlock Text="{Binding SelectedLooperRoutingSignal}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap"
                                                       Foreground="#9DBFB3"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="Reset looper"
                                                Command="{Binding ResetLooperTracksCommand}"
                                                Padding="14,8"
                                                Background="#3315120D"
                                                Foreground="#D9C5A5"
                                                FontWeight="Black"/>
                                    </Grid>

                                    <Button Grid.Row="1"
                                            Content="Prime first drum loop test"
                                            Command="{Binding PrimeFirstDrumLoopTestCommand}"
                                            Padding="16,10"
                                            HorizontalAlignment="Stretch"
                                            Background="#E37B45"
                                            Foreground="#15120D"
                                            FontWeight="Black"/>

                                    <Border Grid.Row="2" CornerRadius="16" Background="#2A15120D" BorderBrush="#18E37B45" BorderThickness="1" Padding="12">
                                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <TextBlock Text="{Binding LooperTestNextStep}"
                                                           FontSize="13"
                                                           FontWeight="Black"
                                                           TextWrapping="Wrap"
                                                           Foreground="#F2EADC"/>
                                                <Button Grid.Column="1"
                                                        Content="Prime full test"
                                                        Command="{Binding PrimeFullRecordingTestCommand}"
                                                        Padding="12,7"
                                                        Background="#F2EADC"
                                                        Foreground="#15120D"
                                                        FontWeight="Black"/>
                                            </Grid>
                                            <ItemsControl Grid.Row="1" ItemsSource="{Binding RecordingTestChecklist}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="#D9C5A5"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Grid.Row="2"
                                                       Text="Files autosave with XIV + timestamp. No manual rename needed."
                                                       FontSize="10"
                                                       FontWeight="Black"
                                                       Foreground="#EABF7A"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Row="3" Spacing="10">
                                        <ListBox ItemsSource="{Binding LooperTracks}"
                                                 SelectedItem="{Binding SelectedLooperTrack}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 MaxHeight="170">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:LooperTrackItem">
                                                    <Border CornerRadius="16" Background="#2415120D" Padding="12" Margin="0,0,8,8" Width="156">
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="{Binding Number}" FontSize="18" FontWeight="Black" Foreground="{Binding Color}"/>
                                                            <TextBlock Text="{Binding Instrument}" FontSize="13" FontWeight="Black" Foreground="#F8F0E5"/>
                                                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="#9DBFB3"/>
                                                            <TextBlock Text="{Binding Mode}" FontSize="10" FontWeight="Black" Foreground="#EABF7A"/>
                                                            <TextBlock Text="{Binding TakeArchiveSummary}" FontSize="10" Foreground="#D9C5A5"/>
                                                            <TextBlock Text="{Binding LastAction}" FontSize="9" Foreground="#8D7D68" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding DurationLabel}" FontSize="10" Foreground="#D9C5A5"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <ItemsControl ItemsSource="{Binding LooperLaneReadiness}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:LooperLaneReadinessItem">
                                                    <Border CornerRadius="999" Background="#1F15120D" BorderBrush="{Binding Color}" BorderThickness="1" Padding="10,6" Margin="0,0,8,8">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{Binding Instrument}" FontSize="10" FontWeight="Black" Foreground="{Binding Color}"/>
                                                            <TextBlock Text="{Binding Role}" FontSize="10" FontWeight="Bold" Foreground="#D9C5A5"/>
                                                            <TextBlock Text="{Binding State}" FontSize="10" Foreground="#8D7D68"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <Border Grid.Row="4" CornerRadius="16" Background="#2615120D" BorderBrush="#12F8F0E5" BorderThickness="1" Padding="12">
                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <TextBlock Text="FOCUSRITE CHECK"
                                                           FontSize="10"
                                                           FontWeight="Black"
                                                           Foreground="#F2EADC"
                                                           LetterSpacing="2.2"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding FocusritePeakPercent, StringFormat='Peak {0:0.0}%'}"
                                                           FontSize="10"
                                                           FontWeight="Black"
                                                           Foreground="#E37B45"/>
                                            </Grid>
                                            <WrapPanel Grid.Row="1">
                                                <Button Content="Auto Focusrite"
                                                        Command="{Binding AutoConfigureFocusriteCommand}"
                                                        Padding="14,8"
                                                        Margin="0,0,8,8"
                                                        Background="#F2EADC"
                                                        Foreground="#15120D"
                                                        FontWeight="Black"/>
                                                <Button Content="3s input test"
                                                        Command="{Binding RunFocusriteInputTestCommand}"
                                                        Padding="14,8"
                                                        Margin="0,0,8,8"
                                                        Background="#E37B45"
                                                        Foreground="#15120D"
                                                        FontWeight="Black"/>
                                                <Button Content="Play test"
                                                        Command="{Binding PlayFocusriteTestCommand}"
                                                        Padding="14,8"
                                                        Margin="0,0,8,8"
                                                        Background="#EABF7A"
                                                        Foreground="#15120D"
                                                        FontWeight="Black"/>
                                                <Button Content="Stop test"
                                                        Command="{Binding StopFocusriteTestPlaybackCommand}"
                                                        Padding="14,8"
                                                        Margin="0,0,8,8"
                                                        Background="#2415120D"
                                                        Foreground="#D9C5A5"
                                                        FontWeight="Black"/>
                                                <Button Content="Open stems"
                                                        Command="{Binding OpenStemsFolderCommand}"
                                                        Padding="14,8"
                                                        Margin="0,0,8,8"
                                                        Background="#2415120D"
                                                        Foreground="#D9C5A5"
                                                        FontWeight="Black"/>
                                            </WrapPanel>
                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding FocusriteTestStatus}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap"
                                                       Foreground="#D9C5A5"/>
                                            <Border Grid.Row="3" CornerRadius="12" Background="#3315120D" Padding="10">
                                                <TextBlock Text="{Binding FocusriteCalibrationSignal}"
                                                           FontSize="11"
                                                           FontWeight="Black"
                                                           TextWrapping="Wrap"
                                                           Foreground="#9DBFB3"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="5" ColumnDefinitions="130,90,90,90,*" ColumnSpacing="8">
                                        <ComboBox ItemsSource="{Binding LooperModes}"
                                                  SelectedItem="{Binding SelectedLooperMode}"
                                                  Background="#A80F0C08"
                                                  Foreground="#F8F0E5"
                                                  BorderBrush="#22F8F0E5"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding LooperBpm}"
                                                 PlaceholderText="BPM"
                                                 Background="#A80F0C08"
                                                 Foreground="#F8F0E5"
                                                 BorderBrush="#22F8F0E5"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding LooperCountInBeats}"
                                                 PlaceholderText="Count"
                                                 Background="#A80F0C08"
                                                 Foreground="#F8F0E5"
                                                 BorderBrush="#22F8F0E5"/>
                                        <TextBox Grid.Column="3"
                                                 Text="{Binding LooperBars}"
                                                 PlaceholderText="Bars"
                                                 Background="#A80F0C08"
                                                 Foreground="#F8F0E5"
                                                 BorderBrush="#22F8F0E5"/>
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding LooperTimingSignal}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap"
                                                   Foreground="#D9C5A5"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid Grid.Row="6" ColumnDefinitions="160,*" ColumnSpacing="10">
                                        <Border CornerRadius="16" Background="#2615120D" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="Track volume"
                                                           FontSize="10"
                                                           FontWeight="Black"
                                                           Foreground="#C8A96B"/>
                                                <Slider Minimum="0"
                                                        Maximum="100"
                                                        Value="{Binding SelectedLooperTrackVolume}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" CornerRadius="16" Background="#2615120D" Padding="12">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{Binding LooperTransportStatus}"
                                                           FontSize="12"
                                                           FontWeight="Black"
                                                           TextWrapping="Wrap"
                                                           Foreground="#E37B45"/>
                                                <TextBlock Text="{Binding LooperModeGuidance}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           TextWrapping="Wrap"
                                                           Foreground="#9DBFB3"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <WrapPanel Grid.Row="7">
                                        <Button Content="Arm"
                                                Command="{Binding ArmLooperTrackCommand}"
                                                Padding="14,9"
                                                Margin="0,0,8,8"
                                                Background="#F2EADC"
                                                Foreground="#15120D"
                                                FontWeight="Black"/>
                                        <Button Content="Record"
                                                Command="{Binding RecordLooperTrackCommand}"
                                                Padding="14,9"
                                                Margin="0,0,8,8"
                                                Background="#E37B45"
                                                Foreground="#15120D"
                                                FontWeight="Black"/>
                                        <Button Content="Timed record"
                                                Command="{Binding RecordTimedLooperTrackCommand}"
                                                Padding="14,9"
                                                Margin="0,0,8,8"
                                                Background="#F2EADC"
                                                Foreground="#15120D"
                                                FontWeight="Black"/>
                                        <Button Content="Stop + save"
                                                Command="{Binding StopLooperTrackRecordingCommand}"
                                                Padding="14,9"
                                                Margin="0,0,8,8"
                                                Background="#6FB6A6"
                                                Foreground="#15120D"
                                                FontWeight="Black"/>
                                        <Button Content="Play loop"
                                                Command="{Binding PlayLooperTrackCommand}"
                                                Padding="14,9"
                                                Margin="0,0,8,8"
                                                Background="#EABF7A"
                                                Foreground="#15120D"
                                                FontWeight="Black"/>
                                        <Button Content="Play arrangement"
                                                Command="{Binding PlayLooperArrangementCommand}"
                                                Padding="14,9"
                                                Margin="0,0,8,8"
                                                Background="#F2EADC"
                                                Foreground="#15120D"
                                                FontWeight="Black"/>
                                        <Button Content="Stop track"
                                                Command="{Binding StopLooperTrackCommand}"
                                                Padding="14,9"
                                                Margin="0,0,8,8"
                                                Background="#3315120D"
                                                Foreground="#D9C5A5"
                                                FontWeight="Black"/>
                                        <Button Content="Stop all"
                                                Command="{Binding StopAllLooperTracksCommand}"
                                                Padding="14,9"
                                                Margin="0,0,8,8"
                                                Background="#3315120D"
                                                Foreground="#D9C5A5"
                                                FontWeight="Black"/>
                                        <Button Content="Prime next lane"
                                                Command="{Binding PrimeNextLooperLaneCommand}"
                                                Padding="14,9"
                                                Margin="0,0,8,8"
                                                Background="#9DBFB3"
                                                Foreground="#15120D"
                                                FontWeight="Black"/>
                                        <Button Content="Save arrangement take"
                                                Command="{Binding SaveLooperArrangementTakeCommand}"
                                                Padding="14,9"
                                                Margin="0,0,8,8"
                                                Background="#6FB6A6"
                                                Foreground="#15120D"
                                                FontWeight="Black"/>
                                        <Button Content="Export arrangement WAV"
                                                Command="{Binding ExportLooperArrangementMixCommand}"
                                                Padding="14,9"
                                                Margin="0,0,8,8"
                                                Background="#C8A96B"
                                                Foreground="#15120D"
                                                FontWeight="Black"/>
                                    </WrapPanel>

                                    <WrapPanel Grid.Row="8">
                                        <Button Content="Mute"
                                                Command="{Binding ToggleLooperMuteCommand}"
                                                Padding="14,8"
                                                Margin="0,0,8,8"
                                                Background="#2415120D"
                                                Foreground="#D9C5A5"
                                                FontWeight="Black"/>
                                        <Button Content="Solo"
                                                Command="{Binding ToggleLooperSoloCommand}"
                                                Padding="14,8"
                                                Margin="0,0,8,8"
                                                Background="#2415120D"
                                                Foreground="#D9C5A5"
                                                FontWeight="Black"/>
                                        <Button Content="Open stems"
                                                Command="{Binding OpenStemsFolderCommand}"
                                                Padding="14,8"
                                                Margin="0,0,8,8"
                                                Background="#2415120D"
                                                Foreground="#D9C5A5"
                                                FontWeight="Black"/>
                                    </WrapPanel>

                                    <Border Grid.Row="9" CornerRadius="16" Background="#2615120D" Padding="12">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{Binding LooperNextMove}"
                                                       FontSize="12"
                                                       FontWeight="Black"
                                                       TextWrapping="Wrap"
                                                       Foreground="#F2EADC"/>
                                            <TextBlock Text="{Binding LooperArrangementSignal}"
                                                       FontSize="11"
                                                       FontWeight="Black"
                                                       TextWrapping="Wrap"
                                                       Foreground="#9DBFB3"/>
                                            <TextBlock Text="{Binding LooperExportSignal}"
                                                       FontSize="11"
                                                       FontWeight="Black"
                                                       TextWrapping="Wrap"
                                                       Foreground="#C8A96B"/>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <TextBlock Text="{Binding AutosaveSignal}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           TextWrapping="Wrap"
                                                           Foreground="#EABF7A"
                                                           VerticalAlignment="Center"/>
                                                <Button Grid.Column="1"
                                                        Content="Open latest autosave"
                                                        Command="{Binding OpenLatestAutosaveCommand}"
                                                        Padding="12,7"
                                                        Background="#2415120D"
                                                        Foreground="#D9C5A5"
                                                        FontWeight="Black"/>
                                            </Grid>
                                            <Border CornerRadius="14" Background="#1A0F0C08" BorderBrush="#12EABF7A" BorderThickness="1" Padding="10">
                                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                                        <TextBlock Text="{Binding AutosaveBrowserSignal}"
                                                                   FontSize="10"
                                                                   FontWeight="Black"
                                                                   Foreground="#EABF7A"
                                                                   VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1"
                                                                Content="Refresh"
                                                                Command="{Binding RefreshAutosaveFilesCommand}"
                                                                Padding="10,6"
                                                                Background="#2415120D"
                                                                Foreground="#D9C5A5"
                                                                FontWeight="Black"/>
                                                        <Button Grid.Column="2"
                                                                Content="Play"
                                                                Command="{Binding PlaySelectedAutosaveCommand}"
                                                                Padding="10,6"
                                                                Background="#EABF7A"
                                                                Foreground="#15120D"
                                                                FontWeight="Black"/>
                                                        <Button Grid.Column="3"
                                                                Content="Open"
                                                                Command="{Binding OpenSelectedAutosaveCommand}"
                                                                Padding="10,6"
                                                                Background="#F2EADC"
                                                                Foreground="#15120D"
                                                                FontWeight="Black"/>
                                                    </Grid>
                                                    <TextBlock Grid.Row="2"
                                                               Text="{Binding SelectedAutosaveLaneSignal}"
                                                               FontSize="10"
                                                               FontWeight="Black"
                                                               TextWrapping="Wrap"
                                                               Foreground="#9DBFB3"/>
                                                    <WrapPanel Grid.Row="3">
                                                        <Button Content="Load into selected lane"
                                                                Command="{Binding AssignSelectedAutosaveToLooperLaneCommand}"
                                                                Padding="10,6"
                                                                Margin="0,0,8,8"
                                                                Background="#6FB6A6"
                                                                Foreground="#15120D"
                                                                FontWeight="Black"/>
                                                        <Button Content="Stop preview"
                                                                Command="{Binding StopSelectedAutosavePreviewCommand}"
                                                                Padding="10,6"
                                                                Margin="0,0,8,8"
                                                                Background="#3315120D"
                                                                Foreground="#D9C5A5"
                                                                FontWeight="Black"/>
                                                    </WrapPanel>
                                                    <Button Grid.Row="5"
                                                            Content="Trash selected autosave"
                                                            Command="{Binding DeleteSelectedAutosaveCommand}"
                                                            Padding="10,6"
                                                            Background="#3315120D"
                                                            Foreground="#D9C5A5"
                                                            FontWeight="Black"/>
                                                    <Button Grid.Row="4"
                                                            Content="Attach selected autosave to take review"
                                                            Command="{Binding AttachSelectedAutosaveToTakeCommand}"
                                                            Padding="10,6"
                                                            Background="#6FB6A6"
                                                            Foreground="#15120D"
                                                            FontWeight="Black"/>
                                                    <ListBox Grid.Row="1"
                                                             ItemsSource="{Binding AutosaveFiles}"
                                                             SelectedItem="{Binding SelectedAutosaveFile}"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             MaxHeight="110">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:AutosaveFileItem">
                                                                <Border CornerRadius="10" Background="#2415120D" Padding="8" Margin="0,0,0,6">
                                                                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="3">
                                                                        <TextBlock Text="{Binding Name}"
                                                                                   FontSize="10"
                                                                                   FontWeight="Black"
                                                                                   TextWrapping="Wrap"
                                                                                   Foreground="#F2EADC"/>
                                                                        <TextBlock Grid.Row="1"
                                                                                   Text="{Binding Summary}"
                                                                                   FontSize="9"
                                                                                   TextWrapping="Wrap"
                                                                                   Foreground="#9DBFB3"/>
                                                                        <TextBlock Grid.Row="2"
                                                                                   Text="{Binding Waveform}"
                                                                                   FontFamily="Consolas"
                                                                                   FontSize="10"
                                                                                   TextWrapping="NoWrap"
                                                                                   Foreground="#EABF7A"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                    <TextBlock Grid.Row="6"
                                                               Text="Recent XIV files from project memory, stems, diagnostics, and exports."
                                                               FontSize="9"
                                                               TextWrapping="Wrap"
                                                               Foreground="#8D7D68"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding LooperEngineStatus}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap"
                                                       Foreground="#D9C5A5"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="10" CornerRadius="16" Background="#2415120D" BorderBrush="#12F8F0E5" BorderThickness="1" Padding="12">
                                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                            <TextBlock Text="TEST REPORT"
                                                       FontSize="10"
                                                       FontWeight="Black"
                                                       Foreground="#F2EADC"
                                                       LetterSpacing="2.2"/>
                                            <Grid Grid.Row="1" ColumnDefinitions="180,*" ColumnSpacing="8">
                                                <ComboBox ItemsSource="{Binding LooperTestIssues}"
                                                          SelectedItem="{Binding LooperTestIssue}"
                                                          Background="#A80F0C08"
                                                          Foreground="#F8F0E5"/>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding LooperTestNotes}"
                                                         PlaceholderText="What happened during the drum test?"
                                                         Background="#A80F0C08"
                                                         Foreground="#F8F0E5"
                                                         BorderBrush="#22F8F0E5"/>
                                            </Grid>
                                            <WrapPanel Grid.Row="2">
                                                <Button Content="Save test report"
                                                        Command="{Binding SaveLooperTestReportCommand}"
                                                        Padding="14,8"
                                                        Margin="0,0,8,8"
                                                        Background="#6FB6A6"
                                                        Foreground="#15120D"
                                                        FontWeight="Black"/>
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                            <Border CornerRadius="20" Background="#660F0C08" BorderBrush="#18E37B45" BorderThickness="1" Padding="16" Margin="0,14,0,0">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="LOOP STACK" FontSize="11" FontWeight="Black" Foreground="#E37B45" LetterSpacing="2.8"/>
                                            <TextBlock Text="{Binding LoopStackSignal}"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap"
                                                       Foreground="#F8F0E5"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding NextLayerTarget}"
                                                   MaxWidth="320"
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Foreground="#D9C5A5"/>
                                    </Grid>

                                    <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                        <ComboBox ItemsSource="{Binding LayerInstruments}"
                                                  SelectedItem="{Binding LayerInstrument}"
                                                  Background="#A80F0C08"
                                                  Foreground="#F8F0E5"/>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding LayerBeatTargets}"
                                                  SelectedItem="{Binding LayerBeatTarget}"
                                                  Background="#A80F0C08"
                                                  Foreground="#F8F0E5"/>
                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding LayerEffectIntents}"
                                                  SelectedItem="{Binding LayerEffectIntent}"
                                                  Background="#A80F0C08"
                                                  Foreground="#F8F0E5"/>
                                    </Grid>

                                    <TextBox Grid.Row="2"
                                             Text="{Binding LayerNotes}"
                                             PlaceholderText="Layer note: what to record, what beat it hits, what effect it needs..."
                                             Background="#A80F0C08"
                                             Foreground="#F8F0E5"
                                             BorderBrush="#22F8F0E5"/>

                                    <WrapPanel Grid.Row="3">
                                        <Button Content="Prime next layer"
                                                Command="{Binding PrimeNextLayerCommand}"
                                                Padding="14,9"
                                                Margin="0,0,8,8"
                                                Background="#E37B45"
                                                Foreground="#15120D"
                                                FontWeight="Black"/>
                                        <Button Content="Add layer"
                                                Command="{Binding AddPerformanceLayerCommand}"
                                                Padding="14,9"
                                                Margin="0,0,8,8"
                                                Background="#6FB6A6"
                                                Foreground="#15120D"
                                                FontWeight="Black"/>
                                        <Button Content="Clear stack"
                                                Command="{Binding ClearPerformanceLayersCommand}"
                                                Padding="14,9"
                                                Margin="0,0,8,8"
                                                Background="#3315120D"
                                                Foreground="#D9C5A5"
                                                FontWeight="Black"/>
                                    </WrapPanel>

                                    <Border Grid.Row="4" CornerRadius="16" Background="#2615120D" BorderBrush="#12F8F0E5" BorderThickness="1" Padding="13">
                                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                            <Grid ColumnDefinitions="120,*" ColumnSpacing="8">
                                                <TextBox Text="{Binding LayerCountInBeats}"
                                                         PlaceholderText="Count-in"
                                                         Background="#A80F0C08"
                                                         Foreground="#F8F0E5"
                                                         BorderBrush="#22F8F0E5"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding LayerRecordingPlan}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center"
                                                           Foreground="#D9C5A5"/>
                                            </Grid>
                                            <WrapPanel Grid.Row="1">
                                                <Button Content="Start recording"
                                                        Command="{Binding StartLayerRecordingCommand}"
                                                        Padding="14,9"
                                                        Margin="0,0,8,8"
                                                        Background="#F2EADC"
                                                        Foreground="#15120D"
                                                        FontWeight="Black"/>
                                                <Button Content="Stop + save stem"
                                                        Command="{Binding StopLayerRecordingCommand}"
                                                        Padding="14,9"
                                                        Margin="0,0,8,8"
                                                        Background="#E37B45"
                                                        Foreground="#15120D"
                                                        FontWeight="Black"/>
                                                <Button Content="Open stems"
                                                        Command="{Binding OpenStemsFolderCommand}"
                                                        Padding="14,9"
                                                        Margin="0,0,8,8"
                                                        Background="#3315120D"
                                                        Foreground="#D9C5A5"
                                                        FontWeight="Black"/>
                                            </WrapPanel>
                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding LayerRecordingStatus}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Foreground="#9DBFB3"/>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="5" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                        <TextBlock Text="{Binding LoopStackReadiness}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="#D9C5A5"/>
                                        <TextBox Grid.Row="1"
                                                 Text="{Binding ActiveStemPath}"
                                                 IsReadOnly="True"
                                                 PlaceholderText="Latest stem path"
                                                 Background="#3315120D"
                                                 Foreground="#9DBFB3"
                                                 BorderBrush="#12F8F0E5"/>
                                        <WrapPanel Grid.Row="2">
                                            <Button Content="Open latest stem"
                                                    Command="{Binding OpenLatestStemCommand}"
                                                    Padding="14,9"
                                                    Margin="0,0,8,8"
                                                    Background="#3315120D"
                                                    Foreground="#D9C5A5"
                                                    FontWeight="Black"/>
                                            <Button Content="Remove last layer"
                                                    Command="{Binding RemoveLatestPerformanceLayerCommand}"
                                                    Padding="14,9"
                                                    Margin="0,0,8,8"
                                                    Background="#3315120D"
                                                    Foreground="#D9C5A5"
                                                    FontWeight="Black"/>
                                        </WrapPanel>
                                    </Grid>

                                    <ItemsControl Grid.Row="6" ItemsSource="{Binding PerformanceLayers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PerformanceLayerItem">
                                                <Border CornerRadius="16"
                                                        Background="#2615120D"
                                                        BorderBrush="#10F8F0E5"
                                                        BorderThickness="1"
                                                        Padding="12"
                                                        Margin="0,0,0,8">
                                                    <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="10">
                                                        <TextBlock Text="{Binding Order}"
                                                                   FontSize="22"
                                                                   FontWeight="Black"
                                                                   Foreground="#E37B45"
                                                                   VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" Spacing="3">
                                                            <TextBlock Text="{Binding Instrument}"
                                                                       FontSize="14"
                                                                       FontWeight="Black"
                                                                       Foreground="#F8F0E5"/>
                                                            <TextBlock Text="{Binding Notes}"
                                                                       FontSize="11"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="#D9C5A5"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Spacing="3" HorizontalAlignment="Right" MaxWidth="220">
                                                            <TextBlock Text="{Binding BeatTarget}"
                                                                       FontSize="11"
                                                                       FontWeight="Bold"
                                                                       Foreground="#C8A96B"
                                                                       TextAlignment="Right"/>
                                                            <TextBlock Text="{Binding EffectIntent}"
                                                                       FontSize="11"
                                                                       Foreground="#9DBFB3"
                                                                       TextAlignment="Right"/>
                                                            <TextBlock Text="{Binding DurationLabel}"
                                                                       FontSize="10"
                                                                       Foreground="#8E8170"
                                                                       TextAlignment="Right"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                            <Border CornerRadius="20" Background="#660F0C08" BorderBrush="#14F2EADC" BorderThickness="1" Padding="16" Margin="0,14,0,0">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="RC-505 SONG PLAN" FontSize="11" FontWeight="Black" Foreground="#F2EADC" LetterSpacing="2.8"/>
                                            <TextBlock Text="{Binding PerformancePlanSignal}"
                                                       FontSize="14"
                                                       FontWeight="Black"
                                                       TextWrapping="Wrap"
                                                       Foreground="#F8F0E5"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="Prime next section"
                                                Command="{Binding PrimeNextSectionCommand}"
                                                Padding="14,9"
                                                Background="#F2EADC"
                                                Foreground="#15120D"
                                                FontWeight="Black"/>
                                    </Grid>

                                    <Border Grid.Row="1" CornerRadius="24" Padding="18" BorderBrush="#1FE37B45" BorderThickness="1">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                <GradientStop Color="#2A1A0F08" Offset="0"/>
                                                <GradientStop Color="#1B221A12" Offset="0.56"/>
                                                <GradientStop Color="#10100C" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                                            <TextBlock Text="{Binding PerformanceModeStatus}"
                                                       FontSize="11"
                                                       FontWeight="Black"
                                                       Foreground="#C8A96B"
                                                       LetterSpacing="2.4"/>
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding LiveCueTitle}"
                                                       FontSize="32"
                                                       FontWeight="Black"
                                                       TextWrapping="Wrap"
                                                       Foreground="#F8F0E5"/>
                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding LiveCuePrimary}"
                                                       FontSize="20"
                                                       FontWeight="Black"
                                                       TextWrapping="Wrap"
                                                       Foreground="#E37B45"/>
                                            <TextBlock Grid.Row="3"
                                                       Text="{Binding LiveCueNextMove}"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap"
                                                       Foreground="#D9C5A5"/>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <ComboBox ItemsSource="{Binding SongSections}"
                                                  SelectedItem="{Binding SongSection}"
                                                  Background="#A80F0C08"
                                                  Foreground="#F8F0E5"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding Rc505MemorySlot}"
                                                 PlaceholderText="RC-505 memory slot"
                                                 Background="#A80F0C08"
                                                 Foreground="#F8F0E5"
                                                 BorderBrush="#22F8F0E5"/>
                                    </Grid>

                                    <TextBox Grid.Row="3"
                                             Text="{Binding PerformanceCueNotes}"
                                             PlaceholderText="RC-505 cue notes: when to overdub, mute, sing, drop layers..."
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="78"
                                             Background="#A80F0C08"
                                             Foreground="#F8F0E5"
                                             BorderBrush="#22F8F0E5"/>

                                    <Border Grid.Row="4" CornerRadius="16" Background="#2615120D" Padding="12">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{Binding LiveCueSecondary}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap"
                                                       Foreground="#9DBFB3"/>
                                            <TextBlock Text="{Binding Rc505CueSheet}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Foreground="#D9C5A5"/>
                                        </StackPanel>
                                    </Border>

                                    <WrapPanel Grid.Row="5">
                                        <Button Content="Save performance plan"
                                                Command="{Binding SavePerformancePlanCommand}"
                                                Padding="14,9"
                                                Margin="0,0,8,8"
                                                Background="#6FB6A6"
                                                Foreground="#15120D"
                                                FontWeight="Black"/>
                                        <Button Content="Complete section"
                                                Command="{Binding CompleteCurrentSectionCommand}"
                                                Padding="14,9"
                                                Margin="0,0,8,8"
                                                Background="#E37B45"
                                                Foreground="#15120D"
                                                FontWeight="Black"/>
                                    </WrapPanel>
                                </Grid>
                            </Border>
                            <Border CornerRadius="20" Background="#660F0C08" BorderBrush="#0EF8F0E5" BorderThickness="1" Padding="16" Margin="0,14,0,0">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="ALWAYS-ON VISUAL PAINTING" FontSize="11" FontWeight="Black" Foreground="#D9B36F" LetterSpacing="2.8"/>
                                            <TextBlock Text="{Binding VisualPaintingSignal}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Foreground="#D9C5A5"/>
                                        </StackPanel>
                                        <WrapPanel Grid.Column="1">
                                            <Button Content="Start art feed"
                                                    Command="{Binding StartVisualizerFeedCommand}"
                                                    Padding="14,8"
                                                    Margin="0,0,8,8"
                                                    Background="#F2EADC"
                                                    Foreground="#15120D"
                                                    FontWeight="Black"/>
                                            <Button Content="Reveal"
                                                    Command="{Binding RevealVisualizerPaintingCommand}"
                                                    Padding="14,8"
                                                    Margin="0,0,8,8"
                                                    Background="#E37B45"
                                                    Foreground="#15120D"
                                                    FontWeight="Black"/>
                                            <Button Content="Export artwork"
                                                    Command="{Binding ExportVisualPaintingCommand}"
                                                    Padding="14,8"
                                                    Margin="0,0,8,8"
                                                    Background="#6FB6A6"
                                                    Foreground="#15120D"
                                                    FontWeight="Black"/>
                                        </WrapPanel>
                                    </Grid>

                                    <Border Grid.Row="1" CornerRadius="28" Padding="21" BorderBrush="#24F8F0E5" BorderThickness="1" MinHeight="320">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                <GradientStop Color="#3015120D" Offset="0"/>
                                                <GradientStop Color="#241D2A18" Offset="0.35"/>
                                                <GradientStop Color="#10251F1A" Offset="0.72"/>
                                                <GradientStop Color="#090806" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="13">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="13">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding VisualPaintingTitle}"
                                                               FontSize="30"
                                                               FontWeight="Black"
                                                               Foreground="#F8F0E5"/>
                                                    <TextBlock Text="{Binding VisualPaintingMood}"
                                                               FontSize="13"
                                                               FontWeight="Bold"
                                                               Foreground="#E37B45"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding InputMeterLabel}"
                                                           FontSize="11"
                                                           Foreground="#9DBFB3"
                                                           VerticalAlignment="Top"/>
                                            </Grid>

                                            <Grid Grid.Row="1" ClipToBounds="True">
                                                <Border Width="{Binding VisualBloomSize}"
                                                        Height="{Binding VisualBloomSize}"
                                                        CornerRadius="999"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Background="#26E37B45"/>
                                                <Border Width="{Binding VisualPulseSize}"
                                                        Height="{Binding VisualPulseSize}"
                                                        CornerRadius="999"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Background="#446FB6A6"/>
                                                <Border Width="89"
                                                        Height="89"
                                                        CornerRadius="999"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Background="#D9F8F0E5"/>
                                                <Grid VerticalAlignment="Bottom" ColumnDefinitions="*,*,*,*,*,*,*,*" ColumnSpacing="8" Height="89" Margin="0,0,0,4">
                                                    <ProgressBar Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding VisualStrokeLevel}" Orientation="Vertical" Foreground="#E37B45" Background="#17120D"/>
                                                    <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding InputMeterLevel}" Orientation="Vertical" Foreground="#6FB6A6" Background="#17120D"/>
                                                    <ProgressBar Grid.Column="2" Minimum="0" Maximum="100" Value="{Binding VisualizerIntensity}" Orientation="Vertical" Foreground="#EABF7A" Background="#17120D"/>
                                                    <ProgressBar Grid.Column="3" Minimum="0" Maximum="100" Value="{Binding VisualStrokeLevel}" Orientation="Vertical" Foreground="#D9C5A5" Background="#17120D"/>
                                                    <ProgressBar Grid.Column="4" Minimum="0" Maximum="100" Value="{Binding InputMeterLevel}" Orientation="Vertical" Foreground="#9DBFB3" Background="#17120D"/>
                                                    <ProgressBar Grid.Column="5" Minimum="0" Maximum="100" Value="{Binding VisualizerIntensity}" Orientation="Vertical" Foreground="#E37B45" Background="#17120D"/>
                                                    <ProgressBar Grid.Column="6" Minimum="0" Maximum="100" Value="{Binding VisualStrokeLevel}" Orientation="Vertical" Foreground="#6FB6A6" Background="#17120D"/>
                                                    <ProgressBar Grid.Column="7" Minimum="0" Maximum="100" Value="{Binding InputMeterLevel}" Orientation="Vertical" Foreground="#F2EADC" Background="#17120D"/>
                                                </Grid>
                                            </Grid>

                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding VisualPaintingStatus}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap"
                                                       Foreground="#D9C5A5"/>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="2" CornerRadius="16" Background="#2615120D" Padding="12">
                                        <TextBlock Text="{Binding VisualPaintingComposition}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap"
                                                   Foreground="#9DBFB3"/>
                                    </Border>

                                    <Grid Grid.Row="3" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                        <ComboBox ItemsSource="{Binding VisualizerModes}"
                                                  SelectedItem="{Binding VisualizerMode}"
                                                  Background="#A80F0C08"
                                                  Foreground="#F8F0E5"/>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding VisualizerPalettes}"
                                                  SelectedItem="{Binding VisualizerPalette}"
                                                  Background="#A80F0C08"
                                                  Foreground="#F8F0E5"/>
                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding VisualizerMotions}"
                                                  SelectedItem="{Binding VisualizerMotion}"
                                                  Background="#A80F0C08"
                                                  Foreground="#F8F0E5"/>
                                    </Grid>

                                    <Grid Grid.Row="4" ColumnDefinitions="*,*,120" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                        <ComboBox ItemsSource="{Binding VisualizerQualityModes}"
                                                  SelectedItem="{Binding VisualizerQualityMode}"
                                                  Background="#A80F0C08"
                                                  Foreground="#F8F0E5"/>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding VisualizerOutputTargets}"
                                                  SelectedItem="{Binding VisualizerOutputTarget}"
                                                  Background="#A80F0C08"
                                                  Foreground="#F8F0E5"/>
                                        <CheckBox Grid.Column="2"
                                                  Content="DAW safe"
                                                  IsChecked="{Binding DawSafeMode}"
                                                  Foreground="#F8F0E5"
                                                  VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding VisualizerLyricSource}"
                                                 Grid.Row="1"
                                                 PlaceholderText="Lyric source"
                                                 Background="#A80F0C08"
                                                 Foreground="#F8F0E5"
                                                 BorderBrush="#22F8F0E5"/>
                                        <TextBox Grid.Row="1"
                                                 Grid.Column="1"
                                                 Text="{Binding VisualizerIntensity}"
                                                 PlaceholderText="Intensity"
                                                 Background="#A80F0C08"
                                                 Foreground="#F8F0E5"
                                                 BorderBrush="#22F8F0E5"/>
                                        <CheckBox Grid.Row="1"
                                                  Grid.Column="2"
                                                  Content="Blackout"
                                                  IsChecked="{Binding ProjectorBlackout}"
                                                  Foreground="#F8F0E5"
                                                  VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="2"
                                                  Grid.ColumnSpan="2"
                                                  ItemsSource="{Binding VisualizerRendererPaths}"
                                                  SelectedItem="{Binding VisualizerRendererPath}"
                                                  Background="#A80F0C08"
                                                  Foreground="#F8F0E5"/>
                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="2"
                                                   Text="{Binding VisualizerRendererGuidance}"
                                                   FontSize="10"
                                                   LineHeight="13"
                                                   TextWrapping="Wrap"
                                                   Foreground="#9DBFB3"/>
                                        <TextBox Grid.Row="3"
                                                  Grid.ColumnSpan="3"
                                                  Text="{Binding VisualizerNotes}"
                                                  PlaceholderText="Visualizer notes"
                                                  Background="#A80F0C08"
                                                  Foreground="#F8F0E5"
                                                  BorderBrush="#22F8F0E5"/>
                                        <TextBlock Grid.Row="4"
                                                   Grid.ColumnSpan="3"
                                                   Text="{Binding VisualRendererControlSignal}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap"
                                                   Foreground="#D9C5A5"/>
                                    </Grid>

                                    <WrapPanel Grid.Row="5">
                                        <Button Content="Save visual"
                                                Command="{Binding SaveVisualizerCommand}"
                                                Padding="14,8"
                                                Margin="0,0,8,8"
                                                Background="#6FB6A6"
                                                Foreground="#15120D"
                                                FontWeight="Black"/>
                                        <Button Content="Reset painting"
                                                Command="{Binding ResetVisualizerPaintingCommand}"
                                                Padding="14,8"
                                                Margin="0,0,8,8"
                                                Background="#3315120D"
                                                Foreground="#D9C5A5"
                                                FontWeight="Black"/>
                                        <Button Content="Stamp visual"
                                                Command="{Binding StampCurrentVisualCommand}"
                                                Padding="14,8"
                                                Margin="0,0,8,8"
                                                Background="#E37B45"
                                                Foreground="#15120D"
                                                FontWeight="Black"/>
                                        <Button Content="Export artwork"
                                                Command="{Binding ExportVisualPaintingCommand}"
                                                Padding="14,8"
                                                Margin="0,0,8,8"
                                                Background="#F2EADC"
                                                Foreground="#15120D"
                                                FontWeight="Black"/>
                                        <Button Content="Export renderer packet"
                                                Command="{Binding ExportRendererControlSnapshotCommand}"
                                                Padding="14,8"
                                                Margin="0,0,8,8"
                                                Background="#3315120D"
                                                Foreground="#D9C5A5"
                                                FontWeight="Black"/>
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Border Grid.Row="1" CornerRadius="32" Background="#B5120F0B" Padding="24"
                                BorderBrush="#18F8F0E5" BorderThickness="1">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="16">
                                <TextBlock Classes="label" Text="SYNC WORKBENCH"/>

                                <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                    <TextBox Text="{Binding VideoPath}"
                                             PlaceholderText="Paste camera video path"
                                             Background="#A80F0C08"
                                             Foreground="#F8F0E5"
                                             BorderBrush="#22F8F0E5"/>
                                    <TextBox Grid.Row="1"
                                             Text="{Binding VocalPath}"
                                             PlaceholderText="Paste final vocal/audio path"
                                             Background="#A80F0C08"
                                             Foreground="#F8F0E5"
                                             BorderBrush="#22F8F0E5"/>
                                    <WrapPanel Grid.Row="2">
                                        <Button Content="Browse video"
                                                Click="BrowseVideo_Click"
                                                Padding="14,9"
                                                Margin="0,0,8,8"
                                                Background="#1F1A13"
                                                Foreground="#D9C5A5"/>
                                        <Button Content="Browse audio"
                                                Click="BrowseVocal_Click"
                                                Padding="14,9"
                                                Margin="0,0,8,8"
                                                Background="#1F1A13"
                                                Foreground="#D9C5A5"/>
                                        <Button Content="Inspect media"
                                                Command="{Binding InspectMediaCommand}"
                                                Padding="16,9"
                                                Margin="0,0,8,8"
                                                Background="#1F1A13"
                                                Foreground="#D9C5A5"
                                                FontWeight="Black"/>
                                        <Button Content="Analyze sync"
                                                Command="{Binding AnalyzeMediaCommand}"
                                                Padding="16,9"
                                                Margin="0,0,8,8"
                                                Background="#F2EADC"
                                                Foreground="#15120D"
                                                FontWeight="Black"/>
                                    </WrapPanel>
                                </Grid>

                                <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                    <Border CornerRadius="18" Background="#130F0B" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SyncOffsetMs, StringFormat={}{0:+#;-#;0} ms}" FontSize="30" FontWeight="Black" Foreground="#E37B45"/>
                                            <TextBlock Text="vocal offset" FontSize="11" Foreground="#8E8170"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" CornerRadius="18" Background="#130F0B" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SyncConfidence, StringFormat={}{0:P0}}" FontSize="30" FontWeight="Black" Foreground="#EABF7A"/>
                                            <TextBlock Text="sync confidence" FontSize="11" Foreground="#8E8170"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" CornerRadius="18" Background="#130F0B" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="{Binding LoudnessTarget}" FontSize="26" FontWeight="Black" Foreground="#6FB6A6"/>
                                            <TextBlock Text="export loudness" FontSize="11" Foreground="#8E8170"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="3" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <TextBlock Text="VIDEO" Width="54" FontSize="10" FontWeight="Black" Foreground="#8E8170"/>
                                        <TextBlock Grid.Column="1" Text="{Binding VideoFileName}" FontSize="11" Foreground="#D9C5A5"/>
                                        <TextBlock Grid.Column="2" Text="{Binding VideoDuration}" FontSize="11" Foreground="#6FB6A6"/>
                                    </Grid>
                                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <TextBlock Text="VOCAL" Width="54" FontSize="10" FontWeight="Black" Foreground="#8E8170"/>
                                        <TextBlock Grid.Column="1" Text="{Binding VocalFileName}" FontSize="11" Foreground="#D9C5A5"/>
                                        <TextBlock Grid.Column="2" Text="{Binding VocalDuration}" FontSize="11" Foreground="#6FB6A6"/>
                                    </Grid>
                                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Waveform}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="3"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:WaveformBar">
                                                <Border Width="5"
                                                        Height="{Binding Height}"
                                                        CornerRadius="3"
                                                        VerticalAlignment="Center"
                                                        Background="#E37B45"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>

                                <TextBlock Grid.Row="4"
                                           Text="{Binding SyncRecommendation}"
                                           FontSize="12"
                                           LineHeight="19"
                                           TextWrapping="Wrap"
                                           Foreground="#D9C5A5"/>

                                <Grid Grid.Row="5" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="8">
                                    <Button Content="-100"
                                            Command="{Binding NudgeOffsetCommand}"
                                            CommandParameter="-100"
                                            Padding="10,8"
                                            Background="#1F1A13"
                                            Foreground="#D9C5A5"/>
                                    <Button Grid.Column="1"
                                            Content="-10"
                                            Command="{Binding NudgeOffsetCommand}"
                                            CommandParameter="-10"
                                            Padding="10,8"
                                            Background="#1F1A13"
                                            Foreground="#D9C5A5"/>
                                    <Button Grid.Column="2"
                                            Content="0"
                                            Command="{Binding ResetOffsetCommand}"
                                            Padding="10,8"
                                            Background="#F2EADC"
                                            Foreground="#15120D"/>
                                    <Button Grid.Column="3"
                                            Content="+10"
                                            Command="{Binding NudgeOffsetCommand}"
                                            CommandParameter="10"
                                            Padding="10,8"
                                            Background="#1F1A13"
                                            Foreground="#D9C5A5"/>
                                    <Button Grid.Column="4"
                                            Content="+100"
                                            Command="{Binding NudgeOffsetCommand}"
                                            CommandParameter="100"
                                            Padding="10,8"
                                            Background="#1F1A13"
                                            Foreground="#D9C5A5"/>
                                </Grid>

                                <ItemsControl Grid.Row="6" ItemsSource="{Binding Ritual}" IsVisible="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,10">
                                                <Border Width="22" Height="22" CornerRadius="11" Background="#6FB6A6" Margin="0,1,12,0">
                                                    <TextBlock Text="+" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="#15120D" FontSize="14" FontWeight="Black"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12" LineHeight="19"
                                                           TextWrapping="Wrap" Foreground="#D9C5A5"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Spacing="21">
                    <Border Classes="card">
                        <StackPanel>
                            <TextBlock Classes="label" Text="SESSION LOG"/>
                            <ItemsControl ItemsSource="{Binding RecentCaptures}" Margin="0,18,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CaptureItem">
                                        <Border CornerRadius="18" Background="#8F0F0C08" BorderBrush="#0EF8F0E5"
                                                BorderThickness="1" Padding="14" Margin="0,0,0,10">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Black" Foreground="#F8F0E5"/>
                                                    <TextBlock Text="{Binding Detail}" Margin="0,5,0,0" FontSize="12"
                                                               TextWrapping="Wrap" Foreground="#8E8170"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" CornerRadius="999" Background="#22E37B45"
                                                        Padding="10,5" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Black" Foreground="#E37B45"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border CornerRadius="18" Background="#660F0C08" BorderBrush="#0EF8F0E5" BorderThickness="1" Padding="16" Margin="0,10,0,0">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                                    <TextBlock Text="TIMELINE MARKERS" FontSize="11" FontWeight="Black" Foreground="#D9B36F" LetterSpacing="2.8"/>
                                    <Grid Grid.Row="1" ColumnDefinitions="92,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                        <TextBox Text="{Binding MarkerTimecode}"
                                                 PlaceholderText="00:00.000"
                                                 Background="#A80F0C08"
                                                 Foreground="#F8F0E5"
                                                 BorderBrush="#22F8F0E5"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding MarkerLabel}"
                                                 PlaceholderText="Marker"
                                                 Background="#A80F0C08"
                                                 Foreground="#F8F0E5"
                                                 BorderBrush="#22F8F0E5"/>
                                        <Button Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                Content="Add"
                                                Command="{Binding AddTimelineMarkerCommand}"
                                                Padding="14,9"
                                                Background="#EABF7A"
                                                Foreground="#15120D"
                                                FontWeight="Black"/>
                                    </Grid>
                                    <ItemsControl Grid.Row="2" ItemsSource="{Binding TimelineMarkers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TimelineMarker">
                                                <Grid ColumnDefinitions="74,*" Margin="0,0,0,7">
                                                    <TextBlock Text="{Binding Timecode}" FontSize="11" FontWeight="Black" Foreground="#6FB6A6"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="11" Foreground="#D9C5A5"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>

                            <Border CornerRadius="18" Background="#660F0C08" BorderBrush="#0EF8F0E5" BorderThickness="1" Padding="16" Margin="0,10,0,0">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                        <TextBlock Text="LYRIC VAULT" FontSize="11" FontWeight="Black" Foreground="#D9B36F" LetterSpacing="2.8"/>
                                        <WrapPanel Grid.Row="1">
                                            <Button Content="Use latest"
                                                    Command="{Binding UseLatestLyricCommand}"
                                                    Padding="12,7"
                                                    Margin="0,0,8,8"
                                                    Background="#1F1A13"
                                                    Foreground="#D9C5A5"/>
                                            <Button Content="Save lyric"
                                                    Command="{Binding SaveLyricIdeaCommand}"
                                                    Padding="12,7"
                                                    Margin="0,0,8,8"
                                                    Background="#E37B45"
                                                    Foreground="#15120D"
                                                    FontWeight="Black"/>
                                        </WrapPanel>
                                    </Grid>
                                    <Grid Grid.Row="1" ColumnDefinitions="*,110,130" ColumnSpacing="8">
                                        <TextBox Text="{Binding LyricTitle}"
                                                 PlaceholderText="Title / hook name"
                                                 Background="#A80F0C08"
                                                 Foreground="#F8F0E5"
                                                 BorderBrush="#22F8F0E5"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding LyricMood}"
                                                 PlaceholderText="Mood"
                                                 Background="#A80F0C08"
                                                 Foreground="#F8F0E5"
                                                 BorderBrush="#22F8F0E5"/>
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding LyricTags}"
                                                 PlaceholderText="Tags"
                                                 Background="#A80F0C08"
                                                 Foreground="#F8F0E5"
                                                 BorderBrush="#22F8F0E5"/>
                                    </Grid>
                                    <TextBox Grid.Row="2"
                                             Text="{Binding LyricText}"
                                             PlaceholderText="Write lines, hook fragments, vowel shapes, rhyme ideas..."
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="98"
                                             Background="#A80F0C08"
                                             Foreground="#F8F0E5"
                                             BorderBrush="#22F8F0E5"/>
                                    <ItemsControl Grid.Row="3" ItemsSource="{Binding LyricIdeas}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:LyricIdeaItem">
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,7">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="Black" Foreground="#D9C5A5"/>
                                                        <TextBlock Text="{Binding Preview}" FontSize="10" TextWrapping="Wrap" Foreground="#8E8170"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Mood}" FontSize="10" Foreground="#6FB6A6"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>

                            <Border CornerRadius="18" Background="#660F0C08" BorderBrush="#0EF8F0E5" BorderThickness="1" Padding="16" Margin="0,10,0,0">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                                    <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                                        <TextBlock Text="TAKE DECISION" FontSize="11" FontWeight="Black" Foreground="#D9B36F" LetterSpacing="2.8"/>
                                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock Text="{Binding TakeDecisionSignal}" FontSize="10" TextWrapping="Wrap" Foreground="#6FB6A6"/>
                                            <Button Grid.Column="1"
                                                    Content="Prime"
                                                    Command="{Binding PrimeTakeDecisionCommand}"
                                                    Padding="10,6"
                                                    Background="#1F1A13"
                                                    Foreground="#D9C5A5"/>
                                        </Grid>
                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding SelectedAutosaveTakeSignal}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap"
                                                   Foreground="#EABF7A"/>
                                    </Grid>
                                    <Grid Grid.Row="1" ColumnDefinitions="*,70,130" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                        <TextBox Text="{Binding TakeName}"
                                                 PlaceholderText="Take name"
                                                 Background="#A80F0C08"
                                                 Foreground="#F8F0E5"
                                                 BorderBrush="#22F8F0E5"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding TakeRating}"
                                                 PlaceholderText="1-5"
                                                 Background="#A80F0C08"
                                                 Foreground="#F8F0E5"
                                                 BorderBrush="#22F8F0E5"/>
                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding TakeDecisions}"
                                                  SelectedItem="{Binding TakeDecision}"
                                                  Background="#A80F0C08"
                                                  Foreground="#F8F0E5"
                                                  BorderBrush="#22F8F0E5"/>
                                        <Button Grid.Row="1"
                                                Grid.ColumnSpan="3"
                                                Content="Save"
                                                Command="{Binding SaveTakeReviewCommand}"
                                                Padding="14,9"
                                                Background="#6FB6A6"
                                                Foreground="#15120D"
                                                FontWeight="Black"/>
                                    </Grid>
                                    <TextBox Grid.Row="2"
                                             Text="{Binding TakeNotes}"
                                             PlaceholderText="What worked, what failed, exact line or timestamp..."
                                             Background="#A80F0C08"
                                             Foreground="#F8F0E5"
                                             BorderBrush="#22F8F0E5"/>
                                    <TextBox Grid.Row="3"
                                             Text="{Binding TakeNextAction}"
                                             PlaceholderText="Next action: keep, punch in, re-record, caption, export..."
                                             Background="#A80F0C08"
                                             Foreground="#F8F0E5"
                                             BorderBrush="#22F8F0E5"/>
                                    <TextBlock Grid.Row="4"
                                               Text="{Binding TakeDecisionGuidance}"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Foreground="#8E8170"/>
                                    <ItemsControl Grid.Row="5" ItemsSource="{Binding TakeReviews}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TakeReviewItem">
                                                <Border CornerRadius="12" Background="#661F1A13" Padding="9" Margin="0,0,0,7">
                                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="3">
                                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Black" Foreground="#D9C5A5"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Decision}" FontSize="11" FontWeight="Black" Foreground="#6FB6A6"/>
                                                        <TextBlock Grid.Row="1" Text="{Binding Notes}" FontSize="10" TextWrapping="Wrap" Foreground="#8E8170"/>
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Rating}" FontSize="11" FontWeight="Black" Foreground="#EABF7A"/>
                                                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding NextAction}" FontSize="10" TextWrapping="Wrap" Foreground="#D9B36F"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>

                            <Border CornerRadius="18" Background="#660F0C08" BorderBrush="#0EF8F0E5" BorderThickness="1" Padding="16" Margin="0,10,0,0">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="9">
                                    <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                                        <TextBlock Text="HARDWARE ROUTING" FontSize="11" FontWeight="Black" Foreground="#D9B36F" LetterSpacing="2.8"/>
                                        <WrapPanel Grid.Row="1">
                                            <Button Content="Scan"
                                                    Command="{Binding ScanHardwareCommand}"
                                                    Padding="12,7"
                                                    Margin="0,0,8,8"
                                                    Background="#1F1A13"
                                                    Foreground="#D9C5A5"/>
                                        </WrapPanel>
                                    </Grid>
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding HardwareStatus}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="#D9C5A5"/>
                                    <Grid Grid.Row="2" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                        <TextBox Text="{Binding PreferredAudioInput}"
                                                 PlaceholderText="Focusrite input"
                                                 Background="#A80F0C08"
                                                 Foreground="#F8F0E5"
                                                 BorderBrush="#22F8F0E5"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding PreferredAudioOutput}"
                                                 PlaceholderText="Focusrite output"
                                                 Background="#A80F0C08"
                                                 Foreground="#F8F0E5"
                                                 BorderBrush="#22F8F0E5"/>
                                        <TextBox Grid.Row="1"
                                                 Text="{Binding PreferredMidiInput}"
                                                 PlaceholderText="RC-505 MIDI in"
                                                 Background="#A80F0C08"
                                                 Foreground="#F8F0E5"
                                                 BorderBrush="#22F8F0E5"/>
                                        <TextBox Grid.Row="1"
                                                 Grid.Column="1"
                                                 Text="{Binding PreferredMidiOutput}"
                                                 PlaceholderText="RC-505 MIDI out"
                                                 Background="#A80F0C08"
                                                 Foreground="#F8F0E5"
                                                 BorderBrush="#22F8F0E5"/>
                                    </Grid>
                                    <TextBox Grid.Row="3"
                                             Text="{Binding RoutingNotes}"
                                             PlaceholderText="Routing notes: mic, loop station, monitoring..."
                                             Background="#A80F0C08"
                                             Foreground="#F8F0E5"
                                             BorderBrush="#22F8F0E5"/>
                                    <Grid Grid.Row="4" RowDefinitions="Auto,Auto" RowSpacing="8">
                                        <Border CornerRadius="999" Background="#130F0B" BorderBrush="#22F8F0E5" BorderThickness="1" Padding="10,7">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <ProgressBar Minimum="0"
                                                             Maximum="100"
                                                             Value="{Binding InputMeterLevel}"
                                                             Height="8"
                                                             VerticalAlignment="Center"
                                                             Foreground="#6FB6A6"
                                                             Background="#241F17"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding InputMeterLabel}"
                                                           FontSize="10"
                                                           Foreground="#D9C5A5"/>
                                            </Grid>
                                        </Border>
                                        <WrapPanel Grid.Row="1">
                                            <Button Content="Start meter"
                                                    Command="{Binding StartInputMeterCommand}"
                                                    Padding="12,7"
                                                    Margin="0,0,8,8"
                                                    Background="#EABF7A"
                                                    Foreground="#15120D"
                                                    FontWeight="Black"/>
                                            <Button Content="Stop"
                                                    Command="{Binding StopInputMeterCommand}"
                                                    Padding="12,7"
                                                    Margin="0,0,8,8"
                                                    Background="#1F1A13"
                                                    Foreground="#D9C5A5"/>
                                        </WrapPanel>
                                    </Grid>
                                    <Grid Grid.Row="5" RowDefinitions="Auto,Auto" RowSpacing="8">
                                        <ItemsControl ItemsSource="{Binding HardwareDevices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="svc:HardwareDevice">
                                                    <TextBlock Text="{Binding Label}" FontSize="10" Foreground="#8E8170"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <WrapPanel Grid.Row="1">
                                            <Button Content="Save routing"
                                                    Command="{Binding SaveHardwareRoutingCommand}"
                                                    Padding="12,7"
                                                    Margin="0,0,8,8"
                                                    Background="#6FB6A6"
                                                    Foreground="#15120D"
                                                    FontWeight="Black"/>
                                        </WrapPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Classes="card">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="16">
                            <TextBlock Classes="label" Text="WORK NOTE"/>
                            <TextBlock Text="{Binding ActiveRoom}"
                                       Margin="0,12,0,18"
                                       FontSize="30"
                                       FontWeight="Black"
                                       TextWrapping="Wrap"
                                       Foreground="#F8F0E5"/>

                            <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="8">
                                <TextBox Text="{Binding CaptureTitle}"
                                         PlaceholderText="Capture title"
                                         Background="#A80F0C08"
                                         Foreground="#F8F0E5"
                                         BorderBrush="#22F8F0E5"/>
                                <ComboBox Grid.Row="1"
                                          ItemsSource="{Binding Moods}"
                                          SelectedItem="{Binding Mood}"
                                          Background="#A80F0C08"
                                          Foreground="#F8F0E5"/>
                            </Grid>

                            <Border Grid.Row="3" CornerRadius="18" Background="#660F0C08" BorderBrush="#0EF8F0E5" BorderThickness="1" Padding="16">
                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="9">
                                    <TextBlock Text="COMMAND BAR" FontSize="11" FontWeight="Black" Foreground="#D9B36F" LetterSpacing="2.8"/>
                                    <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="8">
                                        <TextBox Text="{Binding CommandText}"
                                                 PlaceholderText="Try: add captions, sync video, make drums warmer, add vocal layers, export reels..."
                                                 Background="#A80F0C08"
                                                 Foreground="#F8F0E5"
                                                 BorderBrush="#22F8F0E5"/>
                                        <WrapPanel Grid.Row="1">
                                            <Button Content="Run"
                                                    Command="{Binding RunCommandCommand}"
                                                    Padding="16,9"
                                                    Margin="0,0,8,8"
                                                    Background="#E37B45"
                                                    Foreground="#15120D"
                                                    FontWeight="Black"/>
                                        </WrapPanel>
                                    </Grid>
                                    <TextBlock Grid.Row="2"
                                               Text="{Binding CommandResponse}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="#D9C5A5"/>
                                </Grid>
                            </Border>

                            <TextBox Grid.Row="4"
                                     Text="{Binding CaptureNotes}"
                                     PlaceholderText="{Binding CaptureHint}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Background="#A80F0C08"
                                     Foreground="#F8F0E5"
                                     BorderBrush="#22F8F0E5"
                                     MinHeight="112"/>

                            <Grid Grid.Row="5" RowDefinitions="Auto,Auto" RowSpacing="10">
                                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" Foreground="#8E8170"/>
                                <WrapPanel Grid.Row="1">
                                    <Button Content="Pin current"
                                            Command="{Binding PinCurrentCaptureCommand}"
                                            Padding="17,10"
                                            Margin="0,0,8,8"
                                            Background="#E37B45"
                                            Foreground="#15120D"
                                            FontWeight="Black"/>
                                    <Button Content="Clear"
                                            Command="{Binding ClearCaptureCommand}"
                                            Padding="17,10"
                                            Margin="0,0,8,8"
                                            Background="#1F1A13"
                                            Foreground="#D9C5A5"/>
                                    <Button Content="Save"
                                            Command="{Binding SaveCaptureCommand}"
                                            Padding="20,10"
                                            Margin="0,0,8,8"
                                            Background="#F2EADC"
                                            Foreground="#15120D"
                                            FontWeight="Black"/>
                                </WrapPanel>
                            </Grid>

                            <Border Grid.Row="6" CornerRadius="18" Background="#660F0C08" BorderBrush="#0EF8F0E5" BorderThickness="1" Padding="16">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="9">
                                    <TextBlock Text="EXPORT RENDER" FontSize="11" FontWeight="Black" Foreground="#D9B36F" LetterSpacing="2.8"/>
                                    <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="10">
                                        <ComboBox ItemsSource="{Binding ExportPresets}"
                                                  SelectedItem="{Binding SelectedExportPreset}"
                                                  Background="#A80F0C08"
                                                  Foreground="#F8F0E5">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <WrapPanel Grid.Row="1">
                                            <Button Content="Render review"
                                                    Command="{Binding RenderReviewClipCommand}"
                                                    Padding="16,9"
                                                    Margin="0,0,8,8"
                                                    Background="#6FB6A6"
                                                    Foreground="#15120D"
                                                    FontWeight="Black"/>
                                            <Button Content="Queue"
                                                    Command="{Binding QueueCurrentExportCommand}"
                                                    Padding="16,9"
                                                    Margin="0,0,8,8"
                                                    Background="#EABF7A"
                                                    Foreground="#15120D"
                                                    FontWeight="Black"/>
                                        </WrapPanel>
                                    </Grid>
                                    <ComboBox Grid.Row="2"
                                              ItemsSource="{Binding AudioPresets}"
                                              SelectedItem="{Binding SelectedAudioPreset}"
                                              Background="#A80F0C08"
                                              Foreground="#F8F0E5">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Grid.Row="3"
                                               Text="{Binding SelectedAudioPresetDescription}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="#8E8170"/>
                                    <TextBox Grid.Row="4"
                                             Text="{Binding OutputDirectory}"
                                             PlaceholderText="Output directory"
                                             Background="#A80F0C08"
                                             Foreground="#F8F0E5"
                                             BorderBrush="#22F8F0E5"/>
                                    <TextBlock Grid.Row="5"
                                               Text="{Binding LastExportPath}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="#8E8170"/>
                                    <TextBlock Grid.Row="6"
                                               Text="{Binding ToolchainDetail}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="#D9C5A5"/>
                                    <Grid Grid.Row="7" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBlock Text="{Binding ToolchainInstallHint}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="#8E8170"/>
                                        <Button Grid.Column="1"
                                                Content="Recheck"
                                                Command="{Binding RefreshToolchainCommand}"
                                                Padding="14,8"
                                                Background="#1F1A13"
                                                Foreground="#D9C5A5"/>
                                    </Grid>
                                    <Border Grid.Row="8" CornerRadius="16" Background="#55130F0B" BorderBrush="#0EF8F0E5" BorderThickness="1" Padding="14">
                                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                                                <TextBlock Text="CAPTIONS" FontSize="11" FontWeight="Black" Foreground="#D9B36F" LetterSpacing="2.8"/>
                                                <Grid Grid.Row="1" ColumnDefinitions="90,*" ColumnSpacing="8">
                                                    <TextBox
                                                         Text="{Binding CaptionBeats}"
                                                         PlaceholderText="Beats"
                                                         Background="#A80F0C08"
                                                         Foreground="#F8F0E5"
                                                         BorderBrush="#22F8F0E5"/>
                                                    <WrapPanel Grid.Column="1">
                                                        <Button Content="Draft"
                                                                Command="{Binding DraftCaptionsCommand}"
                                                                Padding="12,7"
                                                                Margin="0,0,8,8"
                                                                Background="#EABF7A"
                                                                Foreground="#15120D"
                                                                FontWeight="Black"/>
                                                        <Button Content="Clear"
                                                                Command="{Binding ClearCaptionsCommand}"
                                                                Padding="12,7"
                                                                Margin="0,0,8,8"
                                                                Background="#1F1A13"
                                                                Foreground="#D9C5A5"/>
                                                    </WrapPanel>
                                                </Grid>
                                            </Grid>
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding CaptionStatus}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Foreground="#D9C5A5"/>
                                            <ItemsControl Grid.Row="2" ItemsSource="{Binding Captions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="svc:CaptionLine">
                                                        <Grid ColumnDefinitions="92,*,Auto" Margin="0,0,0,6">
                                                            <TextBlock Text="{Binding Start}" FontSize="10" Foreground="#6FB6A6"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="10" TextWrapping="Wrap" Foreground="#D9C5A5"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="10" Foreground="#E37B45"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                    <Grid Grid.Row="9" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <TextBlock Text="{Binding ExportQueueLabel}"
                                                   FontSize="12"
                                                   FontWeight="Black"
                                                   Foreground="#F8F0E5"/>
                                        <Button Grid.Column="1"
                                                Content="Render next"
                                                Command="{Binding RenderNextQueuedExportCommand}"
                                                Padding="14,8"
                                                Background="#F2EADC"
                                                Foreground="#15120D"
                                                FontWeight="Black"/>
                                    </Grid>
                                    <ItemsControl Grid.Row="10" ItemsSource="{Binding ExportHistory}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ExportHistoryItem">
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,7">
                                                    <TextBlock Text="{Binding AudioPresetName}" FontSize="11" FontWeight="Black" Foreground="#D9C5A5"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding OffsetLabel}" FontSize="11" Foreground="#6FB6A6"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>

                <Border Grid.Row="2" CornerRadius="20" Background="#660F0C08" BorderBrush="#0EF8F0E5"
                        BorderThickness="1" Padding="18,12">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="13">
                        <TextBlock Text="SYSTEM MODULES" FontSize="11" FontWeight="Black" Foreground="#D9B36F"
                                   LetterSpacing="2.8"/>
                        <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="10">
                            <ItemsControl ItemsSource="{Binding NextBuild}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="#8E8170"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel Grid.Row="1">
                                <Button Content="Write Brief"
                                        Command="{Binding WriteProductionBriefCommand}"
                                        Padding="16,8"
                                        Margin="0,0,8,8"
                                        Background="#1F1A13"
                                        Foreground="#D9C5A5"
                                        FontWeight="Black"/>
                                <Button Content="Save Library"
                                        Command="{Binding SaveLibraryCommand}"
                                        Padding="16,8"
                                        Margin="0,0,8,8"
                                        Background="#F2EADC"
                                        Foreground="#15120D"
                                        FontWeight="Black"/>
                            </WrapPanel>
                        </Grid>
                    </Grid>
                </Border>
                </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
