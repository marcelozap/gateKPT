<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GateKPT.MusicOS.ViewModels"
        xmlns:svc="using:GateKPT.MusicOS.Services"
        x:Class="GateKPT.MusicOS.Views.RecorderWindow"
        x:DataType="vm:RecorderWindowViewModel"
        Icon="/Assets/gatekpt.ico"
        Title="GateKPT MusicOS"
        Width="1020"
        Height="760"
        MinWidth="520"
        MinHeight="580"
        Background="#07110E">

    <Design.DataContext>
        <vm:RecorderWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial"/>
            <Setter Property="Foreground" Value="#E8E1D2"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#338DB7AD"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-1px)"/>
            <Setter Property="BorderBrush" Value="#88C6A96D"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Background" Value="#FFF8EBDD"/>
            <Setter Property="Foreground" Value="#04130F"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Arial"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Background" Value="#07110E"/>
            <Setter Property="Foreground" Value="#FFF8EBDD"/>
            <Setter Property="BorderBrush" Value="#88C6A96D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Arial"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Black"/>
        </Style>
        <Style Selector="ComboBox:pointerover">
            <Setter Property="Background" Value="#10251F"/>
            <Setter Property="BorderBrush" Value="#CC8DB7AD"/>
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Height" Value="13"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Background" Value="#203C36"/>
            <Setter Property="Foreground" Value="#8DB7AD"/>
        </Style>
    </Window.Styles>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#06111C" Offset="0"/>
                <GradientStop Color="#0B1B2A" Offset="0.45"/>
                <GradientStop Color="#10251F" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Path Data="M -40 220 C 120 110, 250 290, 420 170 S 720 80, 1040 210 S 1320 120, 1480 190"
              Stroke="#328DB7AD"
              StrokeThickness="2"
              Stretch="Fill"
              IsHitTestVisible="False"/>
        <Path Data="M -20 320 C 150 260, 260 370, 430 310 S 760 260, 1020 350 S 1260 295, 1500 360"
              Stroke="#24C6A96D"
              StrokeThickness="1.4"
              Stretch="Fill"
              IsHitTestVisible="False"/>
        <Path Data="M -80 470 C 170 390, 300 540, 520 455 S 860 405, 1120 500 S 1360 440, 1520 490"
              Stroke="#1EE8E1D2"
              StrokeThickness="1"
              Stretch="Fill"
              IsHitTestVisible="False"/>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="21" Spacing="21" MaxWidth="980" HorizontalAlignment="Center">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="13">
                    <StackPanel>
                        <TextBlock Text="GateKPT"
                                   FontSize="25"
                                   FontWeight="Black"/>
                        <TextBlock Text="record sound, save the take, shape it"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   FontWeight="Black"
                                   LetterSpacing="1.4"
                                   Foreground="#8DB7AD"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            CornerRadius="999"
                            Padding="16,9"
                            BorderBrush="#338DB7AD"
                            BorderThickness="1"
                            Background="#CC07110E">
                        <TextBlock Text="{Binding MeterStateLabel}"
                                   FontSize="11"
                                   FontWeight="Black"
                                   LetterSpacing="1.5"
                                   Foreground="#C6A96D"/>
                    </Border>
                </Grid>

                <Border CornerRadius="34"
                        Padding="21"
                        BorderBrush="#55E8E1D2"
                        BorderThickness="1"
                        Background="#EDE8DED2"
                        ClipToBounds="True">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="21">
                        <Path Grid.RowSpan="5"
                              Data="M 0 50 C 90 20, 160 78, 250 45 S 420 24, 560 64 S 780 35, 960 58"
                              Stroke="#248DB7AD"
                              StrokeThickness="1.2"
                              Stretch="Fill"
                              IsHitTestVisible="False"/>
                        <Path Grid.RowSpan="5"
                              Data="M 0 112 C 110 85, 190 150, 310 102 S 510 95, 690 132 S 850 105, 980 126"
                              Stroke="#20C6A96D"
                              StrokeThickness="1"
                              Stretch="Fill"
                              IsHitTestVisible="False"/>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="21">
                            <StackPanel>
                                <TextBlock Text="CAPTURE"
                                           FontSize="11"
                                           FontWeight="Black"
                                           LetterSpacing="2.4"
                                           Foreground="#806A3F"/>
                                <TextBlock Text="{Binding RecordingGuardLabel}"
                                           Margin="0,8,0,0"
                                           FontSize="42"
                                           FontWeight="Black"
                                           TextWrapping="Wrap"
                                           Foreground="#07110E"/>
                                <TextBlock Text="{Binding CaptureInstruction}"
                                           Margin="0,8,0,0"
                                           FontSize="15"
                                           FontWeight="Black"
                                           TextWrapping="Wrap"
                                           Foreground="#35544D"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    CornerRadius="999"
                                    Width="118"
                                    Height="118"
                                    Background="#07110E">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PeakLabel}"
                                               FontSize="30"
                                               FontWeight="Black"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding PeakDecibelLabel}"
                                               Margin="0,3,0,0"
                                               FontSize="10"
                                               FontWeight="Black"
                                               LetterSpacing="1.5"
                                               HorizontalAlignment="Center"
                                               Foreground="#C6A96D"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <ProgressBar Grid.Row="1"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding PeakPercent}"/>

                        <WrapPanel Grid.Row="2" Orientation="Horizontal">
                            <Button Content="✓ Signal"
                                    Command="{Binding CheckSignalCommand}"
                                    Padding="21,13"
                                    MinWidth="150"
                                    Margin="0,0,8,8"
                                    Background="#8DB7AD"
                                    Foreground="#07110E"/>
                            <Button Content="{Binding RecordingButtonLabel}"
                                    Command="{Binding StartRecordingCommand}"
                                    Padding="34,16"
                                    MinWidth="190"
                                    Margin="0,0,8,8"
                                    FontSize="17"
                                    Background="#07110E"
                                    Foreground="#E8E1D2"/>
                            <Button Content="{Binding StopButtonLabel}"
                                    Command="{Binding StopRecordingCommand}"
                                    Padding="34,16"
                                    MinWidth="190"
                                    Margin="0,0,8,8"
                                    FontSize="17"
                                    Background="#C6A96D"
                                    Foreground="#07110E"/>
                            <Button Content="▶ Play"
                                    Command="{Binding PlaySelectedCommand}"
                                    Padding="21,13"
                                    MinWidth="145"
                                    Margin="0,0,8,8"
                                    Background="#F2EEE3"
                                    Foreground="#07110E"/>
                        </WrapPanel>

                        <Grid Grid.Row="3" ColumnDefinitions="*,*,Auto,Auto,Auto" ColumnSpacing="8" RowDefinitions="Auto">
                            <ComboBox ItemsSource="{Binding InputDevices}"
                                      SelectedItem="{Binding SelectedInputDevice}"
                                      MinHeight="44"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding OutputDevices}"
                                      SelectedItem="{Binding SelectedOutputDevice}"
                                      MinHeight="44"/>
                            <Button Grid.Column="2"
                                    Content="♪ Beep"
                                    Command="{Binding TestSpeakerCommand}"
                                    Padding="18,11"
                                    MinWidth="86"
                                    Background="#203C36"
                                    Foreground="#E8E1D2"/>
                            <Button Grid.Column="3"
                                    Content="Folder"
                                    Command="{Binding OpenFolderCommand}"
                                    Padding="18,11"
                                    MinWidth="92"
                                    Background="#203C36"
                                    Foreground="#E8E1D2"/>
                            <Button Grid.Column="4"
                                    Content="Log"
                                    Command="{Binding OpenDiagnosticsCommand}"
                                    Padding="18,11"
                                    MinWidth="76"
                                    Background="#203C36"
                                    Foreground="#E8E1D2"/>
                        </Grid>

                        <StackPanel Grid.Row="4" Spacing="5">
                            <TextBlock Text="{Binding Status}"
                                       FontSize="13"
                                       FontWeight="Black"
                                       TextWrapping="Wrap"
                                       Foreground="#07110E"/>
                            <TextBlock Text="{Binding SignalProbeSummary}"
                                       FontSize="11"
                                       FontWeight="Black"
                                       TextWrapping="Wrap"
                                       Foreground="#527167"/>
                            <TextBlock Text="{Binding LastRecorderDiagnostic}"
                                       FontSize="11"
                                       FontWeight="Black"
                                       TextWrapping="Wrap"
                                       Foreground="#806A3F"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border CornerRadius="28"
                        Padding="18"
                        BorderBrush="#338DB7AD"
                        BorderThickness="1"
                        Background="#D907110E">
                    <StackPanel Spacing="13">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <TextBox Text="{Binding ChatText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Tell GateKPT: make warmer, louder, add reverb, delete last..."
                                     MinHeight="48"/>
                            <Button Grid.Column="1"
                                    Content="Do it"
                                    Command="{Binding RunChatCommandCommand}"
                                    Padding="21,12"
                                    MinWidth="89"
                                    Background="#C6A96D"
                                    Foreground="#07110E"/>
                        </Grid>
                        <TextBlock Text="{Binding CommandResult}"
                                   FontSize="12"
                                   FontWeight="Black"
                                   TextWrapping="Wrap"
                                   Foreground="#E8E1D2"/>
                        <StackPanel IsVisible="{Binding IsCommandBusy}" Spacing="6">
                            <TextBlock Text="Working..."
                                       FontSize="11"
                                       FontWeight="Black"
                                       LetterSpacing="1.8"
                                       Foreground="#8DB7AD"/>
                            <ProgressBar IsIndeterminate="True"
                                         Height="6"
                                         Background="#203C36"
                                         Foreground="#C6A96D"/>
                        </StackPanel>
                        <WrapPanel Orientation="Horizontal">
                            <Button Content="+ Warm"
                                    Command="{Binding QuickWarmerCommand}"
                                    Padding="14,9"
                                    MinWidth="82"
                                    Margin="0,0,8,8"
                                    Background="#203C36"
                                    Foreground="#E8E1D2"/>
                            <Button Content="+ Loud"
                                    Command="{Binding QuickLouderCommand}"
                                    Padding="14,9"
                                    MinWidth="82"
                                    Margin="0,0,8,8"
                                    Background="#203C36"
                                    Foreground="#E8E1D2"/>
                            <Button Content="+ Room"
                                    Command="{Binding QuickReverbCommand}"
                                    Padding="14,9"
                                    MinWidth="82"
                                    Margin="0,0,8,8"
                                    Background="#203C36"
                                    Foreground="#E8E1D2"/>
                            <Button Content="× Delete"
                                    Command="{Binding QuickDeleteCommand}"
                                    Padding="14,9"
                                    MinWidth="82"
                                    Margin="0,0,8,8"
                                    Background="#3C2020"
                                    Foreground="#E8E1D2"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="21">
                    <Border CornerRadius="28"
                            Padding="18"
                            BorderBrush="#22E8E1D2"
                            BorderThickness="1"
                            Background="#CC07110E">
                        <StackPanel Spacing="10">
                            <TextBlock Text="LATEST TAKES"
                                       FontSize="10"
                                       FontWeight="Black"
                                       LetterSpacing="2.2"
                                       Foreground="#C6A96D"/>
                            <TextBlock Text="{Binding CurrentFilePreviewLabel}"
                                       FontSize="12"
                                       FontWeight="Black"
                                       TextWrapping="Wrap"
                                       Foreground="#8DB7AD"/>
                            <ListBox ItemsSource="{Binding Versions}"
                                     SelectedItem="{Binding SelectedVersion}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     MaxHeight="170">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="svc:RecorderVersionFile">
                                        <Border CornerRadius="18"
                                                Padding="13"
                                                Margin="0,0,0,8"
                                                Background="#14E8E1D2"
                                                BorderBrush="#1F8DB7AD"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12"
                                                           FontWeight="Black"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Size}"
                                                           Margin="0,4,0,0"
                                                           FontSize="10"
                                                           FontWeight="Black"
                                                           Foreground="#8DB7AD"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            CornerRadius="28"
                            Padding="18"
                            BorderBrush="#22C6A96D"
                            BorderThickness="1"
                            Background="#CC07110E">
                        <StackPanel Spacing="13">
                            <TextBlock Text="HEAR IT"
                                       FontSize="10"
                                       FontWeight="Black"
                                       LetterSpacing="2.2"
                                       Foreground="#C6A96D"/>
                            <TextBlock Text="No beep means output is wrong. Change the second dropdown, then press Beep."
                                       FontSize="13"
                                       FontWeight="Black"
                                       TextWrapping="Wrap"
                                       Foreground="#E8E1D2"/>
                            <WrapPanel Orientation="Horizontal">
                                <Button Content="♪ Beep"
                                        Command="{Binding TestSpeakerCommand}"
                                        Padding="16,11"
                                        MinWidth="118"
                                        Margin="0,0,8,8"
                                        Background="#203C36"
                                        Foreground="#E8E1D2"/>
                                <Button Content="▶ Play"
                                        Command="{Binding PlaySelectedCommand}"
                                        Padding="16,11"
                                        MinWidth="118"
                                        Margin="0,0,8,8"
                                        Background="#203C36"
                                        Foreground="#E8E1D2"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding CommandHelp}"
                                       FontSize="11"
                                       FontWeight="Black"
                                       TextWrapping="Wrap"
                                       Foreground="#8DB7AD"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
