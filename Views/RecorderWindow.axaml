<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GateKPT.MusicOS.ViewModels"
        xmlns:svc="using:GateKPT.MusicOS.Services"
        x:Class="GateKPT.MusicOS.Views.RecorderWindow"
        x:DataType="vm:RecorderWindowViewModel"
        Icon="/Assets/gatekpt.ico"
        Title="GateKPT Music OS"
        Width="1020"
        Height="760"
        MinWidth="520"
        MinHeight="580"
        Background="#06070C">

    <Design.DataContext>
        <vm:RecorderWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift, Segoe UI Variable Display, Segoe UI, Arial"/>
            <Setter Property="Foreground" Value="#E8E1D2"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#887FCAD1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="FontFamily" Value="Bahnschrift, Segoe UI Variable Display, Segoe UI, Arial"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-2px)"/>
            <Setter Property="BorderBrush" Value="#D8D6FFFF"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Background" Value="#FFE4AE"/>
            <Setter Property="Foreground" Value="#050507"/>
            <Setter Property="BorderBrush" Value="#F8DCA7"/>
            <Setter Property="FontFamily" Value="Bahnschrift, Segoe UI Variable Text, Segoe UI, Arial"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Background" Value="#04100F"/>
            <Setter Property="Foreground" Value="#FFF4E6CF"/>
            <Setter Property="BorderBrush" Value="#A864C7B6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Bahnschrift, Segoe UI Variable Text, Segoe UI, Arial"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="ComboBox:pointerover">
            <Setter Property="Background" Value="#101C24"/>
            <Setter Property="BorderBrush" Value="#D8D6FFFF"/>
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Height" Value="13"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Background" Value="#2A211A"/>
            <Setter Property="Foreground" Value="#D6FFFF"/>
        </Style>
        <Style Selector="Border.take-row:pointerover">
            <Setter Property="Background" Value="#7A10283A"/>
            <Setter Property="BorderBrush" Value="#C864C7B6"/>
            <Setter Property="RenderTransform" Value="translateY(-1px)"/>
        </Style>
        <Style Selector="Button.take-select">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ListBox.take-list">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.take-list ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ListBox.take-list ListBoxItem:selected Border.take-row">
            <Setter Property="Background" Value="#96204A66"/>
            <Setter Property="BorderBrush" Value="#EED6FFFF"/>
        </Style>
    </Window.Styles>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#02050B" Offset="0"/>
                <GradientStop Color="#031A21" Offset="0.25"/>
                <GradientStop Color="#140B1D" Offset="0.56"/>
                <GradientStop Color="#32110C" Offset="0.84"/>
                <GradientStop Color="#030407" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Ellipse Width="520"
                 Height="520"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="0,-240,-180,0"
                 Fill="#24FF6C3E"
                 IsHitTestVisible="False"/>
        <Ellipse Width="460"
                 Height="460"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Bottom"
                 Margin="-190,0,0,-170"
                 Fill="#22276CFF"
                 IsHitTestVisible="False"/>
        <Ellipse Width="380"
                 Height="380"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,-130,-120"
                 Fill="#243DFFD2"
                 IsHitTestVisible="False"/>

        <Canvas IsHitTestVisible="False"
                ClipToBounds="False"
                Opacity="0.78">
            <Ellipse Width="310"
                     Height="310"
                     Canvas.Left="628"
                     Canvas.Top="96"
                     Fill="#1010EFFF"
                     Stroke="#8029D8FF"
                     StrokeThickness="1.3"/>
            <Ellipse Width="220"
                     Height="220"
                     Canvas.Left="672"
                     Canvas.Top="140"
                     Fill="#0C00F0FF"
                     Stroke="#B7D6FFFF"
                     StrokeThickness="1.8"/>
            <Ellipse Width="112"
                     Height="112"
                     Canvas.Left="726"
                     Canvas.Top="194"
                     Fill="#38D6FFFF"
                     Stroke="#EAF4E6CF"
                     StrokeThickness="1.4"/>
            <Path Data="M 116 438 C 170 310, 334 276, 464 346 C 594 416, 594 568, 454 638 C 302 710, 146 622, 116 438 Z"
                  Fill="#18FF2A1E"
                  Stroke="#9AFFA485"
                  StrokeThickness="1.6"/>
            <Path Data="M 1060 300 C 1150 196, 1320 210, 1470 330 C 1320 340, 1188 442, 1056 598 C 1078 482, 1082 382, 1060 300 Z"
                  Fill="#184CFF9D"
                  Stroke="#8A85FFCA"
                  StrokeThickness="1.5"/>
        </Canvas>

        <Canvas IsHitTestVisible="False"
                ClipToBounds="False"
                Opacity="0.34">
            <!-- A soft studio shell gives the visualizer a physical room instead of a flat wallpaper. -->
            <Path Data="M 280 84 L 1260 84 L 1114 548 L 424 548 Z"
                  Fill="#33110D12"
                  Stroke="#3458423A"
                  StrokeThickness="1.2"/>
            <Path Data="M 424 548 L 1114 548 L 1468 850 L 66 850 Z"
                  Fill="#3A07090E"
                  Stroke="#2CFFD2B8"
                  StrokeThickness="1.1"/>
            <Path Data="M 280 84 L 424 548 L 66 850 L -90 314 Z"
                  Fill="#24061110"
                  Stroke="#2464C7B6"
                  StrokeThickness="1"/>
            <Path Data="M 1260 84 L 1114 548 L 1468 850 L 1608 270 Z"
                  Fill="#2C220D10"
                  Stroke="#28E1786E"
                  StrokeThickness="1"/>
            <Border Width="726"
                    Height="1.5"
                    Canvas.Left="404"
                    Canvas.Top="548"
                    Background="#5CFFD2B8"
                    CornerRadius="999"/>
            <Path Data="M 495 548 L 280 850 M 610 548 L 480 850 M 760 548 L 760 850 M 910 548 L 1040 850 M 1025 548 L 1240 850"
                  Stroke="#20F4E6CF"
                  StrokeThickness="1"
                  Stretch="None"/>
            <Path Data="M 250 612 L 1290 612 M 160 690 L 1380 690 M 76 782 L 1464 782"
                  Stroke="#18FFD2B8"
                  StrokeThickness="1"
                  Stretch="None"/>
            <Ellipse Width="178"
                     Height="26"
                     Canvas.Left="681"
                     Canvas.Top="535"
                     Fill="#30F4E6CF"
                     Stroke="#55FFD2B8"
                     StrokeThickness="1"/>
            <Ellipse Width="82"
                     Height="12"
                     Canvas.Left="729"
                     Canvas.Top="542"
                     Fill="#44E1786E"/>
        </Canvas>

        <Canvas IsHitTestVisible="False"
                ClipToBounds="False"
                Opacity="0.94"
                RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="{Binding VisualBackScale}"
                                    ScaleY="{Binding VisualBackScale}"/>
                    <TranslateTransform X="{Binding VisualDriftX}"
                                        Y="{Binding VisualLiftY}"/>
                </TransformGroup>
            </Canvas.RenderTransform>

            <!-- Abstract stage forms: random enough to feel alive, slow enough to stay calm on camera. -->
            <Ellipse Width="{Binding VisualBloomSize}"
                     Height="210"
                     Canvas.Left="520"
                     Canvas.Top="344"
                     Fill="#1C7A6E"
                     Opacity="{Binding VisualBloomOpacity}"/>
            <Ellipse Width="{Binding VisualCoreSize}"
                     Height="118"
                     Canvas.Left="655"
                     Canvas.Top="392"
                     Fill="#2FA38F"
                     Opacity="0.42"/>
            <Ellipse Width="{Binding VisualBloomSize}"
                     Height="160"
                     Canvas.Left="250"
                     Canvas.Top="330"
                     Fill="#B14A6E"
                     Opacity="0.13"/>
            <Ellipse Width="{Binding VisualCoreSize}"
                     Height="88"
                     Canvas.Left="1015"
                     Canvas.Top="374"
                     Fill="#FFA94F"
                     Opacity="0.18"/>
            <Path Data="M 654 126 L 742 76 L 842 106 L 910 196 L 878 310 L 770 374 L 650 334 L 586 220 Z"
                  Fill="#041C2F5D"
                  Stroke="#6830A898"
                  StrokeThickness="1.8"/>
            <Path Data="M 676 156 L 746 112 L 830 138 L 878 208 L 850 292 L 770 338 L 680 306 L 632 226 Z"
                  Fill="#071D42D8"
                  Stroke="#882FA38F"
                  StrokeThickness="1.45"/>
            <Path Data="M 704 186 L 758 152 L 818 174 L 850 224 L 826 278 L 770 310 L 710 286 L 678 232 Z"
                  Fill="#154F6AE8"
                  Stroke="#B0F4E3BE"
                  StrokeThickness="1.45"/>
            <Path Data="M 730 212 L 764 188 L 804 204 L 824 238 L 804 272 L 766 292 L 730 272 L 708 236 Z"
                  Fill="#882FA38F"
                  Stroke="#FFFFF3D6"
                  StrokeThickness="1.8"/>
            <Ellipse Width="104"
                     Height="104"
                     Canvas.Left="708"
                     Canvas.Top="178"
                     Fill="#142FA38F"/>
            <Ellipse Width="52"
                     Height="52"
                     Canvas.Left="734"
                     Canvas.Top="204"
                     Fill="#66FFF3D6"/>

            <Path Data="M 250 420 C 210 368, 244 310, 312 292 C 392 270, 492 304, 526 370 C 558 432, 500 502, 410 510 C 330 518, 278 474, 250 420 Z"
                  Fill="#16FF251E"
                  Stroke="#E8FFD0A8"
                  StrokeThickness="2.05"/>
            <Path Data="M 282 414 C 250 376, 284 340, 342 328 C 400 316, 462 338, 486 384 C 506 424, 462 472, 398 478 C 338 484, 306 448, 282 414 Z"
                  Fill="#18FF8A5E"
                  Stroke="#A0F4E6CF"
                  StrokeThickness="1.35"/>
            <Rectangle Width="34" Height="24" Canvas.Left="306" Canvas.Top="334" Fill="#55FFD17A" RadiusX="5" RadiusY="5"/>
            <Rectangle Width="42" Height="30" Canvas.Left="350" Canvas.Top="326" Fill="#66FF3F32" RadiusX="6" RadiusY="6"/>
            <Rectangle Width="38" Height="28" Canvas.Left="400" Canvas.Top="338" Fill="#72FF784F" RadiusX="5" RadiusY="5"/>
            <Rectangle Width="48" Height="34" Canvas.Left="438" Canvas.Top="370" Fill="#64F21738" RadiusX="6" RadiusY="6"/>
            <Rectangle Width="36" Height="42" Canvas.Left="330" Canvas.Top="382" Fill="#70FF9F42" RadiusX="5" RadiusY="5"/>
            <Rectangle Width="44" Height="38" Canvas.Left="378" Canvas.Top="390" Fill="#58FF4D36" RadiusX="5" RadiusY="5"/>
            <Rectangle Width="54" Height="34" Canvas.Left="420" Canvas.Top="426" Fill="#52FFC47A" RadiusX="7" RadiusY="7"/>
            <Rectangle Width="40" Height="36" Canvas.Left="318" Canvas.Top="438" Fill="#60F21738" RadiusX="5" RadiusY="5"/>
            <Rectangle Width="42" Height="32" Canvas.Left="366" Canvas.Top="452" Fill="#5AFFD17A" RadiusX="5" RadiusY="5"/>
            <Path Data="M 330 308 C 326 352, 342 430, 308 500 M 378 300 C 366 356, 386 438, 358 512 M 426 306 C 408 360, 430 432, 412 500 M 470 336 C 440 380, 456 430, 440 470"
                  Stroke="#D2141018"
                  StrokeThickness="2.6"
                  Stretch="None"/>
            <Path Data="M 298 300 C 276 356, 300 430, 276 492 M 514 340 C 488 386, 522 446, 492 492"
                  Stroke="#82F4E6CF"
                  StrokeThickness="1.25"
                  Stretch="None"/>

            <Path Data="M 960 376 C 1072 274, 1264 280, 1398 386 C 1276 396, 1148 456, 978 596 C 990 512, 980 438, 960 376 Z"
                  Fill="#0D4DBB70"
                  Stroke="#CC64C7B6"
                  StrokeThickness="1.9"/>
            <Path Data="M 986 382 C 1106 318, 1220 316, 1364 390 M 1004 416 C 1122 364, 1224 364, 1340 426 M 1024 452 C 1138 414, 1220 420, 1312 466 M 1046 492 C 1154 466, 1216 478, 1282 512 M 1078 532 C 1162 522, 1212 532, 1250 552"
                  Stroke="#CC6EE7B8"
                  StrokeThickness="2.2"
                  Stretch="None"/>
            <Path Data="M 962 376 C 1056 370, 1228 438, 1400 386"
                  Stroke="#B8F4E6CF"
                  StrokeThickness="1.65"
                  Stretch="None"/>
            <Path Data="M 988 396 C 1068 398, 1192 480, 1348 420"
                  Stroke="#9064C7B6"
                  StrokeThickness="1.35"
                  Stretch="None"/>

            <Path Data="M 150 188 C 270 88, 386 264, 510 172 S 742 66, 928 186 S 1210 104, 1390 176"
                  Stroke="#28F4E3BE"
                  StrokeThickness="0.75"
                  Stretch="Fill"/>
            <Path Data="M 142 210 C 272 112, 400 284, 526 198 S 752 96, 930 212 S 1220 134, 1398 206"
                  Stroke="#302FA38F"
                  StrokeThickness="0.7"
                  Stretch="Fill"/>
            <Path Data="M 136 234 C 268 142, 410 314, 540 228 S 768 124, 940 238 S 1234 160, 1404 230"
                  Stroke="#28E07A2E"
                  StrokeThickness="0.7"
                  Stretch="Fill"/>
        </Canvas>

        <Grid Width="1320"
              Height="780"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Margin="0,28,0,0"
              Opacity="0.012"
              IsHitTestVisible="False"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <SkewTransform AngleX="-28" AngleY="0"/>
            </Grid.RenderTransform>
            <UniformGrid Columns="18" Rows="1">
                <Border BorderBrush="#22F2EEE3" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#18E7B06D" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#147FCAD1" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#22F2EEE3" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#18E7B06D" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#147FCAD1" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#22F2EEE3" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#18E7B06D" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#147FCAD1" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#22F2EEE3" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#18E7B06D" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#147FCAD1" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#22F2EEE3" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#18E7B06D" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#147FCAD1" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#22F2EEE3" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#18E7B06D" BorderThickness="1,0,0,0"/>
                <Border BorderBrush="#147FCAD1" BorderThickness="1,0,0,0"/>
            </UniformGrid>
            <UniformGrid Columns="1" Rows="12">
                <Border BorderBrush="#167FCAD1" BorderThickness="0,1,0,0"/>
                <Border BorderBrush="#22E7B06D" BorderThickness="0,1,0,0"/>
                <Border BorderBrush="#167FCAD1" BorderThickness="0,1,0,0"/>
                <Border BorderBrush="#22E7B06D" BorderThickness="0,1,0,0"/>
                <Border BorderBrush="#167FCAD1" BorderThickness="0,1,0,0"/>
                <Border BorderBrush="#22E7B06D" BorderThickness="0,1,0,0"/>
                <Border BorderBrush="#167FCAD1" BorderThickness="0,1,0,0"/>
                <Border BorderBrush="#22E7B06D" BorderThickness="0,1,0,0"/>
                <Border BorderBrush="#167FCAD1" BorderThickness="0,1,0,0"/>
                <Border BorderBrush="#22E7B06D" BorderThickness="0,1,0,0"/>
                <Border BorderBrush="#167FCAD1" BorderThickness="0,1,0,0"/>
                <Border BorderBrush="#22E7B06D" BorderThickness="0,1,0,0"/>
            </UniformGrid>
        </Grid>

        <Canvas IsHitTestVisible="False"
                ClipToBounds="False"
                Opacity="0.48">
            <Path Data="M 642 -120 L 810 -120 L 1026 760 L 410 760 Z"
                      Fill="#11F4E6CF"/>
            <Path Data="M 862 -80 L 1012 -54 L 1172 760 L 760 760 Z"
                  Fill="#0DE1786E"/>
            <Path Data="M 432 -70 L 598 -96 L 712 760 L 246 760 Z"
                  Fill="#0B64C7B6"/>
            <Ellipse Width="760"
                     Height="118"
                     Canvas.Left="398"
                     Canvas.Top="656"
                     Fill="#10F4E6CF"/>
            <Ellipse Width="520"
                     Height="62"
                     Canvas.Left="515"
                     Canvas.Top="676"
                     Fill="#16FFD2B8"/>
            <Border Width="620"
                    Height="2"
                    Canvas.Left="470"
                    Canvas.Top="706"
                        Background="#2AF4E6CF"
                    CornerRadius="999"/>
            <Border Width="210"
                    Height="1"
                    Canvas.Left="650"
                    Canvas.Top="318"
                    Background="#32FFD2B8"
                    CornerRadius="999">
                <Border.RenderTransform>
                    <RotateTransform Angle="-7"/>
                </Border.RenderTransform>
            </Border>
        </Canvas>

        <Canvas IsHitTestVisible="False"
                ClipToBounds="False"
                Opacity="0.72">
            <Path Data="M 1040 -20 L 1450 88 L 1370 378 L 980 238 Z"
                  Fill="#1DFFD2B8"
                  Stroke="#44FFD2B8"
                  StrokeThickness="1.4"
                  Opacity="0.22"/>
            <Path Data="M 900 30 L 1132 116 L 1110 282 L 848 220 Z"
                  Fill="#1264C7B6"
                  Stroke="#3C64C7B6"
                  StrokeThickness="1.2"
                  Opacity="0.2"/>
            <Path Data="M -80 520 L 240 438 L 328 722 L 0 832 Z"
                  Fill="#17153245"
                  Stroke="#355C8EB8"
                  StrokeThickness="1.1"
                  Opacity="0.24"/>
            <Path Data="M 1180 520 L 1540 440 L 1660 780 L 1260 850 Z"
                  Fill="#16E1786E"
                  Stroke="#38E1786E"
                  StrokeThickness="1.1"
                  Opacity="0.22"/>
            <Path Data="M 360 690 C 520 572, 706 770, 898 640 S 1240 548, 1460 700"
                  Stroke="#58FFD2B8"
                  StrokeThickness="2.1"
                  Opacity="0.18"/>
            <Path Data="M 120 110 C 260 26, 430 176, 592 82 S 844 8, 1080 126"
                  Stroke="#3864C7B6"
                  StrokeThickness="1.5"
                  Opacity="0.18"/>
            <Path Data="M 160 590 C 344 446, 478 684, 678 528 S 980 394, 1214 586"
                  Stroke="#3CE1786E"
                  StrokeThickness="1.4"
                  Opacity="0.18"/>
            <Ellipse Width="300"
                     Height="300"
                     Canvas.Left="1020"
                     Canvas.Top="520"
                     Fill="#0E64C7B6"
                     Stroke="#2464C7B6"
                     StrokeThickness="1"/>
            <Ellipse Width="210"
                     Height="210"
                     Canvas.Left="108"
                     Canvas.Top="302"
                     Fill="#0FE1786E"
                     Stroke="#2BE1786E"
                     StrokeThickness="1"/>
        </Canvas>

        <Canvas IsHitTestVisible="False"
                ClipToBounds="False"
                Opacity="0.38"
                RenderTransformOrigin="0.5,0.5">
            <Ellipse Width="5" Height="5" Canvas.Left="118" Canvas.Top="146" Fill="#C8FFD2B8"/>
            <Ellipse Width="3" Height="3" Canvas.Left="205" Canvas.Top="310" Fill="#9064C7B6"/>
            <Ellipse Width="7" Height="7" Canvas.Left="312" Canvas.Top="212" Fill="#A8E1786E"/>
            <Ellipse Width="4" Height="4" Canvas.Left="468" Canvas.Top="128" Fill="#9CF4E6CF"/>
            <Ellipse Width="6" Height="6" Canvas.Left="572" Canvas.Top="402" Fill="#A064C7B6"/>
            <Ellipse Width="3" Height="3" Canvas.Left="738" Canvas.Top="292" Fill="#D0FFD2B8"/>
            <Ellipse Width="8" Height="8" Canvas.Left="846" Canvas.Top="172" Fill="#7AE1786E"/>
            <Ellipse Width="4" Height="4" Canvas.Left="1018" Canvas.Top="358" Fill="#B864C7B6"/>
            <Ellipse Width="6" Height="6" Canvas.Left="1168" Canvas.Top="236" Fill="#B8F4E6CF"/>
            <Ellipse Width="3" Height="3" Canvas.Left="1284" Canvas.Top="510" Fill="#90FFD2B8"/>
            <Ellipse Width="7" Height="7" Canvas.Left="1388" Canvas.Top="118" Fill="#8C64C7B6"/>
        </Canvas>

        <Grid Height="330"
              VerticalAlignment="Top"
              Margin="-60,26,-60,0"
              IsHitTestVisible="False"
              Opacity="0.18"
              RenderTransformOrigin="0.5,0.5">
            <Grid.Background>
                <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                    <GradientStop Color="#00F4E6CF" Offset="0"/>
                    <GradientStop Color="#22182934" Offset="0.36"/>
                    <GradientStop Color="#16F4E6CF" Offset="0.58"/>
                    <GradientStop Color="#00130F16" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Path Data="M -90 268 C 120 132, 326 300, 544 204 S 908 104, 1190 244 S 1440 158, 1640 218"
                  Stroke="#2CFFD2B8"
                  StrokeThickness="1.6"
                  Stretch="Fill"/>
            <Path Data="M -60 226 C 140 172, 286 238, 488 210 S 824 168, 1040 226 S 1310 182, 1560 222"
                  Stroke="#2464C7B6"
                  StrokeThickness="1.1"
                  Stretch="Fill"/>
        </Grid>

        <Grid Height="430"
              VerticalAlignment="Center"
              Margin="-110,40,-110,0"
              IsHitTestVisible="False"
              Opacity="0.30"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <TranslateTransform X="{Binding VisualDriftX}"
                                        Y="{Binding VisualLiftY}"/>
                </TransformGroup>
            </Grid.RenderTransform>
            <Path Data="M -80 290 C 180 152, 394 420, 650 248 S 1016 94, 1340 312 S 1560 188, 1740 268"
                  Stroke="#322FA38F"
                  StrokeThickness="2.2"
                  Stretch="Fill"/>
            <Path Data="M -120 338 C 126 246, 366 392, 630 314 S 1028 228, 1340 350 S 1560 270, 1750 328"
                  Stroke="#26F4E3BE"
                  StrokeThickness="1.5"
                  Stretch="Fill"/>
            <Ellipse Width="{Binding VisualBloomSize}"
                     Height="190"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Fill="#262FA38F"
                     Opacity="{Binding VisualBloomOpacity}"/>
            <Ellipse Width="{Binding VisualCoreSize}"
                     Height="122"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Fill="#34FFF3D6"
                     Opacity="0.50"/>
            <Path Data="M 170 252 C 340 210, 470 250, 610 236 C 720 225, 820 180, 950 204 C 1080 228, 1135 294, 1290 270"
                  Stroke="#34F4E3BE"
                  StrokeThickness="8"
                  StrokeLineCap="Round"
                  Stretch="Fill"/>
            <Path Data="M 238 296 C 390 280, 512 324, 660 294 C 785 268, 874 238, 1030 264 C 1148 284, 1224 330, 1384 306"
                  Stroke="#302FA38F"
                  StrokeThickness="8"
