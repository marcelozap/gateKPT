<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GateKPT.MusicOS.ViewModels"
        xmlns:svc="using:GateKPT.MusicOS.Services"
        x:Class="GateKPT.MusicOS.Views.RecorderWindow"
        x:DataType="vm:RecorderWindowViewModel"
        Icon="/Assets/gatekpt.ico"
        Title="GateKPT MusicOS"
        Width="980"
        Height="720"
        MinWidth="640"
        MinHeight="520"
        Background="#07100D">

    <Design.DataContext>
        <vm:RecorderWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#22E8E1D2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-1px)"/>
            <Setter Property="BorderBrush" Value="#6692BFB3"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>
    </Window.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid RowDefinitions="Auto,*,Auto" Margin="21" RowSpacing="16" MinWidth="560">
            <Border CornerRadius="24" Padding="18" BorderBrush="#2BE8E1D2" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#14201A" Offset="0"/>
                        <GradientStop Color="#07100D" Offset="0.58"/>
                        <GradientStop Color="#1A1710" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="21">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="GATEKPT"
                                   FontSize="20"
                                   FontWeight="Black"
                                   Foreground="#E8E1D2"
                                   LetterSpacing="1.8"/>
                        <TextBlock Text="{Binding MeterInputLabel}"
                                   Margin="0,5,0,0"
                                   MaxWidth="260"
                                   FontSize="11"
                                   FontWeight="Black"
                                   TextWrapping="Wrap"
                                   Foreground="#92BFB3"/>
                    </StackPanel>

                    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" VerticalAlignment="Center">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="13">
                            <TextBlock Text="LIVE INPUT"
                                       FontSize="10"
                                       FontWeight="Black"
                                       LetterSpacing="2.4"
                                       Foreground="#C6A96D"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding MeterStateLabel}"
                                       FontSize="10"
                                       FontWeight="Black"
                                       LetterSpacing="2"
                                       Foreground="#D08A56"/>
                        </Grid>
                        <Border Grid.Row="1" CornerRadius="999" Background="#12241F" BorderBrush="#2F92BFB3" BorderThickness="1" Height="22" ClipToBounds="True">
                            <Grid ColumnDefinitions="*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*">
                                <Border Grid.Column="0" Background="#92BFB3" Opacity="0.18"/>
                                <Border Grid.Column="1" Background="#92BFB3" Opacity="0.22"/>
                                <Border Grid.Column="2" Background="#92BFB3" Opacity="0.28"/>
                                <Border Grid.Column="3" Background="#92BFB3" Opacity="0.34"/>
                                <Border Grid.Column="4" Background="#92BFB3" Opacity="0.40"/>
                                <Border Grid.Column="5" Background="#92BFB3" Opacity="0.46"/>
                                <Border Grid.Column="6" Background="#92BFB3" Opacity="0.52"/>
                                <Border Grid.Column="7" Background="#92BFB3" Opacity="0.58"/>
                                <Border Grid.Column="8" Background="#92BFB3" Opacity="0.64"/>
                                <Border Grid.Column="9" Background="#92BFB3" Opacity="0.70"/>
                                <Border Grid.Column="10" Background="#C6A96D" Opacity="0.76"/>
                                <Border Grid.Column="11" Background="#C6A96D" Opacity="0.82"/>
                                <Border Grid.Column="12" Background="#C6A96D" Opacity="0.88"/>
                                <Border Grid.Column="13" Background="#C6A96D" Opacity="0.94"/>
                                <Border Grid.Column="14" Background="#D08A56" Opacity="0.90"/>
                                <Border Grid.Column="15" Background="#D08A56" Opacity="0.76"/>
                                <Border Grid.Column="16" Background="#D08A56" Opacity="0.62"/>
                                <Border Grid.Column="17" Background="#D08A56" Opacity="0.48"/>
                                <Border Grid.Column="18" Background="#D08A56" Opacity="0.34"/>
                                <Border Grid.Column="19" Background="#D08A56" Opacity="0.22"/>
                            </Grid>
                        </Border>
                        <TextBlock Grid.Row="2"
                                   Text="{Binding NextActionLabel}"
                                   FontSize="11"
                                   FontWeight="Black"
                                   TextWrapping="Wrap"
                                   Foreground="#C9C0AD"/>
                    </Grid>

                    <Border Grid.Column="2"
                            CornerRadius="20"
                            Background="#E8E1D2"
                            Padding="18,13"
                            MinWidth="150">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="2">
                            <TextBlock Text="{Binding PeakDecibelLabel}"
                                       FontSize="26"
                                       FontWeight="Black"
                                       HorizontalAlignment="Right"
                                       Foreground="#07100D"/>
                            <TextBlock Grid.Row="1"
                                       Text="{Binding PeakLabel}"
                                       FontSize="11"
                                       FontWeight="Black"
                                       LetterSpacing="2"
                                       HorizontalAlignment="Right"
                                       Foreground="#806A3F"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="1.05*,0.95*" ColumnSpacing="18">
                <StackPanel Spacing="18">
                    <Border CornerRadius="24" Background="#C40B1511" BorderBrush="#2BC6A96D" BorderThickness="1" Padding="18">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="13">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="13">
                                <StackPanel>
                                    <TextBlock Text="INPUT PATH"
                                       FontSize="11"
                                       FontWeight="Black"
                                               Foreground="#C6A96D"
                                       LetterSpacing="2.4"/>
                                    <TextBlock Text="Scarlett / RC-505"
                                               Margin="0,5,0,0"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"
                                               Foreground="#C9C0AD"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="Signal must move"
                                           FontSize="11"
                                           FontWeight="Black"
                                           VerticalAlignment="Center"
                                           Foreground="#92BFB3"/>
                            </Grid>
                            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="13">
                                <Button Content="Find Scarlett"
                                        Command="{Binding FindScarlettCommand}"
                                        Padding="18,12"
                                        Background="#1A241E"
                                        Foreground="#E8E1D2"/>
                                <Button Grid.Column="1"
                                        Content="Check signal"
                                        Command="{Binding CheckSignalCommand}"
                                        Padding="18,12"
                                        Background="#C6A96D"
                                        Foreground="#07100D"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border CornerRadius="34" Background="#E00A1210" BorderBrush="#4092BFB3" BorderThickness="2" Padding="24">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="16">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                <StackPanel>
                                    <TextBlock Text="CAPTURE"
                                               FontSize="11"
                                               FontWeight="Black"
                                               Foreground="#92BFB3"
                                               LetterSpacing="2.4"/>
                                    <TextBlock Text="{Binding RecorderStateLabel}"
                                               Margin="0,8,0,0"
                                               FontSize="24"
                                               FontWeight="Black"
                                               TextWrapping="Wrap"
                                               Foreground="#E8E1D2"/>
                                </StackPanel>
                                <Border Grid.Column="1"
                                        CornerRadius="999"
                                        Padding="14,8"
                                        Background="#1D92BFB3">
                                    <TextBlock Text="{Binding NextActionLabel}"
                                               MaxWidth="210"
                                               FontSize="11"
                                               FontWeight="Black"
                                               TextWrapping="Wrap"
                                               Foreground="#D8F0EA"/>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="13">
                                <Button Content="RECORD"
                                        Command="{Binding StartRecordingCommand}"
                                        Padding="28,18"
                                        MinHeight="64"
                                        FontSize="18"
                                        Background="#92BFB3"
                                        Foreground="#07100D"/>
                                <Button Grid.Column="1"
                                        Content="STOP &amp; SAVE"
                                        Command="{Binding StopRecordingCommand}"
                                        Padding="28,18"
                                        MinHeight="64"
                                        FontSize="18"
                                        Background="#C6A96D"
                                        Foreground="#07100D"/>
                            </Grid>

                            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="13">
                                <Button Content="OPEN / PLAY FILE"
                                        Command="{Binding PlaySelectedCommand}"
                                        Padding="18,13"
                                        Background="#E8E1D2"
                                        Foreground="#07100D"/>
                                <Button Grid.Column="1"
                                        Content="STOP INTERNAL"
                                        Command="{Binding StopPlaybackCommand}"
                                        Padding="18,13"
                                        Background="#1A241E"
                                        Foreground="#C9C0AD"/>
                            </Grid>

                            <Border Grid.Row="3" CornerRadius="18" Background="#14E8E1D2" Padding="13">
                                <StackPanel>
                                    <TextBlock Text="CURRENT FILE"
                                               FontSize="10"
                                               FontWeight="Black"
                                               LetterSpacing="2"
                                               Foreground="#92BFB3"/>
                                    <TextBlock Text="{Binding CurrentFileLabel}"
                                               Margin="0,5,0,0"
                                               FontSize="13"
                                               FontWeight="Black"
                                               TextWrapping="Wrap"
                                               Foreground="#E8E1D2"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="4" CornerRadius="22" Background="#10182016" BorderBrush="#33C6A96D" BorderThickness="1" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="RC-505 CAPTURE MODE"
                                               FontSize="11"
                                               FontWeight="Black"
                                               Foreground="#C6A96D"
                                               LetterSpacing="2.4"/>
                                    <TextBlock Text="{Binding Rc505CaptureGuide}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"
                                               Foreground="#C9C0AD"/>
                                    <Button Content="Record full loop"
                                            Command="{Binding RecordFullLoopCommand}"
                                            Padding="14,12"
                                            HorizontalAlignment="Stretch"
                                            Background="#C6A96D"
                                            Foreground="#07100D"/>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <Button Content="Track 1 Drums"
                                                Command="{Binding RecordDrumsLayerCommand}"
                                                Padding="12,11"
                                                Background="#92BFB3"
                                                Foreground="#07100D"/>
                                        <Button Grid.Column="1"
                                                Content="Track 2 Guitar"
                                                Command="{Binding RecordGuitarLayerCommand}"
                                                Padding="12,11"
                                                Background="#92BFB3"
                                                Foreground="#07100D"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <Button Content="Track 3 Piano"
                                                Command="{Binding RecordPianoLayerCommand}"
                                                Padding="12,11"
                                                Background="#92BFB3"
                                                Foreground="#07100D"/>
                                        <Button Grid.Column="1"
                                                Content="Track 4 Vocal"
                                                Command="{Binding RecordVocalLayerCommand}"
                                                Padding="12,11"
                                                Background="#92BFB3"
                                                Foreground="#07100D"/>
                                    </Grid>
                                    <Button Content="Track 5 Extra / Texture"
                                            Command="{Binding RecordExtraLayerCommand}"
                                            Padding="12,11"
                                            HorizontalAlignment="Stretch"
                                            Background="#D08A56"
                                            Foreground="#07100D"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border CornerRadius="28" Background="#D90B1511" BorderBrush="#24E8E1D2" BorderThickness="1" Padding="22">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                            <StackPanel>
                                <TextBlock Text="COMMAND"
                                           FontSize="11"
                                           FontWeight="Black"
                                           Foreground="#D08A56"
                                           LetterSpacing="2.4"/>
                                <TextBlock Text="{Binding AssistantBrief}"
                                           Margin="0,7,0,0"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           Foreground="#C9C0AD"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1"
                                       Text="{Binding CommandHelp}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Foreground="#C9C0AD"/>
                                    <TextBox Grid.Row="2"
                                     Text="{Binding ChatText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="drums punch, vocal polish, add reverb..."
                                     TextWrapping="Wrap"
                                     MinHeight="48"
                                     Background="#E8E1D2"
                                     Foreground="#07100D"/>
                            <Button Grid.Row="3"
                                    Content="Run command"
                                    Command="{Binding RunChatCommandCommand}"
                                    Padding="18,12"
                                    HorizontalAlignment="Stretch"
                                    Background="#D08A56"
                                    Foreground="#07100D"/>
                            <Border Grid.Row="4" CornerRadius="16" Background="#18D08A56" Padding="13">
                                <StackPanel>
                                    <TextBlock Text="COMMAND RESULT"
                                               FontSize="10"
                                               FontWeight="Black"
                                               LetterSpacing="2"
                                               Foreground="#D08A56"/>
                                    <TextBlock Text="{Binding CommandResult}"
                                               Margin="0,5,0,0"
                                               FontSize="12"
                                               FontWeight="Black"
                                               TextWrapping="Wrap"
                                               Foreground="#E8E1D2"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="5" CornerRadius="16" Background="#1292BFB3" Padding="13">
                                <StackPanel>
                                    <TextBlock Text="RECENT INSTRUCTIONS"
                                               FontSize="10"
                                               FontWeight="Black"
                                               LetterSpacing="2"
                                               Foreground="#92BFB3"/>
                                    <TextBlock Text="{Binding CommandHistory}"
                                               Margin="0,5,0,0"
                                               MaxHeight="86"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"
                                               Foreground="#C9C0AD"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>

                <Border Grid.Column="1" CornerRadius="28" Background="#C40B1511" BorderBrush="#22E8E1D2" BorderThickness="1" Padding="20">
                    <Grid RowDefinitions="Auto,Auto,1.2*,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="14">
                        <TextBlock Text="TAKES"
                                   FontSize="11"
                                   FontWeight="Black"
                                   Foreground="#C6A96D"
                                   LetterSpacing="2.4"/>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding VersionListHint}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   Foreground="#C9C0AD"/>
                        <ListBox Grid.Row="2"
                                 ItemsSource="{Binding Versions}"
                                 SelectedItem="{Binding SelectedVersion}"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="svc:RecorderVersionFile">
                                    <Border CornerRadius="18" Background="#14E8E1D2" Padding="14" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Black" TextWrapping="Wrap" Foreground="#E8E1D2"/>
                                            <TextBlock Text="{Binding Size}" Margin="0,5,0,0" FontSize="11" FontWeight="Bold" Foreground="#92BFB3"/>
                                            <TextBlock Text="{Binding Modified}" FontSize="11" Foreground="#C9C0AD"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Grid.Row="3"
                                Content="Open folder"
                                Command="{Binding OpenFolderCommand}"
                                Padding="18,12"
                                HorizontalAlignment="Stretch"
                                Background="#E8E1D2"
                                Foreground="#07100D"/>
                        <Border Grid.Row="4" CornerRadius="20" Background="#111A15" BorderBrush="#3092BFB3" BorderThickness="1" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="STEMS"
                                           FontSize="11"
                                           FontWeight="Black"
                                           Foreground="#92BFB3"
                                           LetterSpacing="2.4"/>
                                <TextBlock Text="{Binding LayerDeckSummary}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           Foreground="#C9C0AD"/>
                                <ListBox ItemsSource="{Binding LayerSlots}"
                                         SelectedItem="{Binding SelectedLayerSlot}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         MaxHeight="230">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LayerSlotItem">
                                            <Border CornerRadius="14" Background="#12E8E1D2" Padding="10" Margin="0,0,0,8">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                    <TextBlock Text="{Binding Number}"
                                                               FontSize="12"
                                                               FontWeight="Black"
                                                               Foreground="#C6A96D"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="12"
                                                                   FontWeight="Black"
                                                                   Foreground="#E8E1D2"/>
                                                        <TextBlock Text="{Binding FileName}"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="#C9C0AD"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Status}"
                                                               FontSize="10"
                                                               FontWeight="Black"
                                                               Foreground="#92BFB3"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                        <Grid Grid.Row="5" ColumnDefinitions="*,*" ColumnSpacing="13">
                            <Button Content="Assign take"
                                    Command="{Binding AssignSelectedToNextLayerCommand}"
                                    Padding="14,12"
                                    Background="#92BFB3"
                                    Foreground="#07100D"/>
                            <Button Grid.Column="1"
                                    Content="Clear deck"
                                    Command="{Binding ClearLayerDeckCommand}"
                                    Padding="14,12"
                                    Background="#1A241E"
                                    Foreground="#C9C0AD"/>
                        </Grid>
                        <Grid Grid.Row="6" ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <Button Content="Replace lane"
                                    Command="{Binding ReplaceSelectedLayerCommand}"
                                    Padding="12,11"
                                    Background="#92BFB3"
                                    Foreground="#07100D"/>
                            <Button Grid.Column="1"
                                    Content="Open lane"
                                    Command="{Binding OpenSelectedLayerCommand}"
                                    Padding="12,11"
                                    Background="#E8E1D2"
                                    Foreground="#07100D"/>
                            <Button Grid.Column="2"
                                    Content="Clear lane"
                                    Command="{Binding ClearSelectedLayerCommand}"
                                    Padding="12,11"
                                    Background="#1A241E"
                                    Foreground="#C9C0AD"/>
                        </Grid>
                        <Grid Grid.Row="7" ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Content="Export mix"
                                    Command="{Binding ExportLayerMixCommand}"
                                    Padding="14,12"
                                    Background="#C6A96D"
                                    Foreground="#07100D"/>
                            <Button Grid.Column="1"
                                    Content="Export stems"
                                    Command="{Binding ExportSeparateStemsCommand}"
                                    Padding="14,12"
                                    Background="#92BFB3"
                                    Foreground="#07100D"/>
                        </Grid>
                        <Border Grid.Row="8" CornerRadius="20" Background="#111A15" BorderBrush="#24D08A56" BorderThickness="1" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="EXPORT"
                                           FontSize="11"
                                           FontWeight="Black"
                                           Foreground="#D08A56"
                                           LetterSpacing="2.4"/>
                                <TextBlock Text="{Binding ExportPlanningSignal}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           Foreground="#C9C0AD"/>
                                <Border CornerRadius="14" Background="#12E8E1D2" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="LAST MIX"
                                                   FontSize="10"
                                                   FontWeight="Black"
                                                   LetterSpacing="2"
                                                   Foreground="#E8E1D2"/>
                                        <TextBlock Text="{Binding LastExportedMixLabel}"
                                                   Margin="0,4,0,0"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap"
                                                   Foreground="#C9C0AD"/>
                                    </StackPanel>
                                </Border>
                                <Border CornerRadius="14" Background="#12E8E1D2" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="LAST STEMS"
                                                   FontSize="10"
                                                   FontWeight="Black"
                                                   LetterSpacing="2"
                                                   Foreground="#E8E1D2"/>
                                        <TextBlock Text="{Binding LastStemExportLabel}"
                                                   Margin="0,4,0,0"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap"
                                                   Foreground="#C9C0AD"/>
                                    </StackPanel>
                                </Border>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <Border CornerRadius="14" Background="#10C6A96D" Padding="10">
                                        <TextBlock Text="DJ-ready clip"
                                                   FontSize="11"
                                                   FontWeight="Black"
                                                   Foreground="#C6A96D"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                    <Border Grid.Column="1" CornerRadius="14" Background="#1092BFB3" Padding="10">
                                        <TextBlock Text="Visual-ready mix"
                                                   FontSize="11"
                                                   FontWeight="Black"
                                                   Foreground="#92BFB3"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                </Grid>
                                <Button Content="Open last mix"
                                        Command="{Binding OpenExportedMixCommand}"
                                        Padding="14,12"
                                        HorizontalAlignment="Stretch"
                                        Background="#D08A56"
                                        Foreground="#07100D"/>
                                <Button Content="Open stems folder"
                                        Command="{Binding OpenStemExportFolderCommand}"
                                        Padding="14,12"
                                        HorizontalAlignment="Stretch"
                                        Background="#1A241E"
                                        Foreground="#C9C0AD"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" CornerRadius="18" Background="#14E8E1D2" Padding="14">
                <TextBlock Text="{Binding Status}"
                           FontSize="13"
                           FontWeight="Black"
                           TextWrapping="Wrap"
                           Foreground="#E8E1D2"/>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
