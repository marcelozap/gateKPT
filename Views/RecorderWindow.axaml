<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GateKPT.MusicOS.ViewModels"
        xmlns:svc="using:GateKPT.MusicOS.Services"
        x:Class="GateKPT.MusicOS.Views.RecorderWindow"
        x:DataType="vm:RecorderWindowViewModel"
        Icon="/Assets/gatekpt.ico"
        Title="GateKPT Recorder"
        Width="980"
        Height="720"
        MinWidth="860"
        MinHeight="620"
        Background="#070504">

    <Design.DataContext>
        <vm:RecorderWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="FontWeight" Value="Black"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="24" RowSpacing="18">
        <Border CornerRadius="34" Padding="28" BorderBrush="#24F8F0E5" BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#17100B" Offset="0"/>
                    <GradientStop Color="#090706" Offset="0.55"/>
                    <GradientStop Color="#12251F" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                <StackPanel>
                    <TextBlock Text="GATEKPT RECORDER"
                               FontSize="11"
                               FontWeight="Black"
                               Foreground="#F1C27D"
                               LetterSpacing="3"/>
                    <TextBlock Text="{Binding PrimaryHeadline}"
                               Margin="0,10,0,0"
                               FontSize="48"
                               FontWeight="Black"
                               TextWrapping="Wrap"
                               Foreground="#F8F0E5"/>
                    <TextBlock Text="{Binding PrimaryDetail}"
                               Margin="0,10,0,0"
                               FontSize="16"
                               FontWeight="Bold"
                               LineHeight="24"
                               TextWrapping="Wrap"
                               Foreground="#D9C5A5"/>
                    <TextBlock Text="{Binding InputName}"
                               Margin="0,14,0,0"
                               FontSize="12"
                               FontWeight="Black"
                               TextWrapping="Wrap"
                               Foreground="#6FB6A6"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Width="170"
                        Height="170"
                        CornerRadius="999"
                        Background="#F2EADC">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PeakLabel}"
                                   FontSize="44"
                                   FontWeight="Black"
                                   HorizontalAlignment="Center"
                                   Foreground="#15120D"/>
                        <TextBlock Text="SIGNAL"
                                   FontSize="11"
                                   FontWeight="Black"
                                   LetterSpacing="2.5"
                                   HorizontalAlignment="Center"
                                   Foreground="#8D5631"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="1.05*,0.95*" ColumnSpacing="18">
            <StackPanel Spacing="18">
                <Border CornerRadius="28" Background="#E6F2EADC" Padding="22">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
                        <TextBlock Text="1. PROVE AUDIO"
                                   FontSize="11"
                                   FontWeight="Black"
                                   Foreground="#8D5631"
                                   LetterSpacing="2.4"/>
                        <WrapPanel Grid.Row="1">
                            <Button Content="Find Scarlett"
                                    Command="{Binding FindScarlettCommand}"
                                    Padding="18,12"
                                    Margin="0,0,10,10"
                                    Background="#15120D"
                                    Foreground="#F8F0E5"/>
                            <Button Content="Check signal"
                                    Command="{Binding CheckSignalCommand}"
                                    Padding="18,12"
                                    Margin="0,0,10,10"
                                    Background="#E37B45"
                                    Foreground="#15120D"/>
                        </WrapPanel>
                        <TextBlock Grid.Row="2"
                                   Text="Play the RC-505 during Check signal. While recording, the big signal number must move or Windows is not receiving the performance."
                                   FontSize="12"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   Foreground="#5D503F"/>
                    </Grid>
                </Border>

                <Border CornerRadius="28" Background="#CC0B0907" BorderBrush="#306FB6A6" BorderThickness="1" Padding="22">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
                        <TextBlock Text="2. RECORD"
                                   FontSize="11"
                                   FontWeight="Black"
                                   Foreground="#6FB6A6"
                                   LetterSpacing="2.4"/>
                        <WrapPanel Grid.Row="1">
                            <Button Content="Record"
                                    Command="{Binding StartRecordingCommand}"
                                    Padding="24,14"
                                    Margin="0,0,10,10"
                                    Background="#6FB6A6"
                                    Foreground="#15120D"/>
                            <Button Content="Stop &amp; Save"
                                    Command="{Binding StopRecordingCommand}"
                                    Padding="24,14"
                                    Margin="0,0,10,10"
                                    Background="#E37B45"
                                    Foreground="#15120D"/>
                            <Button Content="Play"
                                    Command="{Binding PlaySelectedCommand}"
                                    Padding="18,12"
                                    Margin="0,0,10,10"
                                    Background="#F2EADC"
                                    Foreground="#15120D"/>
                            <Button Content="Stop"
                                    Command="{Binding StopPlaybackCommand}"
                                    Padding="18,12"
                                    Margin="0,0,10,10"
                                    Background="#2415120D"
                                    Foreground="#D9C5A5"/>
                        </WrapPanel>
                        <TextBlock Grid.Row="2"
                                   Text="{Binding CurrentFileLabel}"
                                   FontSize="13"
                                   FontWeight="Black"
                                   TextWrapping="Wrap"
                                   Foreground="#D9C5A5"/>
                    </Grid>
                </Border>

                <Border CornerRadius="28" Background="#D915120D" BorderBrush="#24F8F0E5" BorderThickness="1" Padding="22">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                        <TextBlock Text="3. CHAT CONTROL"
                                   FontSize="11"
                                   FontWeight="Black"
                                   Foreground="#F1C27D"
                                   LetterSpacing="2.4"/>
                        <TextBox Grid.Row="1"
                                 Text="{Binding ChatText}"
                                 PlaceholderText="delete last version, rename hook idea, show versions..."
                                 Background="#F2EADC"
                                 Foreground="#15120D"/>
                        <Button Grid.Row="2"
                                Content="Run command"
                                Command="{Binding RunChatCommandCommand}"
                                Padding="18,12"
                                HorizontalAlignment="Left"
                                Background="#F1C27D"
                                Foreground="#15120D"/>
                    </Grid>
                </Border>
            </StackPanel>

            <Border Grid.Column="1" CornerRadius="28" Background="#A80B0907" BorderBrush="#22F8F0E5" BorderThickness="1" Padding="20">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
                    <TextBlock Text="VERSIONS"
                               FontSize="11"
                               FontWeight="Black"
                               Foreground="#F1C27D"
                               LetterSpacing="2.4"/>
                    <TextBlock Grid.Row="1"
                               Text="{Binding VersionListHint}"
                               FontSize="12"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               Foreground="#D9C5A5"/>
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Versions}"
                             SelectedItem="{Binding SelectedVersion}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="svc:RecorderVersionFile">
                                <Border CornerRadius="18" Background="#18F8F0E5" Padding="14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Black" TextWrapping="Wrap" Foreground="#F8F0E5"/>
                                        <TextBlock Text="{Binding Size}" Margin="0,5,0,0" FontSize="11" FontWeight="Bold" Foreground="#6FB6A6"/>
                                        <TextBlock Text="{Binding Modified}" FontSize="11" Foreground="#D9C5A5"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="3"
                            Content="Open folder"
                            Command="{Binding OpenFolderCommand}"
                            Padding="18,12"
                            Background="#F2EADC"
                            Foreground="#15120D"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" CornerRadius="18" Background="#18F8F0E5" Padding="14">
            <TextBlock Text="{Binding Status}"
                       FontSize="13"
                       FontWeight="Black"
                       TextWrapping="Wrap"
                       Foreground="#F8F0E5"/>
        </Border>
    </Grid>
</Window>
