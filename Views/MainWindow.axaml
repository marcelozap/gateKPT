<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GateKPT.MusicOS.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1280"
        d:DesignHeight="820"
        x:Class="GateKPT.MusicOS.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="GateKPT Music OS"
        Width="1280"
        Height="820"
        MinWidth="980"
        MinHeight="680"
        Background="#15120D">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="CornerRadius" Value="28"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#22F8F0E5"/>
            <Setter Property="Background" Value="#17130D"/>
            <Setter Property="Padding" Value="24"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="LetterSpacing" Value="2.8"/>
            <Setter Property="Foreground" Value="#D9B36F"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*" Background="#15120D">
        <Border Padding="28,18" BorderBrush="#18F8F0E5" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="12" Background="#F2EADC">
                        <TextBlock Text="G" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="18" FontWeight="Black" Foreground="#15120D"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="GateKPT" FontSize="16" FontWeight="Black" Foreground="#F8F0E5"/>
                        <TextBlock Text="PRIVATE MUSIC OS" FontSize="10" FontWeight="Bold" Foreground="#766A5B" LetterSpacing="1.8"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding TodayState}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="#8E8170"/>

                <Border Grid.Column="2" CornerRadius="999" Background="#F2EADC" Padding="14,8">
                    <TextBlock Text="{Binding OperatorName}" FontSize="12" FontWeight="Black" Foreground="#15120D"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="340,*" Margin="28" ColumnSpacing="22">
            <Border Classes="card">
                <Grid RowDefinitions="Auto,Auto,*">
                    <StackPanel>
                        <TextBlock Classes="label" Text="ACTIVE ROOM"/>
                        <TextBlock Text="{Binding ActiveRoom}"
                                   Margin="0,12,0,0"
                                   FontSize="42"
                                   FontWeight="Black"
                                   LineHeight="40"
                                   Foreground="#F8F0E5"/>
                        <TextBlock Text="The private app starts here: record, organize, reflect, and keep the work close."
                                   Margin="0,14,0,0"
                                   FontSize="14"
                                   LineHeight="22"
                                   TextWrapping="Wrap"
                                   Foreground="#958875"/>
                    </StackPanel>

                    <Button Grid.Row="1"
                            Margin="0,28,0,24"
                            Padding="18,12"
                            HorizontalAlignment="Stretch"
                            Background="#E37B45"
                            Foreground="#15120D"
                            FontWeight="Black"
                            Content="Start today's session"/>

                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Rooms}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:OsRoom">
                                <Border CornerRadius="18" Background="#0F0C08" BorderBrush="#16F8F0E5" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Text="{Binding Number}" FontSize="12" FontWeight="Black" Foreground="{Binding Accent}" Margin="0,2,14,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Black" Foreground="#F8F0E5"/>
                                            <TextBlock Text="{Binding Description}" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="#7E7466"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="1.05*,0.95*" RowSpacing="22">
                <Border CornerRadius="34" Background="#F2EADC" Padding="34">
                    <Grid ColumnDefinitions="1.1*,0.9*" ColumnSpacing="30">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="MUSIC OS" FontSize="11" FontWeight="Black" Foreground="#8D5631" LetterSpacing="3"/>
                            <TextBlock Text="A private studio for the work before the world sees it."
                                       Margin="0,14,0,0"
                                       FontSize="54"
                                       FontWeight="Black"
                                       LineHeight="50"
                                       TextWrapping="Wrap"
                                       Foreground="#15120D"/>
                            <TextBlock Text="GateKPT.ai stays public and simple. This app is where the songs, voice notes, takes, practice, and private reflections live."
                                       Margin="0,20,0,0"
                                       FontSize="15"
                                       LineHeight="24"
                                       TextWrapping="Wrap"
                                       Foreground="#5D503F"/>
                        </StackPanel>

                        <Border Grid.Column="1" CornerRadius="28" Background="#15120D" Padding="24">
                            <StackPanel>
                                <TextBlock Classes="label" Text="TODAY'S RITUAL"/>
                                <ItemsControl ItemsSource="{Binding Ritual}" Margin="0,18,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,14">
                                                <Border Width="22" Height="22" CornerRadius="11" Background="#6FB6A6" Margin="0,1,12,0">
                                                    <TextBlock Text="✓" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#15120D" FontSize="12" FontWeight="Black"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding}" FontSize="13" LineHeight="20" TextWrapping="Wrap" Foreground="#D9C5A5"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="22">
                    <Border Classes="card">
                        <StackPanel>
                            <TextBlock Classes="label" Text="RECENT CAPTURES"/>
                            <ItemsControl ItemsSource="{Binding RecentCaptures}" Margin="0,18,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CaptureItem">
                                        <Border CornerRadius="18" Background="#0F0C08" Padding="16" Margin="0,0,0,12">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Black" Foreground="#F8F0E5"/>
                                                    <TextBlock Text="{Binding Detail}" Margin="0,5,0,0" FontSize="12" TextWrapping="Wrap" Foreground="#8E8170"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" CornerRadius="999" Background="#22E37B45" Padding="10,5" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Black" Foreground="#E37B45"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Grid.Column="1">
                        <StackPanel>
                            <TextBlock Classes="label" Text="NEXT BUILD"/>
                            <TextBlock Text="Foundation roadmap"
                                       Margin="0,12,0,16"
                                       FontSize="28"
                                       FontWeight="Black"
                                       Foreground="#F8F0E5"/>
                            <ItemsControl ItemsSource="{Binding NextBuild}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Margin="0,0,0,10"
                                                   FontSize="13"
                                                   Foreground="#B7AA96"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
